#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

#Область ПрограммныйИнтерфейс

// Применяет настройки к переданному объекту при каждом вызове. Объект не записывается.
Процедура ПрименитьКОбъекту(Объект) Экспорт

	Результат = НовыйРезультат();
	Попытка
		ВыполнитьПроверкуПравДоступа("Чтение", Метаданные.Справочники.мямЗначенияПоУмолчанию);
		Настройки = Справочники.мямЗначенияПоУмолчанию.НастройкиОбъекта(Объект.Метаданные().ПолноеИмя());
		Если Настройки.Количество() = 0 Тогда
			Результат.Причина = "НетНастроек";
		Иначе
			ПрименитьНастройки(Объект, Настройки, Результат);
		КонецЕсли;
	Исключение
		ДобавитьОшибку(Результат, Неопределено, Объект.Метаданные().ПолноеИмя(),
			0, НСтр("ru='Не удалось подготовить начальное заполнение. Проверьте права и настройки.'; en='Could not prepare initial filling. Check permissions and settings.'"), Истина);
	КонецПопытки;
	ЗавершитьРезультат(Результат);
	СообщитьОшибкиЗаполнения(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ОписаниеНастройки(Настройка) Экспорт
	Части = СтрРазделить(Настройка.ЗаполняемыйРеквизит, ".", Ложь);
	Если Части.Количество() <> 4 И Части.Количество() <> 6 Тогда
		ВызватьИсключение НСтр("ru='Некорректный путь заполняемого реквизита.'; en='Invalid target attribute path.'");
	КонецЕсли;
	Если Не мямОбщегоНазначенияКлиентСервер.ПоддерживаемоеСемейство(Части[0]) Тогда
		ВызватьИсключение НСтр("ru='Тип объекта не поддерживает начальное заполнение этой подсистемой.'; en='The object type does not support initial filling by this subsystem.'");
	КонецЕсли;
	ПолноеИмя = Части[0] + "." + Части[1];
	МетаОбъект = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаОбъект = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Объект метаданных не найден.'; en='Metadata object was not found.'");
	КонецЕсли;
	ИмяТЧ = "";
	Владелец = МетаОбъект;
	ИндексВида = 2;
	Если Части.Количество() = 6 Тогда
		Если Части[2] <> "ТабличнаяЧасть" Тогда
			ВызватьИсключение НСтр("ru='Некорректный путь табличной части.'; en='Invalid tabular section path.'");
		КонецЕсли;
		ИмяТЧ = Части[3];
		Владелец = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
		Если Владелец = Неопределено Тогда
			ВызватьИсключение НСтр("ru='Табличная часть не найдена.'; en='Tabular section was not found.'");
		КонецЕсли;
		ИндексВида = 4;
	КонецЕсли;
	Вид = Части[ИндексВида];
	Имя = Части[ИндексВида + 1];
	Если Вид = "Реквизит" Тогда
		Реквизит = Владелец.Реквизиты.Найти(Имя);
	ИначеЕсли Вид = "ОбщийРеквизит" И Части.Количество() = 4 Тогда
		Если мямОбщегоНазначения.СписокЗаполняемыхРеквизитов(ПолноеИмя).
		НайтиПоЗначению(Настройка.ЗаполняемыйРеквизит) = Неопределено Тогда
			ВызватьИсключение НСтр("ru='Общий реквизит не включен в состав объекта.'; en='The common attribute is not included in the object.'");
		КонецЕсли;
		Реквизит = Метаданные.ОбщиеРеквизиты.Найти(Имя);
	ИначеЕсли Вид = "СтандартныйРеквизит" Тогда
		Реквизит = Неопределено;
		Для Каждого СтандартныйРеквизит Из Владелец.СтандартныеРеквизиты Цикл
			Если СтандартныйРеквизит.Имя = Имя Тогда
				Реквизит = СтандартныйРеквизит;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ВызватьИсключение НСтр("ru='Недопустимый вид реквизита.'; en='Invalid attribute kind.'");
	КонецЕсли;
	Если Реквизит = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Заполняемый реквизит не найден.'; en='Target attribute was not found.'");
	КонецЕсли;
	Если мямОбщегоНазначения.ИсключаемыйРеквизитЗначенияПоУмолчанию(Настройка.ЗаполняемыйРеквизит) Тогда
		ВызватьИсключение НСтр("ru='Реквизит исключен из начального заполнения.'; en='The attribute is excluded from initial filling.'");
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяТЧ) И Не ДопустимоеКоличество(Настройка.КоличествоПовторов) Тогда
		ВызватьИсключение НСтр("ru='Количество повторов должно быть целым числом от 1 до 99.'; en='The repeat count must be an integer from 1 to 99.'");
	КонецЕсли;
	Возврат Новый Структура("ПолноеИмя, ИмяТЧ, Имя, Тип", ПолноеИмя, ИмяТЧ, Имя, Реквизит.Тип);
КонецФункции

Функция ЗначениеНастройки(Настройка, Описание) Экспорт
	Типы = Описание.Тип.Типы();
	Если Типы.Количество() = 1 И Описание.Тип.СодержитТип(Тип("Строка"))
	И Описание.Тип.КвалификаторыСтроки.Длина = 0 Тогда
		Значение = Настройка.ЗначениеНастройкиСтрока;
	Иначе
		Значение = Настройка.ЗначениеНастройки;
		Если Значение = Неопределено И Типы.Количество() = 1 Тогда
			Значение = Описание.Тип.ПривестиЗначение();
		КонецЕсли;
	КонецЕсли;
	Если Не Описание.Тип.СодержитТип(ТипЗнч(Значение)) Тогда
		ВызватьИсключение НСтр("ru='Тип значения настройки не соответствует реквизиту.'; en='The setting value type does not match the attribute.'");
	КонецЕсли;
	Если Описание.Тип.ПривестиЗначение(Значение) <> Значение Тогда
		ВызватьИсключение НСтр("ru='Значение не помещается в ограничения типа реквизита.'; en='The value exceeds the attribute type constraints.'");
	КонецЕсли;
	Возврат Значение;
КонецФункции



Функция БезопасноеОписаниеОшибкиНастройки(Ошибка) Экспорт
	Причины = Новый Массив;
	Причины.Добавить(НСтр("ru='Некорректный путь заполняемого реквизита.'; en='Invalid target attribute path.'"));
	Причины.Добавить(НСтр("ru='Тип объекта не поддерживает начальное заполнение этой подсистемой.'; en='The object type does not support initial filling by this subsystem.'"));
	Причины.Добавить(НСтр("ru='Объект метаданных не найден.'; en='Metadata object was not found.'"));
	Причины.Добавить(НСтр("ru='Некорректный путь табличной части.'; en='Invalid tabular section path.'"));
	Причины.Добавить(НСтр("ru='Табличная часть не найдена.'; en='Tabular section was not found.'"));
	Причины.Добавить(НСтр("ru='Общий реквизит не включен в состав объекта.'; en='The common attribute is not included in the object.'"));
	Причины.Добавить(НСтр("ru='Недопустимый вид реквизита.'; en='Invalid attribute kind.'"));
	Причины.Добавить(НСтр("ru='Заполняемый реквизит не найден.'; en='Target attribute was not found.'"));
	Причины.Добавить(НСтр("ru='Реквизит исключен из начального заполнения.'; en='The attribute is excluded from initial filling.'"));
	Причины.Добавить(НСтр("ru='Количество повторов должно быть целым числом от 1 до 99.'; en='The repeat count must be an integer from 1 to 99.'"));
	Причины.Добавить(НСтр("ru='Тип значения настройки не соответствует реквизиту.'; en='The setting value type does not match the attribute.'"));
	Причины.Добавить(НСтр("ru='Значение не помещается в ограничения типа реквизита.'; en='The value exceeds the attribute type constraints.'"));
	Причины.Добавить(НСтр("ru='Настройка относится к другому объекту.'; en='The setting belongs to another object.'"));
	Для Каждого Причина Из Причины Цикл
		Если Ошибка.Описание = Причина Тогда
			Возврат Причина;
		КонецЕсли;
	КонецЦикла;
	Возврат НСтр("ru='Не удалось проверить настройку. Проверьте цель, тип значения, количество повторов и права.'; en='Could not validate the setting. Check the target, value type, repeat count and permissions.'");
КонецФункции

// Перемещает правило к предыдущему соседу по фактическому порядку кодов.
// Код - Число - ожидаемый код; без ссылки означает единственное правило с этим кодом сейчас.
// ВыбраннаяСсылка - СправочникСсылка.мямЗначенияПоУмолчанию, Неопределено - при передаче защищает от переиспользования устаревшего кода.
// Параметры не изменяет; граница, отсутствие цели/соседа или дубликат кода не меняют данные.
Процедура УменьшитьКод(Код, ВыбраннаяСсылка = Неопределено) Экспорт
	ВыполнитьПроверкуПравДоступа("Чтение", Метаданные.Справочники.мямЗначенияПоУмолчанию);
	ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.Справочники.мямЗначенияПоУмолчанию);

	ПереставитьКод(Код, ВыбраннаяСсылка, -1);

КонецПроцедуры

// Перемещает правило к следующему соседу по фактическому порядку кодов.
// Код - Число - ожидаемый код; без ссылки означает единственное правило с этим кодом сейчас.
// ВыбраннаяСсылка - СправочникСсылка.мямЗначенияПоУмолчанию, Неопределено - при передаче защищает от переиспользования устаревшего кода.
// Параметры не изменяет; граница, отсутствие цели/соседа или дубликат кода не меняют данные.
Процедура УвеличитьКод(Код, ВыбраннаяСсылка = Неопределено) Экспорт
	ВыполнитьПроверкуПравДоступа("Чтение", Метаданные.Справочники.мямЗначенияПоУмолчанию);
	ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.Справочники.мямЗначенияПоУмолчанию);

	ПереставитьКод(Код, ВыбраннаяСсылка, 1);

КонецПроцедуры

Функция МаксимальныйКодЗначенияПоУмолчанию() Экспорт
	ВыполнитьПроверкуПравДоступа("Чтение", Метаданные.Справочники.мямЗначенияПоУмолчанию);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Код КАК Код
		|ИЗ
		|	Справочник.мямЗначенияПоУмолчанию КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код УБЫВ";
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаИзРезультатаЗапроса = РезультатЗапроса.Выбрать();
	Пока ВыборкаИзРезультатаЗапроса.Следующий() Цикл
		Возврат ВыборкаИзРезультатаЗапроса.Код;
	КонецЦикла;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обменивает коды выбранного правила и реального соседа. Полная управляемая блокировка каталога
// берётся до чтения. Точная цель и направленные соседи читаются запросами ПЕРВЫЕ 2;
// дубликат кода, устаревший выбор или отсутствие соседа оставляет данные без изменений.
// Код - Число - текущий ожидаемый код. ВыбраннаяСсылка - ссылка этого каталога либо Неопределено:
// без ссылки выбирается единственное правило с данным кодом сейчас; со ссылкой проверяется и её совпадение.
// Направление - Число - -1 к предыдущему, 1 к следующему. Входные параметры не изменяются.
// Две записи выполняются в прежней транзакционной модели; при ошибке откат и запись в журнал.
Процедура ПереставитьКод(Код, ВыбраннаяСсылка, Направление)

    Если ТипЗнч(Код) <> Тип("Число") Тогда Возврат; КонецЕсли;
    Если ВыбраннаяСсылка <> Неопределено
        И ТипЗнч(ВыбраннаяСсылка) <> Тип("СправочникСсылка.мямЗначенияПоУмолчанию") Тогда
        Возврат;
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("Справочник.мямЗначенияПоУмолчанию");
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 2
        | Т.Ссылка КАК Ссылка,
        | Т.Код КАК Код
        |ИЗ Справочник.мямЗначенияПоУмолчанию КАК Т
        |ГДЕ Т.Код = &Код
        |УПОРЯДОЧИТЬ ПО Т.Ссылка";
        Запрос.УстановитьПараметр("Код", Код);
        Цели = Запрос.Выполнить().Выгрузить();
        Если Цели.Количество() <> 1 Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;
        Цель = Цели[0];
        Если ВыбраннаяСсылка <> Неопределено И Цель.Ссылка <> ВыбраннаяСсылка Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;
        Если Направление < 0 Тогда
            Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 2
            | Т.Ссылка КАК Ссылка,
            | Т.Код КАК Код
            |ИЗ Справочник.мямЗначенияПоУмолчанию КАК Т
            |ГДЕ Т.Код < &Код
            |УПОРЯДОЧИТЬ ПО Т.Код УБЫВ, Т.Ссылка";
        Иначе
            Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 2
            | Т.Ссылка КАК Ссылка,
            | Т.Код КАК Код
            |ИЗ Справочник.мямЗначенияПоУмолчанию КАК Т
            |ГДЕ Т.Код > &Код
            |УПОРЯДОЧИТЬ ПО Т.Код, Т.Ссылка";
        КонецЕсли;
        Запрос.УстановитьПараметр("Код", Код);
        Соседи = Запрос.Выполнить().Выгрузить();
        Если Соседи.Количество() = 0 Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;
        Если Соседи.Количество() > 1 И Соседи[0].Код = Соседи[1].Код Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;
        Сосед = Соседи[0];

        ОбъектЦели = Цель.Ссылка.ПолучитьОбъект();
        ОбъектСоседа = Сосед.Ссылка.ПолучитьОбъект();
        Если Цель.Код < Сосед.Код Тогда
            ОбъектЦели.Заблокировать();
            ОбъектСоседа.Заблокировать();
        Иначе
            ОбъектСоседа.Заблокировать();
            ОбъектЦели.Заблокировать();
        КонецЕсли;
        Если ОбъектЦели.Код <> Цель.Код Или ОбъектСоседа.Код <> Сосед.Код Тогда
            ЗафиксироватьТранзакцию();
            Возврат;
        КонецЕсли;
        ОбъектЦели.Код = Сосед.Код;
        ОбъектСоседа.Код = Цель.Код;
        ОбъектСоседа.Записать();
        ОбъектЦели.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("ЗначенияПоУмолчанию.ОшибкаПерестановкиКода",
            УровеньЖурналаРегистрации.Ошибка,
            Метаданные.Справочники.мямЗначенияПоУмолчанию,,
            ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

КонецПроцедуры


Функция ДопустимоеКоличество(Количество)
	Возврат ТипЗнч(Количество) = Тип("Число") И Количество >= 1
	И Количество <= 99 И Количество = Цел(Количество);
КонецФункции

Процедура ПрименитьНастройки(Объект, Настройки, Результат)
	План = Новый Массив;
	Таблицы = Новый Соответствие;
	Для Каждого Настройка Из Настройки Цикл
		Пункт = Новый Структура("Настройка, Описание, Значение, Ошибка, Начало, Количество",
		Настройка, Неопределено, Неопределено, "", 0, 0);
		Попытка
			Пункт.Описание = ОписаниеНастройки(Настройка);
			Если Пункт.Описание.ПолноеИмя <> Объект.Метаданные().ПолноеИмя() Тогда
				ВызватьИсключение НСтр("ru='Настройка относится к другому объекту.'; en='The setting belongs to another object.'");
			КонецЕсли;
			Если Не ПустаяСтрока(Пункт.Описание.ИмяТЧ) Тогда
				ИмяТЧ = Пункт.Описание.ИмяТЧ;
				Таблица = Таблицы.Получить(ИмяТЧ);
				Если Таблица = Неопределено Тогда
					Таблица = Новый Структура("Колонки, Строки, Количество", Новый Соответствие, Новый Массив, 0);
					Таблицы.Вставить(ИмяТЧ, Таблица);
				КонецЕсли;
				Начало = Таблица.Колонки.Получить(Пункт.Описание.Имя);
				Если Начало = Неопределено Тогда
					Начало = 0;
				КонецЕсли;
				Пункт.Начало = Начало;
				Пункт.Количество = Настройка.КоличествоПовторов;
				Таблица.Колонки.Вставить(Пункт.Описание.Имя, Начало + Пункт.Количество);
				Таблица.Количество = Макс(Таблица.Количество, Начало + Пункт.Количество);
			КонецЕсли;
			// Позиции резервируются ДО проверки значения: ошибка не сдвигает колонки.
			Пункт.Значение = ЗначениеНастройки(Настройка, Пункт.Описание);
		Исключение
			Пункт.Ошибка = БезопасноеОписаниеОшибкиНастройки(ИнформацияОбОшибке());
			ДобавитьОшибку(Результат, Настройка.Ссылка, Настройка.ЗаполняемыйРеквизит,
			?(Пункт.Количество > 0, Пункт.Начало + 1, 0), Пункт.Ошибка);
		КонецПопытки;
		План.Добавить(Пункт);
	КонецЦикла;

	Для Каждого Пара Из Таблицы Цикл
		Для Номер = 1 По Пара.Значение.Количество Цикл
			Попытка
				НоваяСтрока = Объект[Пара.Ключ].Добавить();
				Пара.Значение.Строки.Добавить(НоваяСтрока);
				Результат.КоличествоДобавленныхСтрок = Результат.КоличествоДобавленныхСтрок + 1;
				Результат.Изменено = Истина;
			Исключение
				Пара.Значение.Строки.Добавить(Неопределено);
				Для Каждого Пункт Из План Цикл
					Если Пункт.Описание <> Неопределено
					И Пункт.Описание.ИмяТЧ = Пара.Ключ
					И Номер > Пункт.Начало И Номер <= Пункт.Начало + Пункт.Количество Тогда
						ДобавитьОшибку(Результат, Пункт.Настройка.Ссылка,
						Пункт.Настройка.ЗаполняемыйРеквизит,
						Номер, НСтр("ru='Не удалось добавить новую строку.'; en='Could not add a new row.'"), Истина);
					КонецЕсли;
				КонецЦикла;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Пункт Из План Цикл
		Если Не ПустаяСтрока(Пункт.Ошибка) Тогда
			Продолжить;
		КонецЕсли;
		Успех = Ложь;
		Если ПустаяСтрока(Пункт.Описание.ИмяТЧ) Тогда
			Успех = ПрисвоитьЗначение(Объект, Пункт, Результат, 0);
		Иначе
			Таблица = Таблицы.Получить(Пункт.Описание.ИмяТЧ);
			Для Индекс = Пункт.Начало По Пункт.Начало + Пункт.Количество - 1 Цикл
				СтрокаТЧ = Таблица.Строки[Индекс];
				Если СтрокаТЧ = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ПрисвоитьЗначение(СтрокаТЧ, Пункт, Результат, Индекс + 1) Тогда
					Успех = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Успех Тогда
			Результат.КоличествоПримененныхПравил = Результат.КоличествоПримененныхПравил + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПрисвоитьЗначение(Цель, Пункт, Результат, НомерСтроки)
	Попытка
		Прежнее = Цель[Пункт.Описание.Имя];
		Цель[Пункт.Описание.Имя] = Пункт.Значение;
		Результат.Изменено = Результат.Изменено Или Прежнее <> Пункт.Значение;
		Возврат Истина;
	Исключение
		ДобавитьОшибку(Результат, Пункт.Настройка.Ссылка, Пункт.Настройка.ЗаполняемыйРеквизит,
		НомерСтроки, НСтр("ru='Не удалось присвоить значение. Проверьте тип, доступность реквизита и права.'; en='Could not assign the value. Check the type, attribute availability and permissions.'"), Истина);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура("Применено, Изменено, Статус, Причина, КоличествоПримененныхПравил, КоличествоДобавленныхСтрок",
	Ложь, Ложь, "Пропущено", "", 0, 0);
	Результат.Вставить("Ошибки", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура ЗавершитьРезультат(Результат)
	Результат.Применено = Результат.КоличествоПримененныхПравил > 0;
	Если Результат.Ошибки.Количество() > 0 Тогда
		Результат.Статус = ?(Результат.Применено Или Результат.Изменено, "ПримененоЧастично", "Ошибка");
	ИначеЕсли Результат.Применено Тогда
		Результат.Статус = "Применено";
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьОшибку(Результат, Настройка, Путь, НомерСтроки, Текст, Сбой = Ложь)
	Ошибка = Новый Структура("Настройка, Путь, НомерСтроки, Описание", Настройка, Путь, НомерСтроки, Текст);
	Результат.Ошибки.Добавить(Ошибка);
	Попытка
		ЗаписьЖурналаРегистрации("ЗначенияПоУмолчанию.ОшибкаПрименения",
		?(Сбой, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Предупреждение),
		Метаданные.Справочники.мямЗначенияПоУмолчанию, Настройка,
		Путь + НСтр("ru='; позиция новой строки: '; en='; new row position: '") + Строка(НомерСтроки) + "; " + Текст);
	Исключение
		// Ошибка журнала не прерывает обработку следующих настроек.
	КонецПопытки;
КонецПроцедуры

Процедура СообщитьОшибкиЗаполнения(Результат)

	Если Результат.Ошибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Текст = НСтр("ru='Не все значения по умолчанию удалось заполнить. Успешные значения сохранены.'; en='Some default values could not be filled. Successfully filled values were retained.'");
	Для Каждого Ошибка Из Результат.Ошибки Цикл
		Текст = Текст + Символы.ПС + Ошибка.Путь;
		Если Ошибка.НомерСтроки > 0 Тогда
			Текст = Текст + НСтр("ru=', новая строка '; en=', new row '") + Строка(Ошибка.НомерСтроки);
		КонецЕсли;
		Текст = Текст + ": " + Ошибка.Описание;
	КонецЦикла;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
