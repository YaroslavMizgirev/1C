#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Или ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Описание = мямЗначенияПоУмолчанию.ОписаниеНастройки(ЭтотОбъект);
		ПроверенноеЗначение = мямЗначенияПоУмолчанию.ЗначениеНастройки(ЭтотОбъект, Описание);
	Исключение
		ОтказатьВЗаписи(Отказ,
			мямЗначенияПоУмолчанию.БезопасноеОписаниеОшибкиНастройки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтказатьВЗаписи(Отказ, ТекстОшибки)

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = "ЗаполняемыйРеквизит";
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
