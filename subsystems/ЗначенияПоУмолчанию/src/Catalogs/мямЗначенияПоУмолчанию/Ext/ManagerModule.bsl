#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

	#Область ПрограммныйИнтерфейс



	Функция НастройкиОбъекта(ПолноеИмяОбъекта) Экспорт
		ВыполнитьПроверкуПравДоступа("Чтение", Метаданные.Справочники.мямЗначенияПоУмолчанию);
		Префикс = ПолноеИмяОбъекта + ".";
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		| Т.Ссылка КАК Ссылка,
		| Т.ЗаполняемыйРеквизит КАК ЗаполняемыйРеквизит,
		| Т.ЗначениеНастройки КАК ЗначениеНастройки,
		| Т.ЗначениеНастройкиСтрока КАК ЗначениеНастройкиСтрока,
		| Т.КоличествоПовторов КАК КоличествоПовторов
		|ИЗ
		| Справочник.мямЗначенияПоУмолчанию КАК Т
		|ГДЕ
		| НЕ Т.ПометкаУдаления
		| И ПОДСТРОКА(Т.ЗаполняемыйРеквизит, 1, &ДлинаПрефикса) = &Префикс
		|УПОРЯДОЧИТЬ ПО
		| Т.Код, Т.Ссылка";
		Запрос.УстановитьПараметр("Префикс", Префикс);
		Запрос.УстановитьПараметр("ДлинаПрефикса", СтрДлина(Префикс));
		Возврат Запрос.Выполнить().Выгрузить();
	КонецФункции

	#КонецОбласти

#КонецЕсли
