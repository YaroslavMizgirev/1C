
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Перем ПутьЗаполняемогоРеквизита;

	мямОбщегоНазначенияКлиентСервер.ЗаполнитьСписокОбъектовМетаданныхПоИдентификаторам(
		ЭтотОбъект, "ОбъектМетаданных");

	Параметры.Свойство("ЗаполняемыйРеквизит", ПутьЗаполняемогоРеквизита);
	Если Не ЗначениеЗаполнено(ПутьЗаполняемогоРеквизита) Тогда
		Возврат;
	КонецЕсли;

	МассивЭлементов = СтрРазделить(ПутьЗаполняемогоРеквизита, ".", Ложь);
	Если МассивЭлементов.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = МассивЭлементов[0] + "." + МассивЭлементов[1];
	мямОбщегоНазначенияКлиентСервер.ЗаполнитьСписокЗаполняемыхРеквизитов(
		ЭтотОбъект, ОбъектМетаданных, "ЗаполняемыйРеквизит");
	ЗаполняемыйРеквизит = ПутьЗаполняемогоРеквизита;
	Представление = ПутьЗаполняемогоРеквизита;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОповеститьОВыборе(Представление);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектМетаданныхПриИзменении(Элемент)

	Элементы.ЗаполняемыйРеквизит.СписокВыбора.Очистить();
	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(ЗаполняемыйРеквизит);
	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(Представление);

	Если ПустаяСтрока(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;

	мямОбщегоНазначенияКлиентСервер.ЗаполнитьСписокЗаполняемыхРеквизитов(
		ЭтотОбъект, ОбъектМетаданных, "ЗаполняемыйРеквизит");

КонецПроцедуры

&НаКлиенте
Процедура ОбъектМетаданныхАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если Ожидание = 0 Или ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = СформироватьДанныеАвтоподбора(Элемент.СписокВыбора, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОбъектМетаданныхОчистка(Элемент, СтандартнаяОбработка)

	Элементы.ЗаполняемыйРеквизит.СписокВыбора.Очистить();
	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(ЗаполняемыйРеквизит);
	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(Представление);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполняемыйРеквизитПриИзменении(Элемент)

	Представление = ЗаполняемыйРеквизит;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполняемыйРеквизитАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если Ожидание = 0 Или ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = СформироватьДанныеАвтоподбора(Элемент.СписокВыбора, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполняемыйРеквизитОчистка(Элемент, СтандартнаяОбработка)

	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(Представление);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СформироватьДанныеАвтоподбора(СписокВыбора, Текст)

	Результат = Новый СписокЗначений;
	СтрокаПоиска = НРег(СокрЛП(Текст));
	Для Каждого ЭлементВыбора Из СписокВыбора Цикл
		Если СтрНайти(НРег(Строка(ЭлементВыбора.Значение)), СтрокаПоиска) > 0
			Или СтрНайти(НРег(Строка(ЭлементВыбора.Представление)), СтрокаПоиска) > 0 Тогда
			Результат.Добавить(ЭлементВыбора.Значение, ЭлементВыбора.Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Выбрать(Команда)

	Если Не ПустаяСтрока(ЗаполняемыйРеквизит) Тогда
		Закрыть();
	Иначе
		ПредупреждениеАсинх(
			НСтр("ru='Не заполнен заполняемый реквизит';en='The requisite to fill is not specified'"),
			60,
			НСтр("ru='Предупреждение';en='Alert'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
