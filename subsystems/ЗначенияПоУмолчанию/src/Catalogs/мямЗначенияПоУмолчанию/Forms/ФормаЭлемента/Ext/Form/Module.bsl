
#Область ОписаниеПеременных

&НаКлиенте
Перем КэшЗаполняемыйРеквизит;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не Объект.Ссылка.Пустая() Тогда УправлениеЭлементамиФормы(); КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура ЗаполняемыйРеквизитНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	КэшЗаполняемыйРеквизит = Элемент.ТекстРедактирования;

	ПараметрыОткрытияФормы = Новый Структура;
	Если Не ПустаяСтрока(Элемент.ТекстРедактирования) Тогда ПараметрыОткрытияФормы.Вставить("ЗаполняемыйРеквизит", Элемент.ТекстРедактирования); КонецЕсли;
	ОткрытьФорму("Справочник.мямЗначенияПоУмолчанию.Форма.ФормаВыбораРеквизита", ПараметрыОткрытияФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполняемыйРеквизитОчистка(Элемент, СтандартнаяОбработка)

	КэшЗаполняемыйРеквизит = Неопределено;
	Объект.ЗначениеНастройки = Неопределено;
	мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(Объект.ЗначениеНастройкиСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполняемыйРеквизитОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Объект.ЗаполняемыйРеквизит = ВыбранноеЗначение;
		Если КэшЗаполняемыйРеквизит <> Объект.ЗаполняемыйРеквизит Тогда
			Объект.ЗначениеНастройки = Неопределено;
			мямСтрокаКлиентСервер.ОчиститьЗначениеСтроки(Объект.ЗначениеНастройкиСтрока);
		КонецЕсли;

	КонецЕсли;
	УправлениеЭлементамиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНастройкиСтрокаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.ЗначениеНастройкиСтрока", НСтр("ru='Значение настройки';en='Setting value';"));

КонецПроцедуры

&НаКлиенте
Процедура КоличествоПовторовПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.ЗаполняемыйРеквизит) Тогда
		МассивЭлементов = СтрРазделить(Объект.ЗаполняемыйРеквизит, ".", Ложь);
		Если МассивЭлементов.Количество() <= 4 Тогда Объект.КоличествоПовторов = 1; КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РедактироватьКод(Команда)

	Элементы.Код.ТолькоПросмотр = Не Элементы.Код.ТолькоПросмотр;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеЭлементамиФормы()

	Если ЗначениеЗаполнено(Объект.ЗаполняемыйРеквизит) Тогда
		Попытка
			ОписаниеТипа = мямОбщегоНазначенияВызовСервера.ОписаниеТипаРеквизитаОбъектаМетаданных(Объект.ЗаполняемыйРеквизит);
		Исключение
			Сообщить(СтрШаблон(
				НСтр("ru='Не удалось определить тип заполняемого реквизита: %1.'"),
				Объект.ЗаполняемыйРеквизит));
			Элементы.ПустоеЗначениеНастройки.Видимость = Истина;
			Элементы.ЗначениеНастройки.Видимость = Ложь;
			Элементы.ЗначениеНастройкиСтрока.Видимость = Ложь;
			Возврат;
		КонецПопытки;
		Элементы.ПустоеЗначениеНастройки.Видимость = Ложь;
		Если ОписаниеТипа.Типы().Количество()=1 И ОписаниеТипа.СодержитТип(Тип("Строка")) И ОписаниеТипа.КвалификаторыСтроки.Длина = 0 Тогда
			Элементы.ЗначениеНастройки.Видимость = Ложь;
			Элементы.ЗначениеНастройкиСтрока.Видимость = Истина;
		Иначе
			Элементы.ЗначениеНастройкиСтрока.Видимость = Ложь;
			Элементы.ЗначениеНастройки.Видимость = Истина;
			Элементы.ЗначениеНастройки.ОграничениеТипа = ОписаниеТипа;
		КонецЕсли;

	Иначе
		Элементы.ПустоеЗначениеНастройки.Видимость = Истина;
		Элементы.ЗначениеНастройки.Видимость = Ложь;
		Элементы.ЗначениеНастройкиСтрока.Видимость = Ложь;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти
