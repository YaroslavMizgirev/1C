// Функция - Добавить в массив.
//  Добавляет значения в массив-источник и возвращает его.
//
// Параметры:
//  Значение1 - Произвольное.
//  Значение2 - Произвольное.
//  Значение3 - Произвольное.
//  Значение4 - Произвольное.
//  Значение5 - Произвольное.
//  Значение6 - Произвольное.
//  Значение7 - Произвольное.
//  Значение8 - Произвольное.
//  Значение9 - Произвольное.
//  Значение10 - Произвольное.
//  МассивИсточник - Неопределено, Массив.
//   Если Неопределено, переданная переменная заменяется новым массивом. Массив дополняется Значением1; добавление каждого из Значений2–10 зависит от условия Значение2 <> Неопределено.
//
// Возвращаемое значение:
//   - Массив Из Произвольное.
//
Функция ДобавитьВМассив(Значение1,Значение2=Неопределено,Значение3=Неопределено,Значение4=Неопределено,Значение5=Неопределено,Значение6=Неопределено,Значение7=Неопределено,Значение8=Неопределено,Значение9=Неопределено,Значение10=Неопределено,Знач МассивИсточник=Неопределено) Экспорт

	ЕслиМассивНеопределеноТоНовый(МассивИсточник);
	МассивИсточник.Добавить(Значение1);
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение2); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение3); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение4); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение5); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение6); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение7); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение8); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение9); КонецЕсли;
	Если Значение2<>Неопределено Тогда МассивИсточник.Добавить(Значение10); КонецЕсли;
	Возврат МассивИсточник;

КонецФункции

// Процедура - Дополнить массив.
//  Дополняет массив МассивПриемник значениями из массива МассивИсточник.
//
// Параметры:
//  МассивПриемник       - Массив Из Произвольный - массив, в который необходимо добавить значения.
//   Дополняет переданный массив значениями источника; при ТолькоУникальныеЗначения добавляет только отсутствующие значения.
//  МассивИсточник       - Массив Из Произвольный - массив значений для заполнения.
//  ТолькоУникальныеЗначения  - Булево - если Истина, то в массив будут включены только уникальные значения.
//
Процедура ДополнитьМассив(МассивПриемник,МассивИсточник,ТолькоУникальныеЗначения=Ложь) Экспорт

	Если ТолькоУникальныеЗначения Тогда
		УникальныеЗначения = Новый Соответствие;
		Для Каждого Значение Из МассивПриемник Цикл
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЦикла;

		Для Каждого Значение Из МассивИсточник Цикл
			Если УникальныеЗначения[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Проверяет значение массива.
//  Если значение "Неопределено", тогда значение заменяется на пустой массив.
//
// Параметры:
//  ПроверяемыйМассив - Неопределено,
//   Если передано Неопределено, заменяет переданную переменную новым пустым массивом; другое значение сохраняет.
//                    - Массив.
//
Процедура ЕслиМассивНеопределеноТоНовый(ПроверяемыйМассив) Экспорт

	Если ПроверяемыйМассив = Неопределено Тогда ПроверяемыйМассив = Новый Массив; КонецЕсли;

КонецПроцедуры

// Функция - Значение в массиве.
//
// Параметры:
//  Значение1  - Произвольное.
//
// Возвращаемое значение:
//   - Массив Из Произвольное.
//
Функция ЗначениеВМассиве(Значение1) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Значение1);

	Возврат Результат;

КонецФункции

