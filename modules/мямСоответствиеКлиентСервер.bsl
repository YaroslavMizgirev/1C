#Область ПрограммныйИнтерфейс

// Функция - Сортировать по ключу.
//
// Параметры:
//  ПроверяемоеСоответствие - Соответствие.
//   Несмотря на Знач, очищает сам переданный объект соответствия и вставляет отсортированные ключи без прежних значений; возвращает этот же объект.
//  СпособСортировки - Строка - Принимаемые значения: "Возр", "Убыв".
//
// Возвращаемое значение:
//   - Соответствие - Отсортированное по ключу.
//
Функция СортироватьПоКлючу(Знач ПроверяемоеСоответствие,СпособСортировки="Возр") Экспорт

	Перем временныйСписок;

	временныйСписок = Новый СписокЗначений;
	Для Каждого ЭлементСоответствия Из ПроверяемоеСоответствие Цикл временныйСписок.Добавить(ЭлементСоответствия.Ключ); КонецЦикла;
	временныйСписок.СортироватьПоЗначению(НаправлениеСортировки[СпособСортировки]);
	ПроверяемоеСоответствие.Очистить();

	Для Каждого значениеСписка Из временныйСписок Цикл ПроверяемоеСоответствие.Вставить(значениеСписка.Значение); КонецЦикла;
	Возврат ПроверяемоеСоответствие;

КонецФункции

#КонецОбласти
