#Область ПрограммныйИнтерфейс

// Функция - Значение в булево.
//
// Параметры:
//  Значение - Произвольное.
//  ЗначениеСравнения - Строка.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ЗначениеВБулево(Знач Значение,ЗначениеСравнения="Актуально") Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	СтроковоеЗначение = НРег(мямСтрокаКлиентСервер.ЗначениеВСтроку(Значение));
	Возврат СтроковоеЗначение = "да"
		Или СтроковоеЗначение = "истина"
		Или СтроковоеЗначение = "true"
		Или СтроковоеЗначение = "yes"
		Или СтроковоеЗначение = "1"
		Или СтроковоеЗначение = ЗначениеСравнения;

КонецФункции

// Функция - Это булево.
//
// Параметры:
//  ПроверяемоеЗначение  - Произвольный.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ЭтоБулево(ПроверяемоеЗначение) Экспорт

	Возврат ТипЗнч(ПроверяемоеЗначение) = Тип("Булево");

КонецФункции

#КонецОбласти
