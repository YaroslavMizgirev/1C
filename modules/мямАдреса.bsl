#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает адрес по UUID из локально загруженного адресного классификатора.
// Каждая ветвь обходится до региона без ограничения глубины и числа ветвей.
// Данные читаются пакетами новых UUID; общий предок читается один раз за вызов.
// Для дома остаётся потоковое чтение и распаковка блоков ХранилищеЗначения.
//
// Параметры:
//  КодФИАС - Строка, УникальныйИдентификатор - UUID адресного объекта или дома/строения.
//
// Возвращаемое значение:
//  Структура:
//   * КодФИАС - Строка - нормализованный входной UUID; сохраняется и при NOT_FOUND.
//   * Статус - Строка - FOUND, PARTIAL, NOT_FOUND или AMBIGUOUS.
//   * Представление - Строка - штатный текст выбранного адреса без страны.
//   * XML - Строка - штатный XML контактной информации выбранного адреса.
//   * МуниципальныйАдрес - Строка - полный однозначный муниципальный путь с домом.
//   * АдминистративныйАдрес - Строка - полный однозначный административный путь с домом.
//   * МуниципальныйРайон - Строка - имя единственного узла уровня 3 полного муниципального пути.
//   * КодОКАТО - Строка - нормализованный код уровня 2, 5, 8 или 11 цифр, иначе пустая строка.
//   * КодОКТМО - Строка - код муниципальной территории.
//   * ОКТМОДома - Число - код найденного блока домов, либо 0.
//   * ДополнительныеАдресныеСведения - ТаблицаЗначений - локальные коды кандидата.
//   * Диагностика - Массив из Строка - причины неполноты, неоднозначности и предупреждения.
//
// FOUND означает успешное формирование Представления и XML. При остальных статусах эти два поля пусты.
// PARTIAL означает, что объект найден, но полный итоговый результат сформировать не удалось.
// NOT_FOUND означает, что входной UUID не найден в поддержанных локальных данных.
// AMBIGUOUS означает, что найдено несколько вариантов, единственный результат выбрать нельзя.
//
Функция ЗначенияАдресаПоФИАС(Знач КодФИАС) Экспорт

	Если ТипЗнч(КодФИАС) = Тип("УникальныйИдентификатор") Тогда
		ИдентификаторФИАС = КодФИАС;
	ИначеЕсли ТипЗнч(КодФИАС) = Тип("Строка") Тогда
		Попытка
			ИдентификаторФИАС = Новый УникальныйИдентификатор(СокрЛП(КодФИАС));
		Исключение
			ВызватьИсключение НСтр("ru = 'Код ФИАС не распознан как UUID.'; en = 'The FIAS code is not a valid UUID.'");
		КонецПопытки;
	Иначе
		ВызватьИсключение НСтр("ru = 'На входе требуется UUID ФИАС.'; en = 'A FIAS UUID is required.'");
	КонецЕсли;
	Если ИдентификаторФИАС = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
		ВызватьИсключение НСтр("ru = 'UUID ФИАС не должен быть пустым.'; en = 'The FIAS UUID must not be empty.'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Статус", "NOT_FOUND");
	Результат.Вставить("КодФИАС", Строка(ИдентификаторФИАС));
	Результат.Вставить("Представление", "");
	Результат.Вставить("XML", "");
	Результат.Вставить("МуниципальныйАдрес", "");
	Результат.Вставить("АдминистративныйАдрес", "");
	Результат.Вставить("МуниципальныйРайон", "");
	Результат.Вставить("ОКТМОДома", 0);
	Результат.Вставить("КодОКАТО", "");
	Результат.Вставить("КодОКТМО", "");
	Результат.Вставить("ДополнительныеАдресныеСведения", Новый ТаблицаЗначений);
	Результат.Вставить("Диагностика", Новый Массив);
	Кандидаты = КандидатыАдресаПоФИАС(ИдентификаторФИАС);
	Если Кандидаты.Количество() = 0 Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'UUID не найден в локальных адресных объектах и домах.'; en = 'The UUID was not found among local address objects and houses.'"));
		Возврат Результат;
	КонецЕсли;
	Если Кандидаты.Количество() > 1 Тогда
		Результат.Статус = "AMBIGUOUS";
		Результат.Диагностика.Добавить(НСтр("ru = 'UUID найден более одного раза; единственный адрес не выбран.'; en = 'The UUID was found more than once; no single address was selected.'"));
		Возврат Результат;
	КонецЕсли;

	Кандидат = Кандидаты[0];
	Дом = СведенияОДоме(Кандидат.СтрокаДома, Результат.Диагностика);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Сведения.Идентификатор КАК Идентификатор,
	|	Сведения.КодСубъектаРФ КАК КодСубъектаРФ,
	|	Сведения.ПочтовыйИндекс КАК ПочтовыйИндекс,
	|	Сведения.ОКТМО КАК ОКТМО,
	|	Сведения.OKATO КАК OKATO,
	|	Сведения.КодУчасткаИФНСЮЛ КАК КодУчасткаИФНСЮЛ,
	|	Сведения.КодУчасткаИФНСФЛ КАК КодУчасткаИФНСФЛ,
	|	Сведения.КодИФНСЮЛ КАК КодИФНСЮЛ,
	|	Сведения.ОКТМОБюджетополучателя КАК ОКТМОБюджетополучателя,
	|	Сведения.КодИФНСФЛ КАК КодИФНСФЛ
	|ИЗ
	|	РегистрСведений.ДополнительныеАдресныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Идентификатор = &ИдентификаторКодов
	|	И Сведения.КодСубъектаРФ = &КодСубъектаРФ");
	Запрос.УстановитьПараметр("ИдентификаторКодов", Кандидат.ИдентификаторКодов);
	Запрос.УстановитьПараметр("КодСубъектаРФ", Кандидат.КодСубъектаРФ);
	Результат.ДополнительныеАдресныеСведения = Запрос.Выполнить().Выгрузить();
	Если Результат.ДополнительныеАдресныеСведения.Количество() = 1 Тогда
		Результат.КодОКТМО = КодКлассификатораАдреса(Результат.ДополнительныеАдресныеСведения[0].ОКТМО, "ОКТМО");
	КонецЕсли;
	ЗаполнитьКодОКАТОАдреса(Результат);
	Если Не ПустаяСтрока(Кандидат.СтрокаДома)
		И Результат.ДополнительныеАдресныеСведения.Количество() = 1 Тогда
		Результат.ОКТМОДома = Результат.ДополнительныеАдресныеСведения[0].ОКТМО;
	КонецЕсли;

	УровниАдреса = АдресныйКлассификаторПовтИсп.НомераУровнейАдресаПоНаименованию();
	Граф = ГрафАдреса(Кандидат, УровниАдреса.area);
	МуниципальныеВетви = ВетвиАдреса(Граф.Объекты, Граф.МуниципальныеРодители,
		Кандидат.ИдентификаторРодителя, УровниАдреса.area, "МуниципальнаяИерархия", Результат.Диагностика);
	АдминистративныеВетви = ВетвиАдреса(Граф.Объекты, Граф.АдминистративныеРодители,
		Кандидат.ИдентификаторРодителя, УровниАдреса.area, "АдминистративнаяИерархия", Результат.Диагностика);
	МуниципальнаяЦепочка = ВыбраннаяЦепочка(МуниципальныеВетви, Истина, Результат.ОКТМОДома, УровниАдреса);
	АдминистративнаяЦепочка = ВыбраннаяЦепочка(АдминистративныеВетви, Ложь, 0, УровниАдреса);
	Если МуниципальнаяЦепочка.Неоднозначная Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Муниципальная цепочка не определена однозначно, в том числе по ОКТМО дома.'; en = 'The municipal path is ambiguous, including selection by the house OKTMO.'"));
	КонецЕсли;
	Если АдминистративнаяЦепочка.Неоднозначная Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Административная цепочка не определена однозначно.'; en = 'The administrative path is ambiguous.'"));
	КонецЕсли;
	Если МуниципальнаяЦепочка.Полная Тогда
		Районы = Новый Массив;
		Для Каждого Узел Из МуниципальнаяЦепочка.Узлы Цикл
			Если Узел.Уровень = УровниАдреса.munDistrict Тогда
				Районы.Добавить(Узел.Наименование);
			КонецЕсли;
		КонецЦикла;
		Если Районы.Количество() = 1 Тогда
			Результат.МуниципальныйРайон = Районы[0];
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Результат.МуниципальныйРайон) Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Муниципальный район не определён однозначно по полному локальному пути.'; en = 'The municipal district could not be uniquely determined from a complete local path.'"));
	КонецЕсли;
	Если МуниципальнаяЦепочка.Полная И Дом.Полный Тогда
		Результат.МуниципальныйАдрес = ПредставлениеЦепочки(МуниципальнаяЦепочка.Узлы, Дом.Представление, УровниАдреса.area);
	КонецЕсли;
	Если АдминистративнаяЦепочка.Полная И Дом.Полный Тогда
		Результат.АдминистративныйАдрес = ПредставлениеЦепочки(АдминистративнаяЦепочка.Узлы, Дом.Представление, УровниАдреса.area);
	КонецЕсли;

	ВыбраннаяЦепочка = МуниципальнаяЦепочка;
	Если ВыбраннаяЦепочка.Неоднозначная Тогда
		ВыбраннаяЦепочка = АдминистративнаяЦепочка;
	ИначеЕсли АдминистративнаяЦепочка.Полная И Не ВыбраннаяЦепочка.Полная Тогда
		ВыбраннаяЦепочка = АдминистративнаяЦепочка;
	ИначеЕсли Не ВыбраннаяЦепочка.Полная И Не АдминистративнаяЦепочка.Неоднозначная
		И АдминистративнаяЦепочка.Узлы.Количество() > ВыбраннаяЦепочка.Узлы.Количество() Тогда
		ВыбраннаяЦепочка = АдминистративнаяЦепочка;
	КонецЕсли;
	Если ВыбраннаяЦепочка.Неоднозначная Тогда
		Результат.Статус = "AMBIGUOUS";
	ИначеЕсли Не ВыбраннаяЦепочка.Полная Или Не Дом.Полный Тогда
		Результат.Статус = "PARTIAL";
	Иначе
		ЗаполнитьШтатныйФорматАдресаПоФИАС(Результат, ВыбраннаяЦепочка, Кандидат, Дом, УровниАдреса);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Дополняет результат штатной формы ввода адреса сведениями локального классификатора.
//
// Параметры:
//  ВыбранноеЗначение - Структура - результат формы ввода адреса:
//   * Значение - Строка - исходный JSON адреса, содержащий UUID выбранных объектов.
//   * КонтактнаяИнформация - Строка - исходный XML контактной информации.
//   * Представление - Строка - исходное представление адреса.
//   * Тип - ПеречислениеСсылка.ТипыКонтактнойИнформации - необязательный тип, ожидается Адрес.
//   * ВведеноВСвободнойФорме - Булево - необязательный признак свободного ввода.
//
// Возвращаемое значение:
//  Структура:
//   * Статус - Строка - FOUND, PARTIAL, NOT_FOUND или AMBIGUOUS.
//   * Представление - Строка - исходное Представление без преобразований.
//   * XML - Строка - исходная КонтактнаяИнформация без преобразований.
//   * МуниципальныйАдрес - Строка - полный однозначный муниципальный путь с домом и помещениями.
//   * АдминистративныйАдрес - Строка - полный однозначный административный путь с домом и помещениями.
//   * МуниципальныйРайон - Строка - локальное имя единственного узла муниципального уровня 3.
//   * КодОКАТО - Строка - нормализованный код уровня 2, 5, 8 или 11 цифр, иначе пустая строка.
//   * КодОКТМО - Строка - код муниципальной территории.
//   * ОКТМОДома - Число - локальный ОКТМО найденного дома, для адресного объекта 0.
//   * ДополнительныеАдресныеСведения - ТаблицаЗначений - точные строки локального регистра кодов.
//   * Диагностика - Массив из Строка - причины неполноты, неоднозначности и предупреждения.
//   * КодФИАС - Строка - нормализованный UUID дома либо адресного объекта; иначе пустая строка.
//
// FOUND: UUID подтверждён локальными данными, выбран хотя бы один полный путь,
// сведения согласованы, исходные XML и Представление непусты.
// PARTIAL: данные формы непригодны или противоречивы, дом повреждён, единственный
// путь оборван/зациклен либо отсутствует исходный XML или Представление.
// NOT_FOUND: корректные UUID не найдены в точном локальном контексте.
// AMBIGUOUS: найдены дубли либо ни в одной иерархии не выбран единственный путь.
// При пустом исходном XML/Представлении итог всегда PARTIAL; остальные причины
// отсутствия или неоднозначности данных остаются в Диагностике.
//
Функция ЗначенияАдресаПоКонтактнойИнформации(Знач ВыбранноеЗначение) Экспорт

	Перем ТипКонтактнойИнформации, СвободныйВвод;

	ПроверитьВходПоКонтактномуАдресу(ВыбранноеЗначение);
	Результат = Новый Структура;
	Результат.Вставить("Статус", "PARTIAL");
	Результат.Вставить("Представление", ВыбранноеЗначение.Представление);
	Результат.Вставить("XML", ВыбранноеЗначение.КонтактнаяИнформация);
	Результат.Вставить("МуниципальныйАдрес", "");
	Результат.Вставить("АдминистративныйАдрес", "");
	Результат.Вставить("МуниципальныйРайон", "");
	Результат.Вставить("ОКТМОДома", 0);
	Результат.Вставить("КодОКАТО", "");
	Результат.Вставить("КодОКТМО", "");
	Результат.Вставить("ДополнительныеАдресныеСведения", Новый ТаблицаЗначений);
	Результат.Вставить("Диагностика", Новый Массив);
	Результат.Вставить("КодФИАС", "");
	ИсходныеСтрокиПолные = Не ПустаяСтрока(Результат.XML) И Не ПустаяСтрока(Результат.Представление);
	Если Не ИсходныеСтрокиПолные Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'В результате формы отсутствует XML или Представление.'; en = 'The form result has no XML or representation.'"));
	КонецЕсли;
	Если ВыбранноеЗначение.Свойство("Тип", ТипКонтактнойИнформации) И ТипКонтактнойИнформации <> Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Выбрана контактная информация другого типа.'; en = 'The selected contact information is not an address.'"));
		Возврат Результат;
	КонецЕсли;
	Если ВыбранноеЗначение.Свойство("ВведеноВСвободнойФорме", СвободныйВвод) Тогда
		Если ТипЗнч(СвободныйВвод) <> Тип("Булево") Или СвободныйВвод Тогда
			Результат.Диагностика.Добавить(НСтр("ru = 'Свободный ввод или некорректный признак свободного ввода: UUID не распознаётся по тексту.'; en = 'Free-form input or an invalid free-form flag: a UUID cannot be inferred from text.'"));
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	ПоляАдреса = ПоляПоКонтактномуАдресу(ВыбранноеЗначение.Значение, Результат.Диагностика);
	Если ПоляАдреса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.КодОКТМО = КодКлассификатораАдреса(ПоляАдреса.КодОКТМО, "ОКТМО");
	Результат.КодОКАТО = КодКлассификатораАдреса(ПоляАдреса.КодОКАТО, "ОКАТО");
	ЕстьДом = ЗначениеЗаполнено(ПоляАдреса.houseId) Или Не ПустаяСтрока(ПоляАдреса.houseNumber)
		Или ПоляАдреса.buildings.Количество() > 0;
	Если ЕстьДом Тогда
		ЦелевойUUID = ПоляАдреса.houseId;
	Иначе
		ЦелевойUUID = ПоляАдреса.id;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЦелевойUUID) Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'В JSON отсутствует UUID выбранного дома или адресного объекта; UUID улицы вместо дома не подставляется.'; en = 'The JSON has no UUID of the selected house or address object; a street UUID is not substituted for a house UUID.'"));
		ЗаполнитьКодОКАТОАдреса(Результат);
		Возврат Результат;
	КонецЕсли;
	Результат.КодФИАС = Строка(ЦелевойUUID);
	РодительUUID = ПоляАдреса.id;
	Если ЕстьДом И Не ЗначениеЗаполнено(РодительUUID) Тогда
		РодительUUID = РаботаСАдресамиКлиентСервер.ИдентификаторАдреса(ПоляАдреса, Истина, Ложь);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(РодительUUID) Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Не указан UUID адресообразующего родителя дома.'; en = 'The UUID of the house address parent is missing.'"));
		ЗаполнитьКодОКАТОАдреса(Результат);
		Возврат Результат;
	КонецЕсли;
	Кандидаты = ОбъектыПоКонтактномуАдресу(РодительUUID, ПоляАдреса.areaCode);
	Если Кандидаты.Количество() <> 1 Тогда
		Если ИсходныеСтрокиПолные Тогда
			Результат.Статус = ?(Кандидаты.Количество() = 0, "NOT_FOUND", "AMBIGUOUS");
		КонецЕсли;
		Результат.Диагностика.Добавить(НСтр("ru = 'Адресообразующий объект не найден однозначно в локальном классификаторе.'; en = 'The address object was not uniquely found in the local classifier.'"));
		ЗаполнитьКодОКАТОАдреса(Результат);
		Возврат Результат;
	КонецЕсли;
	Кандидат = Кандидаты[0];
	Если ЕстьДом Тогда
		КандидатыДомов = ДомаПоКонтактномуАдресу(ЦелевойUUID, Кандидат);
		Если КандидатыДомов.Количество() <> 1 Тогда
			Если ИсходныеСтрокиПолные Тогда
				Результат.Статус = ?(КандидатыДомов.Количество() = 0, "NOT_FOUND", "AMBIGUOUS");
			КонецЕсли;
			Результат.Диагностика.Добавить(НСтр("ru = 'UUID дома не найден однозначно у указанного локального родителя и региона.'; en = 'The house UUID was not uniquely found under the specified local parent and region.'"));
			ЗаполнитьКодОКАТОАдреса(Результат);
		Возврат Результат;
		КонецЕсли;
		Кандидат = КандидатыДомов[0];
	КонецЕсли;
	Дом = СведенияОДоме(Кандидат.СтрокаДома, Результат.Диагностика);
	Согласованность = Истина;
	Если ЕстьДом Тогда
		Согласованность = СогласованДомПоКонтактномуАдресу(Дом, ПоляАдреса, Результат.Диагностика);
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Сведения.Идентификатор КАК Идентификатор,
	|	Сведения.КодСубъектаРФ КАК КодСубъектаРФ,
	|	Сведения.ПочтовыйИндекс КАК ПочтовыйИндекс,
	|	Сведения.ОКТМО КАК ОКТМО,
	|	Сведения.OKATO КАК OKATO,
	|	Сведения.КодУчасткаИФНСЮЛ КАК КодУчасткаИФНСЮЛ,
	|	Сведения.КодУчасткаИФНСФЛ КАК КодУчасткаИФНСФЛ,
	|	Сведения.КодИФНСЮЛ КАК КодИФНСЮЛ,
	|	Сведения.ОКТМОБюджетополучателя КАК ОКТМОБюджетополучателя,
	|	Сведения.КодИФНСФЛ КАК КодИФНСФЛ
	|ИЗ
	|	РегистрСведений.ДополнительныеАдресныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Идентификатор = &ИдентификаторКодов
	|	И Сведения.КодСубъектаРФ = &КодСубъектаРФ");
	Запрос.УстановитьПараметр("ИдентификаторКодов", Кандидат.ИдентификаторКодов);
	Запрос.УстановитьПараметр("КодСубъектаРФ", Кандидат.КодСубъектаРФ);
	Результат.ДополнительныеАдресныеСведения = Запрос.Выполнить().Выгрузить();
	Если Результат.ДополнительныеАдресныеСведения.Количество() = 1 Тогда
		ЛокальныйОКТМО = Результат.ДополнительныеАдресныеСведения[0].ОКТМО;
		Если ЕстьДом Тогда
			Результат.ОКТМОДома = ЛокальныйОКТМО;
		КонецЕсли;
		Если ПоляАдреса.oktmo > 0 И ЛокальныйОКТМО > 0 И ПоляАдреса.oktmo <> ЛокальныйОКТМО Тогда
			Согласованность = Ложь;
			Результат.Диагностика.Добавить(НСтр("ru = 'ОКТМО формы отличается от локального ОКТМО выбранного объекта или дома.'; en = 'The form OKTMO differs from the local OKTMO of the selected object or house.'"));
		КонецЕсли;
	КонецЕсли;
	УровниАдреса = АдресныйКлассификаторПовтИсп.НомераУровнейАдресаПоНаименованию();
	Граф = ГрафАдреса(Кандидат, УровниАдреса.area);
	МуниципальныеВетви = ВетвиАдреса(Граф.Объекты, Граф.МуниципальныеРодители,
		Кандидат.ИдентификаторРодителя, УровниАдреса.area, "МуниципальнаяИерархия", Результат.Диагностика);
	АдминистративныеВетви = ВетвиАдреса(Граф.Объекты, Граф.АдминистративныеРодители,
		Кандидат.ИдентификаторРодителя, УровниАдреса.area, "АдминистративнаяИерархия", Результат.Диагностика);
	МуниципальныеВетви = ВетвиМуниципалитетаПоКонтактномуАдресу(МуниципальныеВетви,
		ПоляАдреса.munDistrictId, УровниАдреса.munDistrict, Согласованность, Результат.Диагностика);
	МуниципальнаяЦепочка = ВыбраннаяЦепочка(МуниципальныеВетви, Истина, Результат.ОКТМОДома, УровниАдреса);
	АдминистративнаяЦепочка = ВыбраннаяЦепочка(АдминистративныеВетви, Ложь, 0, УровниАдреса);
	Если МуниципальнаяЦепочка.Неоднозначная Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Муниципальная цепочка не определена однозначно по локальным данным.'; en = 'The municipal path is ambiguous in the local data.'"));
	КонецЕсли;
	Если АдминистративнаяЦепочка.Неоднозначная Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Административная цепочка не определена однозначно по локальным данным.'; en = 'The administrative path is ambiguous in the local data.'"));
	КонецЕсли;
	Если МуниципальнаяЦепочка.Полная Тогда
		Районы = Новый Массив;
		Для Каждого Узел Из МуниципальнаяЦепочка.Узлы Цикл
			Если Узел.Уровень = УровниАдреса.munDistrict Тогда
				Районы.Добавить(Узел.Наименование);
			КонецЕсли;
		КонецЦикла;
		Если Районы.Количество() = 1 Тогда
			Результат.МуниципальныйРайон = Районы[0];
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Результат.МуниципальныйРайон) Тогда
		Результат.Диагностика.Добавить(НСтр("ru = 'Муниципальный район не определён однозначно по полному локальному пути.'; en = 'The municipal district could not be uniquely determined from a complete local path.'"));
	КонецЕсли;
	Если Дом.Полный И Согласованность Тогда
		ОкончаниеАдреса = ОкончаниеПоКонтактномуАдресу(Дом.Представление, ПоляАдреса.apartments);
		Если МуниципальнаяЦепочка.Полная Тогда
			Результат.МуниципальныйАдрес = ПредставлениеЦепочки(МуниципальнаяЦепочка.Узлы, ОкончаниеАдреса, УровниАдреса.area);
		КонецЕсли;
		Если АдминистративнаяЦепочка.Полная Тогда
			Результат.АдминистративныйАдрес = ПредставлениеЦепочки(АдминистративнаяЦепочка.Узлы, ОкончаниеАдреса, УровниАдреса.area);
		КонецЕсли;
	КонецЕсли;
	Если ИсходныеСтрокиПолные И МуниципальнаяЦепочка.Неоднозначная И АдминистративнаяЦепочка.Неоднозначная Тогда
		Результат.Статус = "AMBIGUOUS";
	ИначеЕсли (МуниципальнаяЦепочка.Полная Или АдминистративнаяЦепочка.Полная) И Дом.Полный И Согласованность И ИсходныеСтрокиПолные Тогда
		Результат.Статус = "FOUND";
	КонецЕсли;
	ЗаполнитьКодОКАТОАдреса(Результат);
		Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Числовые коды локального регистра дополняются ведущими нулями, строковые сохраняются.
Функция КодКлассификатораАдреса(ЗначениеКода, Классификатор)

	Если ТипЗнч(ЗначениеКода) = Тип("Число") Тогда
		Если ЗначениеКода <= 0 Или ЗначениеКода > 99999999999 Или Цел(ЗначениеКода) <> ЗначениеКода Тогда
			Возврат "";
		КонецЕсли;
		Код = Формат(ЗначениеКода, "ЧГ=0;ЧДЦ=0");
		Если Классификатор = "ОКАТО" Тогда
			Если СтрДлина(Код) <= 2 Тогда
				Длина = 2;
			ИначеЕсли СтрДлина(Код) <= 5 Тогда
				Длина = 5;
			ИначеЕсли СтрДлина(Код) <= 8 Тогда
				Длина = 8;
			Иначе
				Длина = 11;
			КонецЕсли;
		Иначе
			Длина = ?(СтрДлина(Код) > 8, 11, 8);
		КонецЕсли;
		Код = Прав("00000000000" + Код, Длина);
	ИначеЕсли ТипЗнч(ЗначениеКода) = Тип("Строка") Тогда
		Код = СокрЛП(ЗначениеКода);
	Иначе
		Возврат "";
	КонецЕсли;
	Длина = СтрДлина(Код);
	Если Длина <> 8 И Длина <> 11 И Не (Классификатор = "ОКАТО" И (Длина = 2 Или Длина = 5)) Тогда
		Возврат "";
	КонецЕсли;
	Для Позиция = 1 По Длина Цикл
		Если СтрНайти("0123456789", Сред(Код, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Код;

КонецФункции

// Дополняет КодОКАТО результата из единственной строки дополнительных сведений, иначе добавляет диагностику.
Процедура ЗаполнитьКодОКАТОАдреса(Результат)

	Если ПустаяСтрока(Результат.КодОКАТО) Тогда
		Если Результат.ДополнительныеАдресныеСведения.Количество() <> 1 Тогда
			Результат.Диагностика.Добавить(НСтр("ru='Локальный код ОКАТО отсутствует или неоднозначен.';en='The local OKATO code is missing or ambiguous.'"));
			Возврат;
		КонецЕсли;
		Результат.КодОКАТО = КодКлассификатораАдреса(Результат.ДополнительныеАдресныеСведения[0].OKATO, "ОКАТО");
	КонецЕсли;

КонецПроцедуры

// Возвращает совпадения адресного объекта или упакованного дома без выбора первого дубля.
Функция КандидатыАдресаПоФИАС(ИдентификаторФИАС)

	Кандидаты = Новый Массив;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Объекты.Идентификатор КАК ИдентификаторРодителя,
	|	Объекты.КодСубъектаРФ КАК КодСубъектаРФ,
	|	Объекты.ДополнительныеАдресныеСведения КАК ИдентификаторКодов
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК Объекты
	|ГДЕ
	|	Объекты.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторФИАС);
	СтрокиОбъекта = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаОбъекта Из СтрокиОбъекта Цикл
		Кандидат = Новый Структура("ИдентификаторРодителя, КодСубъектаРФ, ИдентификаторКодов, СтрокаДома");
		ЗаполнитьЗначенияСвойств(Кандидат, СтрокаОбъекта);
		Кандидат.СтрокаДома = "";
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;
	Если Кандидаты.Количество() > 0 Тогда
		Возврат Кандидаты;
	КонецЕсли;
	ПрефиксUUID = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(СтрЗаменить(Строка(ИдентификаторФИАС), "-", "")));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Дома.АдресныйОбъект КАК ИдентификаторРодителя,
	|	Дома.КодСубъектаРФ КАК КодСубъектаРФ,
	|	Дома.ДополнительныеАдресныеСведения КАК ИдентификаторКодов,
	|	Дома.Строения КАК Строения
	|ИЗ
	|	РегистрСведений.ДомаЗданияСтроения КАК Дома";
	Блоки = Запрос.Выполнить().Выбрать();
	Пока Блоки.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Блоки.Строения) Тогда
			Продолжить;
		КонецЕсли;
		ТекстБлока = Блоки.Строения.Получить();
		Если Не ЗначениеЗаполнено(ТекстБлока) Или СтрНайти(ТекстБлока, ПрефиксUUID) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДома Из СтрРазделить(ТекстБлока, Символы.ПС, Ложь) Цикл
			Если СтрСравнить(Лев(СтрокаДома, 24), ПрефиксUUID) = 0 Тогда
				Кандидат = Новый Структура("ИдентификаторРодителя, КодСубъектаРФ, ИдентификаторКодов, СтрокаДома");
				ЗаполнитьЗначенияСвойств(Кандидат, Блоки);
				Кандидат.СтрокаДома = СтрокаДома;
				Кандидаты.Добавить(Кандидат);
			КонецЕсли;
		КонецЦикла;
		Если Кандидаты.Количество() > 1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Разбирает части дома; повреждение локальных данных оставляет явную диагностику.
Функция СведенияОДоме(СтрокаДома, Диагностика)

	Дом = Новый Структура("Полный, Части, Представление", Истина, Новый Массив, "");
	Если ПустаяСтрока(СтрокаДома) Тогда
		Возврат Дом;
	КонецЕсли;
	Словари = АдресныйКлассификаторПовтИсп.НаименованияВладенийИСтроений();
	Поля = СтрРазделить(Сред(СтрокаДома, 25), Символы.Таб, Истина);
	ТекстовыеЧасти = Новый Массив;
	Для ИндексЧасти = 0 По Мин(2, Поля.Количество() - 1) Цикл
		Если ПустаяСтрока(Поля[ИндексЧасти]) Тогда
			Продолжить;
		КонецЕсли;
		ТипИНомер = СтрРазделить(Поля[ИндексЧасти], Символы.НПП, Истина);
		Если ТипИНомер.Количество() <> 2 Тогда
			Дом.Полный = Ложь;
			Диагностика.Добавить(НСтр("ru = 'Повреждена часть дома: ожидаются тип и номер.'; en = 'A house part is corrupt: a type and a number were expected.'"));
			Продолжить;
		КонецЕсли;
		Попытка
			КодТипа = Число(ТипИНомер[0]);
		Исключение
			Дом.Полный = Ложь;
			Диагностика.Добавить(НСтр("ru = 'Повреждена часть дома: тип не является числом.'; en = 'A house part is corrupt: its type code is not numeric.'"));
			Продолжить;
		КонецПопытки;
		НомерЧасти = СокрЛП(ТипИНомер[1]);
		Если ИндексЧасти = 0 Тогда
			НаименованиеТипа = Словари.Владения.Получить(КодТипа);
			Если ВРег(НомерЧасти) = "НЕТ" Тогда
				НомерЧасти = "";
			КонецЕсли;
		Иначе
			НаименованиеТипа = Словари.Строения.Получить(КодТипа);
		КонецЕсли;
		Если НаименованиеТипа = Неопределено Тогда
			Дом.Полный = Ложь;
			НаименованиеТипа = "";
			Диагностика.Добавить(НСтр("ru = 'В локальном словаре отсутствует тип части дома: '; en = 'The local dictionary has no house part type: '") + Строка(КодТипа));
		КонецЕсли;
		Дом.Части.Добавить(Новый Структура("Позиция, НаименованиеТипа, Номер", ИндексЧасти, НаименованиеТипа, НомерЧасти));
		Если Не ПустаяСтрока(НомерЧасти) Тогда
			ТекстовыеЧасти.Добавить(СокрЛП(НРег(НаименованиеТипа) + " " + НомерЧасти));
		КонецЕсли;
	КонецЦикла;
	Дом.Представление = СтрСоединить(ТекстовыеЧасти, ", ");
	Если ПустаяСтрока(Дом.Представление) Тогда
		Дом.Полный = Ложь;
		Диагностика.Добавить(НСтр("ru = 'UUID дома найден, но номера дома и строений отсутствуют.'; en = 'The house UUID was found, but the house and building numbers are missing.'"));
	КонецЕсли;
	Возврат Дом;

КонецФункции

// Читает замыкание родителей пакетами точных UUID. Кеш чтения не является проверкой циклов.
Функция ГрафАдреса(Кандидат, УровеньРегиона)

	ПустойUUID = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Граф = Новый Структура("Объекты, МуниципальныеРодители, АдминистративныеРодители",
		Новый Соответствие, Новый Соответствие, Новый Соответствие);
	ПрочитанныеОбъекты = Новый Соответствие;
	Фронт = Новый Массив;
	Фронт.Добавить(Кандидат.ИдентификаторРодителя);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Объекты.Идентификатор КАК Идентификатор,
	|	Объекты.Наименование КАК Наименование,
	|	Объекты.ТипОбъекта КАК ТипОбъекта,
	|	Объекты.Уровень КАК Уровень,
	|	ЕСТЬNULL(Коды.ОКТМО, 0) КАК ОКТМО
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК Объекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеАдресныеСведения КАК Коды
	|		ПО (Коды.Идентификатор = Объекты.ДополнительныеАдресныеСведения)
	|			И (Коды.КодСубъектаРФ = Объекты.КодСубъектаРФ)
	|ГДЕ
	|	Объекты.Идентификатор В(&Идентификаторы)
	|	И Объекты.КодСубъектаРФ = &КодСубъектаРФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связи.Идентификатор КАК Идентификатор,
	|	Связи.РодительскийИдентификатор КАК Родитель
	|ИЗ
	|	РегистрСведений.МуниципальнаяИерархия КАК Связи
	|ГДЕ
	|	Связи.Идентификатор В(&Идентификаторы)
	|	И Связи.КодСубъектаРФ = &КодСубъектаРФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Связи.Идентификатор КАК Идентификатор,
	|	Связи.РодительскийИдентификатор КАК Родитель
	|ИЗ
	|	РегистрСведений.АдминистративнаяИерархия КАК Связи
	|ГДЕ
	|	Связи.Идентификатор В(&Идентификаторы)
	|	И Связи.КодСубъектаРФ = &КодСубъектаРФ");
	Запрос.УстановитьПараметр("КодСубъектаРФ", Кандидат.КодСубъектаРФ);
	Пока Фронт.Количество() > 0 Цикл
		Запрос.УстановитьПараметр("Идентификаторы", Фронт);
		Пакет = Запрос.ВыполнитьПакет();
		Для Каждого Идентификатор Из Фронт Цикл
			ПрочитанныеОбъекты.Вставить(Идентификатор, Истина);
		КонецЦикла;
		Объекты = Пакет[0].Выгрузить();
		Для Каждого СтрокаОбъекта Из Объекты Цикл
			Узел = Новый Структура("Идентификатор, Наименование, ТипОбъекта, Уровень, ОКТМО");
			ЗаполнитьЗначенияСвойств(Узел, СтрокаОбъекта);
			Граф.Объекты.Вставить(Узел.Идентификатор, Узел);
		КонецЦикла;
		СледующийФронт = Новый Соответствие;
		Для ИндексИерархии = 1 По 2 Цикл
			Родители = ?(ИндексИерархии = 1, Граф.МуниципальныеРодители, Граф.АдминистративныеРодители);
			Связи = Пакет[ИндексИерархии].Выгрузить();
			Для Каждого Связь Из Связи Цикл
				Узел = Граф.Объекты.Получить(Связь.Идентификатор);
				Если Узел = Неопределено Или Узел.Уровень = УровеньРегиона Тогда
					Продолжить;
				КонецЕсли;
				СписокРодителей = Родители.Получить(Связь.Идентификатор);
				Если СписокРодителей = Неопределено Или СписокРодителей.Количество() = 0 Тогда
					СписокРодителей = Новый Массив;
					Родители.Вставить(Связь.Идентификатор, СписокРодителей);
				КонецЕсли;
				СписокРодителей.Добавить(Связь.Родитель);
				Если Связь.Родитель <> ПустойUUID И Не ПустаяСтрока(Узел.Наименование)
					И ПрочитанныеОбъекты.Получить(Связь.Родитель) = Неопределено Тогда
					СледующийФронт.Вставить(Связь.Родитель, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Фронт = Новый Массив;
		Для Каждого ЭлементФронта Из СледующийФронт Цикл
			Фронт.Добавить(ЭлементФронта.Ключ);
		КонецЦикла;
	КонецЦикла;
	Возврат Граф;

КонецФункции

// Обходит каждый путь в памяти. Пройденные UUID принадлежат только текущей ветви.
Функция ВетвиАдреса(Объекты, Родители, НачальныйUUID, УровеньРегиона, ВидИерархии, Диагностика)

	ПустойUUID = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Ветви = Новый Массив;
	Стек = Новый Массив;
	Стек.Добавить(Новый Структура("ТекущийUUID, Узлы, ПройденныеUUID", НачальныйUUID, Новый Массив, Новый Соответствие));
	Пока Стек.Количество() > 0 Цикл
		ИндексВетки = Стек.Количество() - 1;
		Ветка = Стек[ИндексВетки];
		Стек.Удалить(ИндексВетки);
		Причина = "";
		Полная = Ложь;
		Узел = Объекты.Получить(Ветка.ТекущийUUID);
		Если Ветка.ПройденныеUUID.Получить(Ветка.ТекущийUUID) <> Неопределено Тогда
			Причина = НСтр("ru = 'Цикл: повтор UUID в текущей ветви: '; en = 'Cycle: repeated UUID in the current path: '") + Строка(Ветка.ТекущийUUID);
		ИначеЕсли Узел = Неопределено Тогда
			Причина = НСтр("ru = 'Отсутствует адресный объект UUID: '; en = 'Missing address object UUID: '") + Строка(Ветка.ТекущийUUID);
		Иначе
			Ветка.ПройденныеUUID.Вставить(Ветка.ТекущийUUID, Истина);
			Ветка.Узлы.Вставить(0, Узел);
			Если ПустаяСтрока(Узел.Наименование) Тогда
				Причина = НСтр("ru = 'У адресного объекта отсутствует наименование, UUID: '; en = 'The address object has no name, UUID: '") + Строка(Узел.Идентификатор);
			ИначеЕсли Узел.Уровень = УровеньРегиона Тогда
				Полная = Истина;
			Иначе
				СписокРодителей = Родители.Получить(Ветка.ТекущийUUID);
				Если СписокРодителей = Неопределено Тогда
					Причина = НСтр("ru = 'Оборвана связь с родителем, UUID: '; en = 'The parent link is missing, UUID: '") + Строка(Ветка.ТекущийUUID);
				Иначе
					Для Каждого Родитель Из СписокРодителей Цикл
						Если Родитель = ПустойUUID Тогда
							Ветви.Добавить(Новый Структура("Полная, Узлы", Ложь, Ветка.Узлы));
							Диагностика.Добавить(ВидИерархии + ": "
								+ НСтр("ru = 'Пустой родитель, UUID объекта: '; en = 'Empty parent, object UUID: '") + Строка(Ветка.ТекущийUUID));
						Иначе
							НовыеУзлы = Новый Массив;
							Для Каждого ПройденныйУзел Из Ветка.Узлы Цикл
								НовыеУзлы.Добавить(ПройденныйУзел);
							КонецЦикла;
							НовыеUUID = Новый Соответствие;
							Для Каждого ПройденныйUUID Из Ветка.ПройденныеUUID Цикл
								НовыеUUID.Вставить(ПройденныйUUID.Ключ, Истина);
							КонецЦикла;
							Стек.Добавить(Новый Структура("ТекущийUUID, Узлы, ПройденныеUUID", Родитель, НовыеУзлы, НовыеUUID));
						КонецЕсли;
					КонецЦикла;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Ветви.Добавить(Новый Структура("Полная, Узлы", Полная, Ветка.Узлы));
		Если Не ПустаяСтрока(Причина) Тогда
			Диагностика.Добавить(ВидИерархии + ": " + Причина);
		КонецЕсли;
	КонецЦикла;
	Возврат Ветви;

КонецФункции

// Заполняет только штатные Представление/XML, без создания JSON-строки.
// Ошибка формата не отменяет доказанные полные текстовые пути.
Процедура ЗаполнитьШтатныйФорматАдресаПоФИАС(Результат, Цепочка, Кандидат, Дом, УровниАдреса)

	Попытка
		ТипАдреса = Перечисления.ТипыКонтактнойИнформации.Адрес;
		ДанныеАдреса = РаботаСАдресамиКлиентСервер.ОписаниеНовойКонтактнойИнформации(ТипАдреса);
		Страна = РаботаСАдресамиКлиентСервер.ОсновнаяСтрана();
		ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Страна, "Наименование, Код");
		Если Не ЗначениеЗаполнено(ДанныеСтраны.Наименование) Или Не ЗначениеЗаполнено(ДанныеСтраны.Код) Тогда
			ВызватьИсключение НСтр("ru = 'Не заполнена основная страна локального справочника.'; en = 'The main country is missing from the local directory.'");
		КонецЕсли;
		ДанныеАдреса.country = ДанныеСтраны.Наименование;
		ДанныеАдреса.countryCode = СокрЛП(ДанныеСтраны.Код);
		Если Цепочка.Муниципальная Тогда
			ДанныеАдреса.addressType = РаботаСАдресамиКлиентСервер.МуниципальныйАдрес();
			ПорядокУровней = ДанныеАдреса.munLevels;
		Иначе
			ДанныеАдреса.addressType = РаботаСАдресамиКлиентСервер.АдминистративноТерриториальныйАдрес();
			ПорядокУровней = ДанныеАдреса.admLevels;
		КонецЕсли;
		ИменаУровней = Новый Соответствие;
		Для Каждого Уровень Из УровниАдреса Цикл
			ИменаУровней.Вставить(Уровень.Значение, Уровень.Ключ);
		КонецЦикла;
		ЗаполненныеУровни = Новый Соответствие;
		Для Каждого Узел Из Цепочка.Узлы Цикл
			ИмяУровня = ИменаУровней.Получить(Узел.Уровень);
			Если ИмяУровня = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Полный путь найден, но его уровень не представлен в штатной структуре XML: '; en = 'The complete path was found, but its level is unsupported by the native XML structure: '") + Строка(Узел.Уровень);
			КонецЕсли;
			Если ЗаполненныеУровни.Получить(ИмяУровня) <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Полный путь найден, но разные узлы занимают одно поле штатной структуры XML: '; en = 'The complete path was found, but distinct nodes occupy the same native XML field: '") + ИмяУровня;
			КонецЕсли;
			ЗаполненныеУровни.Вставить(ИмяУровня, Истина);
			ДанныеАдреса[ИмяУровня] = Узел.Наименование;
			ДанныеАдреса[ИмяУровня + "Type"] = Узел.ТипОбъекта;
			ПорядокУровней.Добавить(ИмяУровня);
		КонецЦикла;
		ДанныеАдреса.areaCode = Формат(Кандидат.КодСубъектаРФ, "ЧГ=0");
		Если СтрДлина(ДанныеАдреса.areaCode) < 2 Тогда
			ДанныеАдреса.areaCode = "0" + ДанныеАдреса.areaCode;
		КонецЕсли;
		Для Каждого ЧастьДома Из Дом.Части Цикл
			Если ПустаяСтрока(ЧастьДома.Номер) Тогда
				Продолжить;
			КонецЕсли;
			ТипЧасти = ВРег(Лев(ЧастьДома.НаименованиеТипа, 1)) + Сред(НРег(ЧастьДома.НаименованиеТипа), 2);
			Если ЧастьДома.Позиция = 0 Тогда
				ДанныеАдреса.houseType = ТипЧасти;
				ДанныеАдреса.houseNumber = ЧастьДома.Номер;
			Иначе
				ДанныеАдреса.buildings.Добавить(УправлениеКонтактнойИнформациейКлиентСервер.ЗначениеСтроенияИлиПомещения(
					ТипЧасти, ЧастьДома.Номер));
			КонецЕсли;
		КонецЦикла;
		Если Результат.ДополнительныеАдресныеСведения.Количество() = 1 Тогда
			Коды = Результат.ДополнительныеАдресныеСведения[0];
			Если Коды.ПочтовыйИндекс > 0 Тогда
				ДанныеАдреса.ZIPcode = Формат(Коды.ПочтовыйИндекс, "ЧГ=0");
			КонецЕсли;
			Если Коды.ОКТМО > 0 Тогда
				КодОКТМО = Формат(Коды.ОКТМО, "ЧГ=0");
				Если СтрДлина(КодОКТМО) = 7 Или СтрДлина(КодОКТМО) = 10 Тогда
					КодОКТМО = "0" + КодОКТМО;
				КонецЕсли;
				ДанныеАдреса.oktmo = КодОКТМО;
			КонецЕсли;
		КонецЕсли;
		ДанныеАдреса.value = РаботаСАдресамиКлиентСервер.ПредставлениеАдреса(ДанныеАдреса, Ложь);
		СтрокаXML = "";
		УправлениеКонтактнойИнформациейЛокализация.ПриКонвертированииКонтактнуюИнформациюИзJSONВXML(
			ДанныеАдреса, СтрокаXML, ТипАдреса);
		Если ПустаяСтрока(ДанныеАдреса.value) Или ПустаяСтрока(СтрокаXML) Тогда
			ВызватьИсключение НСтр("ru = 'Штатное преобразование вернуло пустое представление или XML.'; en = 'The native conversion returned an empty representation or XML.'");
		КонецЕсли;
		Результат.Представление = СокрЛП(СтрЗаменить(ДанныеАдреса.value, Символы.ПС, " "));
		Результат.XML = СтрокаXML;
		Результат.Статус = "FOUND";
	Исключение
		Результат.Статус = "PARTIAL";
		Результат.Представление = "";
		Результат.XML = "";
		Результат.Диагностика.Добавить(НСтр("ru = 'Не удалось сформировать штатный формат адреса: '; en = 'Failed to generate the native address format: '") + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Выбирает единственный путь или доказанную муниципальную ветвь по ОКТМО дома.
Функция ВыбраннаяЦепочка(Ветви, Муниципальная, ОКТМОДома, УровниАдреса)

	Цепочка = Новый Структура("Полная, Неоднозначная, Узлы, Муниципальная", Ложь, Истина, Новый Массив, Муниципальная);
	ВыбраннаяВетка = Неопределено;
	Если Ветви.Количество() = 1 Тогда
		ВыбраннаяВетка = Ветви[0];
	ИначеЕсли Муниципальная И ОКТМОДома > 0 Тогда
		Совпавшие = Новый Массив;
		ЕстьНеисключеннаяВетка = Ложь;
		Для Каждого Ветка Из Ветви Цикл
			Совпадает = Ложь;
			ЕстьКод = Ложь;
			ЕстьНеизвестныйКод = Ложь;
			Для Каждого Узел Из Ветка.Узлы Цикл
				Если Узел.Уровень = УровниАдреса.munDistrict Или Узел.Уровень = УровниАдреса.settlement Тогда
					Если Узел.ОКТМО > 0 Тогда
						ЕстьКод = Истина;
						Совпадает = Совпадает Или Узел.ОКТМО = ОКТМОДома;
					Иначе
						ЕстьНеизвестныйКод = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Совпадает Тогда
				Совпавшие.Добавить(Ветка);
			ИначеЕсли Не Ветка.Полная Или Не ЕстьКод Или ЕстьНеизвестныйКод Тогда
				ЕстьНеисключеннаяВетка = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Совпавшие.Количество() = 1 И Не ЕстьНеисключеннаяВетка Тогда
			ВыбраннаяВетка = Совпавшие[0];
		КонецЕсли;
	КонецЕсли;
	Если ВыбраннаяВетка <> Неопределено Тогда
		Цепочка.Неоднозначная = Ложь;
		Цепочка.Полная = ВыбраннаяВетка.Полная;
		Цепочка.Узлы = ВыбраннаяВетка.Узлы;
	КонецЕсли;
	Возврат Цепочка;

КонецФункции

// Формирует текст только выбранного полного пути; все его узлы сохраняются.
Функция ПредставлениеЦепочки(Узлы, ПредставлениеДома, УровеньРегиона)

	Части = Новый Массив;
	Для Каждого Узел Из Узлы Цикл
		Части.Добавить(АдресныйКлассификаторСлужебный.СоединитьНаименованиеИТипАдресногоОбъекта(
			Узел.Наименование, Узел.ТипОбъекта, Узел.Уровень = УровеньРегиона));
	КонецЦикла;
	Если Не ПустаяСтрока(ПредставлениеДома) Тогда
		Части.Добавить(ПредставлениеДома);
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Проверяет структуру результата формы и строковые поля Значение, КонтактнаяИнформация, Представление; при нарушении вызывает исключение.
Процедура ПроверитьВходПоКонтактномуАдресу(ВыбранноеЗначение)

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидается структура результата формы ввода адреса.'; en = 'An address form result structure is required.'");
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("Значение,КонтактнаяИнформация,Представление", ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Не ВыбранноеЗначение.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			ВызватьИсключение НСтр("ru = 'Отсутствует обязательное свойство результата формы: '; en = 'A required form result property is missing: '") + ИмяПоля;
		КонецЕсли;
		Если ТипЗнч(ЗначениеПоля) <> Тип("Строка") Тогда
			ВызватьИсключение НСтр("ru = 'Обязательное свойство результата формы должно быть строкой: '; en = 'A required form result property must be a string: '") + ИмяПоля;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Разбирает JSON один раз. Ошибки содержимого не выводятся в журнал или интерфейс.
Функция ПоляПоКонтактномуАдресу(СтрокаJSON, Диагностика)

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(СтрокаJSON);
		ИсходныеПоля = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		Диагностика.Добавить(НСтр("ru = 'Значение формы не содержит корректный JSON адреса.'; en = 'The form value is not valid address JSON.'"));
		Возврат Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(ИсходныеПоля) <> Тип("Структура") Тогда
		Диагностика.Добавить(НСтр("ru = 'Корень JSON адреса должен быть объектом.'; en = 'The address JSON root must be an object.'"));
		Возврат Неопределено;
	КонецЕсли;
	Поля = РаботаСАдресамиКлиентСервер.ОписаниеНовойКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Адрес);
	Поля.Вставить("КодОКТМО", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИсходныеПоля, "oktmo", ""));
	Поля.Вставить("КодОКАТО", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИсходныеПоля, "okato", ""));
	Корректно = Истина;
	СтроковыеПоля = "id,areaId,districtId,munDistrictId,cityId,settlementId,cityDistrictId,territoryId,localityId,streetId,houseId,steadId,houseType,houseNumber,munDistrict,stead,addressType";
	Для Каждого ИмяПоля Из СтрРазделить(СтроковыеПоля, ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Не ИсходныеПоля.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЗначениеПоля) <> Тип("Строка") Тогда
			Корректно = Ложь;
			Диагностика.Добавить(НСтр("ru = 'Поле JSON должно быть строкой: '; en = 'A JSON field must be a string: '") + ИмяПоля);
			Продолжить;
		КонецЕсли;
		Если Прав(ИмяПоля, 2) = "Id" Или ИмяПоля = "id" Тогда
			Поля[ИмяПоля] = UUIDПоКонтактномуАдресу(ЗначениеПоля, ИмяПоля, Корректно, Диагностика);
		Иначе
			Поля[ИмяПоля] = ЗначениеПоля;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяПоля Из СтрРазделить("areaCode,oktmo", ",") Цикл
		ЗначениеПоля = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИсходныеПоля, ИмяПоля, "");
		Поля[ИмяПоля] = КодПоКонтактномуАдресу(ЗначениеПоля, ИмяПоля, Корректно, Диагностика);
	КонецЦикла;
	//Для Каждого ИмяПоля Из СтрРазделить("areaCode,oktmo", ",") Цикл
	//	ЗначениеПоля = "";
	//	ИсходныеПоля.Свойство(ИмяПоля, ЗначениеПоля);
	//	Поля[ИмяПоля] = КодПоКонтактномуАдресу(ЗначениеПоля, ИмяПоля, Корректно, Диагностика);
	//КонецЦикла;
	Для Каждого ИмяПоля Из СтрРазделить("buildings,apartments,admLevels,munLevels", ",") Цикл
		Если Не ИсходныеПоля.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЗначениеПоля) <> Тип("Массив") Тогда
			Корректно = Ложь;
		Иначе
			Для Каждого Элемент Из ЗначениеПоля Цикл
				ТипЧасти = Неопределено;
				НомерЧасти = Неопределено;
				Если ИмяПоля = "admLevels" Или ИмяПоля = "munLevels" Тогда
					Если ТипЗнч(Элемент) = Тип("Строка") Тогда
						Поля[ИмяПоля].Добавить(Элемент);
					Иначе
						Корректно = Ложь;
					КонецЕсли;
				ИначеЕсли ТипЗнч(Элемент) <> Тип("Структура") Тогда
					Корректно = Ложь;
				ИначеЕсли Не Элемент.Свойство("type", ТипЧасти) Или Не Элемент.Свойство("number", НомерЧасти) Тогда
					Корректно = Ложь;
				ИначеЕсли ТипЗнч(ТипЧасти) <> Тип("Строка") Или ТипЗнч(НомерЧасти) <> Тип("Строка") Тогда
					Корректно = Ложь;
				ИначеЕсли ПустаяСтрока(ТипЧасти) Или ПустаяСтрока(НомерЧасти) Тогда
					Корректно = Ложь;
				Иначе
					Поля[ИмяПоля].Добавить(Новый Структура("type,number", ТипЧасти, НомерЧасти));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Не Корректно Тогда
		Диагностика.Добавить(НСтр("ru = 'Некорректны типы или состав полей JSON адреса, строений либо помещений.'; en = 'The address JSON, buildings or premises have invalid field types or contents.'"));
		Возврат Неопределено;
	КонецЕсли;
	Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоАдресВСвободнойФорме(Поля.addressType) Тогда
		Диагностика.Добавить(НСтр("ru = 'JSON содержит адрес в свободной форме: поиск UUID по тексту не выполняется.'; en = 'The JSON contains a free-form address: UUID lookup by text is not performed.'"));
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(Поля.steadId) Или Не ПустаяСтрока(Поля.stead)
		Или СтрНайти(ВРег(Поля.houseType), "МАШИНО") > 0 Тогда
		Диагностика.Добавить(НСтр("ru = 'Определение UUID участка или машино-места не поддерживается.'; en = 'Land plot and parking space UUID lookup is not supported.'"));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Поля;

КонецФункции

// Разбирает UUID из поля JSON; пустое значение возвращает пустой строкой. При неверном UUID меняет Корректно на Ложь и дополняет Диагностика.
Функция UUIDПоКонтактномуАдресу(ЗначениеUUID, ИмяПоля, Корректно, Диагностика)

	Если ПустаяСтрока(ЗначениеUUID) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		UUID = Новый УникальныйИдентификатор(СокрЛП(ЗначениеUUID));
	Исключение
		Корректно = Ложь;
		Диагностика.Добавить(НСтр("ru = 'Некорректный UUID в поле JSON: '; en = 'Invalid UUID in JSON field: '") + ИмяПоля);
		Возврат "";
	КонецПопытки;
	Если UUID = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
		Возврат "";
	КонецЕсли;
	Возврат UUID;

КонецФункции

// Пустой код региона отличается от заданного нуля; коды должны быть целыми десятичными.
Функция КодПоКонтактномуАдресу(ЗначениеКода, ИмяПоля, Корректно, Диагностика)

	НеверныйКод = Ложь;
	Если ТипЗнч(ЗначениеКода) = Тип("Строка") Тогда
		ТекстКода = СокрЛП(ЗначениеКода);
		Если ПустаяСтрока(ТекстКода) Тогда
			Возврат ?(ИмяПоля = "areaCode", Неопределено, 0);
		КонецЕсли;
		Для Позиция = 1 По СтрДлина(ТекстКода) Цикл
			Если СтрНайти("0123456789", Сред(ТекстКода, Позиция, 1)) = 0 Тогда
				НеверныйКод = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не НеверныйКод Тогда
			Попытка
				Код = Число(ТекстКода);
			Исключение
				НеверныйКод = Истина;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЗначениеКода) = Тип("Число") Тогда
		Код = ЗначениеКода;
	Иначе
		НеверныйКод = Истина;
	КонецЕсли;
	Если Не НеверныйКод Тогда
		НеверныйКод = Код < 0 Или Код <> Цел(Код) Или (ИмяПоля = "areaCode" И Код = 0);
	КонецЕсли;
	Если НеверныйКод Тогда
		Корректно = Ложь;
		Диагностика.Добавить(НСтр("ru = 'Некорректный числовой код в поле JSON: '; en = 'Invalid numeric code in JSON field: '") + ИмяПоля);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Код;

КонецФункции

// Читает локальные адресные объекты по UUID и коду региона; возвращает таблицу кандидатов без выбора первого совпадения.
Функция ОбъектыПоКонтактномуАдресу(РодительUUID, КодРегиона)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Объекты.Идентификатор КАК ИдентификаторРодителя,
	|	Объекты.КодСубъектаРФ КАК КодСубъектаРФ,
	|	Объекты.ДополнительныеАдресныеСведения КАК ИдентификаторКодов
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК Объекты
	|ГДЕ
	|	Объекты.Идентификатор = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", РодительUUID);
	Если КодРегиона <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " И Объекты.КодСубъектаРФ = &КодСубъектаРФ";
		Запрос.УстановитьПараметр("КодСубъектаРФ", КодРегиона);
	КонецЕсли;
	Кандидаты = Новый Массив;
	Для Каждого СтрокаОбъекта Из Запрос.Выполнить().Выгрузить() Цикл
		Кандидат = Новый Структура("ИдентификаторРодителя,КодСубъектаРФ,ИдентификаторКодов,СтрокаДома", РодительUUID, 0, Неопределено, "");
		ЗаполнитьЗначенияСвойств(Кандидат, СтрокаОбъекта);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Распаковывает только блоки указанного родителя и региона, проверяя точный UUID.
Функция ДомаПоКонтактномуАдресу(UUIDДома, Родитель)

	ПрефиксUUID = Base64Строка(ПолучитьДвоичныеДанныеИзHexСтроки(СтрЗаменить(Строка(UUIDДома), "-", "")));
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Дома.ДополнительныеАдресныеСведения КАК ИдентификаторКодов,
	|	Дома.Строения КАК Строения
	|ИЗ
	|	РегистрСведений.ДомаЗданияСтроения КАК Дома
	|ГДЕ
	|	Дома.АдресныйОбъект = &ИдентификаторРодителя
	|	И Дома.КодСубъектаРФ = &КодСубъектаРФ");
	Запрос.УстановитьПараметр("ИдентификаторРодителя", Родитель.ИдентификаторРодителя);
	Запрос.УстановитьПараметр("КодСубъектаРФ", Родитель.КодСубъектаРФ);
	Блоки = Запрос.Выполнить().Выбрать();
	Кандидаты = Новый Массив;
	Пока Блоки.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Блоки.Строения) Тогда
			Продолжить;
		КонецЕсли;
		ТекстБлока = Блоки.Строения.Получить();
		Если Не ЗначениеЗаполнено(ТекстБлока) Или СтрНайти(ТекстБлока, ПрефиксUUID) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДома Из СтрРазделить(ТекстБлока, Символы.ПС, Ложь) Цикл
			Если СтрСравнить(Лев(СтрокаДома, 24), ПрефиксUUID) = 0 Тогда
				Кандидаты.Добавить(Новый Структура("ИдентификаторРодителя,КодСубъектаРФ,ИдентификаторКодов,СтрокаДома",
					Родитель.ИдентификаторРодителя, Родитель.КодСубъектаРФ, Блоки.ИдентификаторКодов, СтрокаДома));
			КонецЕсли;
		КонецЦикла;
		Если Кандидаты.Количество() > 1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Сравнивает части локального дома с JSON формы; возвращает признак согласованности и дополняет Диагностика при расхождении.
Функция СогласованДомПоКонтактномуАдресу(Дом, ПоляАдреса, Диагностика)

	ОжидаемыеЧасти = Новый Массив;
	Если Не ПустаяСтрока(ПоляАдреса.houseNumber) Тогда
		ОжидаемыеЧасти.Добавить(Новый Структура("type,number", ПоляАдреса.houseType, ПоляАдреса.houseNumber));
	КонецЕсли;
	Для Каждого Строение Из ПоляАдреса.buildings Цикл
		ОжидаемыеЧасти.Добавить(Строение);
	КонецЦикла;
	ЛокальныеЧасти = Новый Массив;
	Для Каждого Часть Из Дом.Части Цикл
		Если Не ПустаяСтрока(Часть.Номер) Тогда
			ЛокальныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Совпадает = Дом.Полный И ОжидаемыеЧасти.Количество() = ЛокальныеЧасти.Количество();
	Если Совпадает Тогда
		Для Индекс = 0 По ОжидаемыеЧасти.Количество() - 1 Цикл
			Ожидаемая = ОжидаемыеЧасти[Индекс];
			Локальная = ЛокальныеЧасти[Индекс];
			Если НРег(СокрЛП(Ожидаемая.type)) <> НРег(СокрЛП(Локальная.НаименованиеТипа))
				Или НРег(СокрЛП(Ожидаемая.number)) <> НРег(СокрЛП(Локальная.Номер)) Тогда
				Совпадает = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не Совпадает Тогда
		Диагностика.Добавить(НСтр("ru = 'Части дома из формы не совпадают с полными локальными данными выбранного UUID.'; en = 'The form house parts do not match the complete local data of the selected UUID.'"));
	КонецЕсли;
	Возврат Совпадает;

КонецФункции

// Исключает только доказанно другие полные муниципальные пути.
Функция ВетвиМуниципалитетаПоКонтактномуАдресу(Ветви, UUIDРайона, УровеньРайона, Согласованность, Диагностика)

	Если Не ЗначениеЗаполнено(UUIDРайона) Тогда
		Возврат Ветви;
	КонецЕсли;
	ПодходящиеВетви = Новый Массив;
	Для Каждого Ветка Из Ветви Цикл
		Районы = Новый Массив;
		Для Каждого Узел Из Ветка.Узлы Цикл
			Если Узел.Уровень = УровеньРайона Тогда
				Районы.Добавить(Узел.Идентификатор);
			КонецЕсли;
		КонецЦикла;
		Если Не Ветка.Полная Или Районы.Количество() <> 1 Тогда
			ПодходящиеВетви.Добавить(Ветка);
		ИначеЕсли Районы[0] = UUIDРайона Тогда
			ПодходящиеВетви.Добавить(Ветка);
		КонецЕсли;
	КонецЦикла;
	Если ПодходящиеВетви.Количество() = 0 Тогда
		Согласованность = Ложь;
		Диагностика.Добавить(НСтр("ru = 'UUID муниципального района формы противоречит полным локальным путям.'; en = 'The form municipal district UUID conflicts with the complete local paths.'"));
		Возврат Ветви;
	КонецЕсли;
	Возврат ПодходящиеВетви;

КонецФункции

// Присоединяет к представлению дома помещения из JSON и возвращает строку окончания адреса.
Функция ОкончаниеПоКонтактномуАдресу(ПредставлениеДома, Помещения)

	Части = Новый Массив;
	Если Не ПустаяСтрока(ПредставлениеДома) Тогда
		Части.Добавить(ПредставлениеДома);
	КонецЕсли;
	Для Каждого Помещение Из Помещения Цикл
		Части.Добавить(СокрЛП(НРег(Помещение.type)) + " " + СокрЛП(Помещение.number));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#КонецЕсли
