// Функция - Таблица формы.
//
// Параметры:
//  Элемент -
//
// Возвращаемое значение:
//   - ТаблицаФормы.
//
Функция ТаблицаФормы(Знач Элемент) Экспорт

	Пока ТипЗнч(Элемент) <> Тип("ТаблицаФормы") Цикл Элемент = Элемент.Родитель; КонецЦикла;
	Возврат Элемент;

