// ZIP/DEFLATE в памяти. Форматы: PKWARE APPNOTE 6.3.10, RFC 1951.
// Результат чтения принадлежит вызывающему коду; входные данные не изменяются.
#Область ПрограммныйИнтерфейс
// Читает ZIP целиком, проверяет все записи и возвращает их двоичные данные.
// Параметры:
//  Данные - ДвоичныеДанные - ZIP без префикса/самораспаковывающейся оболочки.
//  ПределАрхива - Число - целое 22..16777216, предел входных байтов.
//  ПределДанных - Число - целое 0..67108864, общий и построчный предел распаковки.
//  ПределЗаписей - Число - целое 0..1000, включая записи каталогов.
// Возвращаемое значение:
//  Структура - Элементы: Массив структур ПолноеИмя, РазмерНесжатого, Данные.
//   Имена относительные, разделитель /; каталог обозначается завершающим /.
//   Данные - ДвоичныеДанные, независимые от входного буфера.
// Ошибки: исключение при нарушении формата/лимита. ZIP64, шифрование, несколько
// дисков, методы кроме STORE/DEFLATE и не-ASCII имена без UTF-8 флага не поддерживаются.
// UTF-8 проверяется обратным кодированием. Дубликаты, включая регистровые, запрещены.
Функция Прочитать(Данные, ПределАрхива = 16777216, ПределДанных = 67108864, ПределЗаписей = 1000) Экспорт
	ПроверитьПредел(ПределАрхива, 22, 16777216);
	ПроверитьПредел(ПределДанных, 0, 67108864);
	ПроверитьПредел(ПределЗаписей, 0, 1000);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ОшибкаZIP();
	КонецЕсли;
	Если Данные.Размер() > ПределАрхива Или Данные.Размер() < 22 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Записи = НайтиЗаписиАрхива(Буфер, ПределДанных, ПределЗаписей);
	Элементы = Новый Массив;
	ТаблицаCRC = ТаблицаCRC32();
	Всего = 0;
	Для Каждого Запись Из Записи Цикл
		Если Запись.РазмерНесжатого > ПределДанных - Всего Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если Запись.Метод = 0 Тогда
			Выход = КопияБайтов(Буфер, Запись.НачалоДанных, Запись.РазмерНесжатого);
		Иначе
			Выход = Распаковать(Буфер, Запись.НачалоДанных, Запись.Сжато, Запись.РазмерНесжатого);
		КонецЕсли;
		Если CRC32(Выход, ТаблицаCRC) <> Запись.Контроль Тогда
			ОшибкаZIP();
		КонецЕсли;
		Всего = Всего + Выход.Размер;
		Элементы.Добавить(Новый Структура("ПолноеИмя,РазмерНесжатого,Данные", Запись.ПолноеИмя, Выход.Размер, ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Выход)));
	КонецЦикла;
	Возврат Новый Структура("Элементы", Элементы);
КонецФункции

// Создаёт ZIP STORE с UTF-8 именами и датой 01.01.1980, без изменения входа.
// Параметры:
//  Элементы - Массив из Структура - ПолноеИмя (Строка), Данные (ДвоичныеДанные).
//   До 1000 записей, каждая до 64 МиБ; выход с заголовками до 128 МиБ.
// Возвращаемое значение:
//  ДвоичныеДанные - завершённый ZIP. Пустой массив создаёт пустой архив.
// Ошибки: исключение при неверном имени, дубликате, типе или превышении лимита.
// Вызывающий код владеет входным массивом и возвращёнными данными; модуль их не сохраняет.
Функция Сформировать(Элементы) Экспорт
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		ОшибкаZIP();
	КонецЕсли;
	Если Элементы.Количество() > 1000 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Имена = Новый Соответствие;
	План = Новый Массив;
	РазмерВыхода = 22;
	Для Каждого Элемент Из Элементы Цикл
		ПроверитьИмя(Элемент.ПолноеИмя, Имена);
		Если ТипЗнч(Элемент.Данные) <> Тип("ДвоичныеДанные") Тогда
			ОшибкаZIP();
		КонецЕсли;
		Размер = Элемент.Данные.Размер();
		Если Размер > 67108864 Или (Прав(Элемент.ПолноеИмя, 1) = "/" И Размер <> 0) Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если СтрДлина(Элемент.ПолноеИмя) > 65535 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Имя = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(Элемент.ПолноеИмя, КодировкаТекста.UTF8, Ложь));
		Если Имя.Размер > 65535 Тогда
			ОшибкаZIP();
		КонецЕсли;
		РазмерВыхода = РазмерВыхода + 76 + 2 * Имя.Размер + Размер;
		Если РазмерВыхода > 134217728 Тогда
			ОшибкаZIP();
		КонецЕсли;
		План.Добавить(Новый Структура("Источник,Имя,Размер,Смещение,Контроль", Элемент.Данные, Имя, Размер, 0, 0));
	КонецЦикла;
	Выход = Новый БуферДвоичныхДанных(РазмерВыхода);
	Позиция = 0;
	ТаблицаCRC = ТаблицаCRC32();
	Для Каждого Запись Из План Цикл
		Данные = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Запись.Источник);
		Запись.Смещение = Позиция;
		Запись.Контроль = CRC32(Данные, ТаблицаCRC);
		ЗаписатьLE(Выход, Позиция, 67324752, 4);
		ЗаписатьLE(Выход, Позиция, 20, 2);
		ЗаписатьLE(Выход, Позиция, 2048, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 33, 2);
		ЗаписатьLE(Выход, Позиция, Запись.Контроль, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Размер, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Размер, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Имя.Размер, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ПеренестиБайты(Выход, Позиция, Запись.Имя);
		ПеренестиБайты(Выход, Позиция, Данные);
	КонецЦикла;
	НачалоКаталога = Позиция;
	Для Каждого Запись Из План Цикл
		ЗаписатьLE(Выход, Позиция, 33639248, 4);
		ЗаписатьLE(Выход, Позиция, 20, 2);
		ЗаписатьLE(Выход, Позиция, 20, 2);
		ЗаписатьLE(Выход, Позиция, 2048, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 33, 2);
		ЗаписатьLE(Выход, Позиция, Запись.Контроль, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Размер, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Размер, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Имя.Размер, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 2);
		ЗаписатьLE(Выход, Позиция, 0, 4);
		ЗаписатьLE(Выход, Позиция, Запись.Смещение, 4);
		ПеренестиБайты(Выход, Позиция, Запись.Имя);
	КонецЦикла;
	РазмерКаталога = Позиция - НачалоКаталога;
	ЗаписатьLE(Выход, Позиция, 101010256, 4);
	ЗаписатьLE(Выход, Позиция, 0, 2);
	ЗаписатьLE(Выход, Позиция, 0, 2);
	ЗаписатьLE(Выход, Позиция, План.Количество(), 2);
	ЗаписатьLE(Выход, Позиция, План.Количество(), 2);
	ЗаписатьLE(Выход, Позиция, РазмерКаталога, 4);
	ЗаписатьLE(Выход, Позиция, НачалоКаталога, 4);
	ЗаписатьLE(Выход, Позиция, 0, 2);
	Если Позиция <> РазмерВыхода Тогда
		ОшибкаZIP();
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Выход);
КонецФункции

#КонецОбласти
#Область СлужебныеПроцедурыИФункции
Процедура ОшибкаZIP(Причина = "")
	ВызватьИсключение НСтр("ru = 'ZIP: поврежденный архив или превышен предел памяти.'") + " " + Причина;
КонецПроцедуры

Процедура ПроверитьПредел(Значение, Минимум, Максимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ОшибкаZIP();
	КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда
		ОшибкаZIP();
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьГраницы(Буфер, Начало, Размер)
	Если Начало < 0 Или Размер < 0 Или Начало + Размер > Буфер.Размер Тогда
		ОшибкаZIP();
	КонецЕсли;
КонецПроцедуры

Функция ЧислоLE(Буфер, Начало, Размер)
	ПроверитьГраницы(Буфер, Начало, Размер);
	Результат = 0;
	Множитель = 1;
	Для Индекс = 0 По Размер - 1 Цикл
		Результат = Результат + Буфер.Получить(Начало + Индекс) * Множитель;
		Множитель = Множитель * 256;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьLE(Буфер, Позиция, Знач Значение, Знач Размер)
	Для Индекс = 1 По Размер Цикл
		Буфер.Установить(Позиция, Значение % 256);
		Позиция = Позиция + 1;
		Значение = Цел(Значение / 256);
	КонецЦикла;
КонецПроцедуры

Процедура ПеренестиБайты(Выход, Позиция, Источник)
	Для Индекс = 0 По Источник.Размер - 1 Цикл
		Выход.Установить(Позиция, Источник.Получить(Индекс));
		Позиция = Позиция + 1;
	КонецЦикла;
КонецПроцедуры

Функция КопияБайтов(Буфер, Начало, Размер)
	ПроверитьГраницы(Буфер, Начало, Размер);
	Выход = Новый БуферДвоичныхДанных(Размер);
	Для Индекс = 0 По Размер - 1 Цикл
		Выход.Установить(Индекс, Буфер.Получить(Начало + Индекс));
	КонецЦикла;
	Возврат Выход;
КонецФункции

Функция НайтиЗаписиАрхива(Буфер, ПределДанных, ПределЗаписей)
	Причина = Неопределено;
	Позиция = Буфер.Размер - 22;
	Минимум = Макс(0, Позиция - 65535);
	Пока Позиция >= Минимум Цикл
		Если КандидатКонцаКаталога(Буфер, Позиция) Тогда
			Попытка
				// Только metadata: ошибочная сигнатура в комментарии не прерывает поиск.
				Возврат ЗаписиАрхива(Буфер, Позиция, ПределДанных, ПределЗаписей);
			Исключение
				Причина = ИнформацияОбОшибке();
				// Продолжаем ограниченный поиск; выходные данные ещё не выделялись.
			КонецПопытки;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	// Если ни один кандидат не принят, сохраняем причину отказа подходящего EOCD.
	Если Причина <> Неопределено Тогда
		ВызватьИсключение(Причина.Описание,,,, Причина);
	КонецЕсли;
	ОшибкаZIP();
КонецФункции

// Проверяет metadata без декомпрессии; список используется после выбора EOCD.
Функция ЗаписиАрхива(Буфер, КонецКаталога, ПределДанных, ПределЗаписей)
	Если ЧислоLE(Буфер, КонецКаталога + 4, 2) <> 0 Или ЧислоLE(Буфер, КонецКаталога + 6, 2) <> 0 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Количество = ЧислоLE(Буфер, КонецКаталога + 10, 2);
	Если Количество = 65535 Или Количество > ПределЗаписей Или ЧислоLE(Буфер, КонецКаталога + 8, 2) <> Количество Тогда
		ОшибкаZIP();
	КонецЕсли;
	РазмерКаталога = ЧислоLE(Буфер, КонецКаталога + 12, 4);
	НачалоКаталога = ЧислоLE(Буфер, КонецКаталога + 16, 4);
	Если НачалоКаталога + РазмерКаталога <> КонецКаталога Тогда
		ОшибкаZIP();
	КонецЕсли;
	Записи = Новый Массив;
	Имена = Новый Соответствие;
	Позиция = НачалоКаталога;
	Всего = 0;
	Занято = 0;
	Для Индекс = 1 По Количество Цикл
		ПроверитьГраницы(Буфер, Позиция, 46);
		Если Позиция + 46 > КонецКаталога Или ЧислоLE(Буфер, Позиция, 4) <> 33639248 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Версия = ЧислоLE(Буфер, Позиция + 6, 2);
		Флаги = ЧислоLE(Буфер, Позиция + 8, 2);
		Метод = ЧислоLE(Буфер, Позиция + 10, 2);
		// Поддерживаются только deflate-options, descriptor и UTF-8.
		Если Версия > 20 Или Флаги % 2 <> 0 Или Цел(Флаги / 16) % 128 <> 0 Или Цел(Флаги / 4096) <> 0 Тогда
			ОшибкаZIP(НСтр("ru = 'ZIP64, шифрование и расширенные флаги не поддерживаются.'"));
		КонецЕсли;
		Если Метод <> 0 И Метод <> 8 Тогда
			ОшибкаZIP(НСтр("ru = 'Поддерживаются только STORE и DEFLATE.'"));
		КонецЕсли;
		Если Метод = 0 И Цел(Флаги / 2) % 4 <> 0 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Контроль = ЧислоLE(Буфер, Позиция + 16, 4);
		Сжато = ЧислоLE(Буфер, Позиция + 20, 4);
		Размер = ЧислоLE(Буфер, Позиция + 24, 4);
		ДлинаИмени = ЧислоLE(Буфер, Позиция + 28, 2);
		ДлинаДополнения = ЧислоLE(Буфер, Позиция + 30, 2);
		ДлинаКомментария = ЧислоLE(Буфер, Позиция + 32, 2);
		Смещение = ЧислоLE(Буфер, Позиция + 42, 4);
		Если ЧислоLE(Буфер, Позиция + 34, 2) <> 0 Или Сжато = 4294967295 Или Размер = 4294967295 Или Смещение = 4294967295 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Следующая = Позиция + 46 + ДлинаИмени + ДлинаДополнения + ДлинаКомментария;
		Если Следующая > КонецКаталога Тогда
			ОшибкаZIP();
		КонецЕсли;
		ПроверитьДополнение(Буфер, Позиция + 46 + ДлинаИмени, ДлинаДополнения);
		Имя = ПрочитатьИмя(Буфер, Позиция + 46, ДлинаИмени, Флаги);
		ПроверитьИмя(Имя, Имена);
		Если Прав(Имя, 1) = "/" И Размер <> 0 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если Размер > ПределДанных - Всего Тогда
			ОшибкаZIP(НСтр("ru = 'Распакованные данные превышают установленный предел.'"));
		КонецЕсли;
		Всего = Всего + Размер;
		Если Метод = 0 И Сжато <> Размер Тогда
			ОшибкаZIP();
		КонецЕсли;
		ПроверитьГраницы(Буфер, Смещение, 30);
		Если Смещение + 30 > НачалоКаталога Или ЧислоLE(Буфер, Смещение, 4) <> 67324752 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если ЧислоLE(Буфер, Смещение + 4, 2) <> Версия Или ЧислоLE(Буфер, Смещение + 6, 2) <> Флаги Или ЧислоLE(Буфер, Смещение + 8, 2) <> Метод Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если ЧислоLE(Буфер, Смещение + 10, 4) <> ЧислоLE(Буфер, Позиция + 12, 4) Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если ЧислоLE(Буфер, Смещение + 26, 2) <> ДлинаИмени Тогда
			ОшибкаZIP();
		КонецЕсли;
		ЛокальноеДополнение = ЧислоLE(Буфер, Смещение + 28, 2);
		НачалоДанных = Смещение + 30 + ДлинаИмени + ЛокальноеДополнение;
		КонецДанных = НачалоДанных + Сжато;
		Если КонецДанных > НачалоКаталога Тогда
			ОшибкаZIP();
		КонецЕсли;
		Для БайтИмени = 0 По ДлинаИмени - 1 Цикл
			Если Буфер.Получить(Смещение + 30 + БайтИмени) <> Буфер.Получить(Позиция + 46 + БайтИмени) Тогда
				ОшибкаZIP();
			КонецЕсли;
		КонецЦикла;
		ПроверитьДополнение(Буфер, Смещение + 30 + ДлинаИмени, ЛокальноеДополнение);
		Дескриптор = Цел(Флаги / 8) % 2 = 1;
		ЛокальныйCRC = ЧислоLE(Буфер, Смещение + 14, 4);
		ЛокальноСжато = ЧислоLE(Буфер, Смещение + 18, 4);
		ЛокальныйРазмер = ЧислоLE(Буфер, Смещение + 22, 4);
		Если Дескриптор Тогда
			Если ЛокальныйCRC <> 0 Или ЛокальноСжато <> 0 Или ЛокальныйРазмер <> 0 Тогда
				ОшибкаZIP();
			КонецЕсли;
			КонецЗаписи = КонецДанных + ДлинаДескриптора(Буфер, КонецДанных, НачалоКаталога, Контроль, Сжато, Размер);
		Иначе
			Если ЛокальныйCRC <> Контроль Или ЛокальноСжато <> Сжато Или ЛокальныйРазмер <> Размер Тогда
				ОшибкаZIP();
			КонецЕсли;
			КонецЗаписи = КонецДанных;
		КонецЕсли;
		Для Каждого Прежняя Из Записи Цикл
			Если Смещение < Прежняя.КонецЗаписи И КонецЗаписи > Прежняя.Смещение Тогда
				ОшибкаZIP();
			КонецЕсли;
		КонецЦикла;
		Занято = Занято + КонецЗаписи - Смещение;
		Записи.Добавить(Новый Структура("ПолноеИмя,РазмерНесжатого,Сжато,Метод,Контроль,НачалоДанных,Смещение,КонецЗаписи", Имя, Размер, Сжато, Метод, Контроль, НачалоДанных, Смещение, КонецЗаписи));
		Позиция = Следующая;
	КонецЦикла;
	// Запрещаем скрытые локальные записи, префикс, дыры и хвост до каталога.
	Если Позиция <> КонецКаталога Или Занято <> НачалоКаталога Тогда
		ОшибкаZIP();
	КонецЕсли;
	Возврат Записи;
КонецФункции

// Сигнатура в ZIP-комментарии может выглядеть как EOCD. Проверяем кандидат
// до его выбора: все диски/счётчики/границы и непрерывную цепочку central headers.
// Только чтение, без выделения записей/выходных буферов; не более 1000 заголовков.
Функция КандидатКонцаКаталога(Буфер, Позиция)
	Если ЧислоLE(Буфер, Позиция, 4) <> 101010256 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Позиция + 22 + ЧислоLE(Буфер, Позиция + 20, 2) <> Буфер.Размер Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЧислоLE(Буфер, Позиция + 4, 2) <> 0 Или ЧислоLE(Буфер, Позиция + 6, 2) <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Количество = ЧислоLE(Буфер, Позиция + 10, 2);
	Если Количество > 1000 Или ЧислоLE(Буфер, Позиция + 8, 2) <> Количество Тогда
		Возврат Ложь;
	КонецЕсли;
	Размер = ЧислоLE(Буфер, Позиция + 12, 4);
	Начало = ЧислоLE(Буфер, Позиция + 16, 4);
	Если Начало + Размер <> Позиция Или Размер < 46 * Количество Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Количество = 0 Тогда
		Возврат Начало = 0 И Размер = 0;
	КонецЕсли;
	Если Начало < 30 * Количество Тогда
		Возврат Ложь;
	КонецЕсли;
	Курсор = Начало;
	Для Индекс = 1 По Количество Цикл
		Если Курсор + 46 > Позиция Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЧислоLE(Буфер, Курсор, 4) <> 33639248 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЧислоLE(Буфер, Курсор + 34, 2) <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЧислоLE(Буфер, Курсор + 42, 4) >= Начало Тогда
			Возврат Ложь;
		КонецЕсли;
		Курсор = Курсор + 46 + ЧислоLE(Буфер, Курсор + 28, 2)
		+ ЧислоLE(Буфер, Курсор + 30, 2) + ЧислоLE(Буфер, Курсор + 32, 2);
		Если Курсор > Позиция Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Курсор = Позиция;
КонецФункции

Процедура ПроверитьДополнение(Буфер, Начало, Размер)
	ПроверитьГраницы(Буфер, Начало, Размер);
	Конец = Начало + Размер;
	Пока Начало < Конец Цикл
		Если Начало + 4 > Конец Тогда
			ОшибкаZIP();
		КонецЕсли;
		ИД = ЧислоLE(Буфер, Начало, 2);
		Длина = ЧислоLE(Буфер, Начало + 2, 2);
		Если ИД = 1 Или ИД = 23 Или ИД = 39169 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Начало = Начало + 4 + Длина;
		Если Начало > Конец Тогда
			ОшибкаZIP();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПрочитатьИмя(Буфер, Начало, Размер, Флаги)
	Если Размер = 0 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Если Цел(Флаги / 2048) % 2 = 0 Тогда
		Для Индекс = Начало По Начало + Размер - 1 Цикл
			Если Буфер.Получить(Индекс) > 127 Тогда
				ОшибкаZIP(НСтр("ru = 'Не-ASCII имена ZIP требуют флага UTF-8.'"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Копия = КопияБайтов(Буфер, Начало, Размер);
	Имя = ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Копия), КодировкаТекста.UTF8);
	Проверка = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(Имя, КодировкаТекста.UTF8, Ложь));
	Если Проверка.Размер <> Размер Тогда
		ОшибкаZIP();
	КонецЕсли;
	Для Индекс = 0 По Размер - 1 Цикл
		Если Проверка.Получить(Индекс) <> Копия.Получить(Индекс) Тогда
			ОшибкаZIP();
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;
КонецФункции

Процедура ПроверитьИмя(Имя, Имена)
	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		ОшибкаZIP();
	КонецЕсли;
	Если ПустаяСтрока(Имя) Или Лев(Имя, 1) = "/" Или СтрНайти(Имя, "\") > 0 Или СтрНайти(Имя, ":") > 0 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Код = КодСимвола(Имя, Индекс);
		Если Код < 32 Или Код = 127 Тогда
			ОшибкаZIP();
		КонецЕсли;
	КонецЦикла;
	Путь = Имя;
	Если Прав(Путь, 1) = "/" Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(Путь, "/", Истина) Цикл
		Если Сегмент = "" Или Сегмент = "." Или Сегмент = ".." Тогда
			ОшибкаZIP();
		КонецЕсли;
	КонецЦикла;
	Если Путь = "" Тогда
		ОшибкаZIP();
	КонецЕсли;
	Ключ = НРег(Путь);
	Если Имена.Получить(Ключ) <> Неопределено Тогда
		ОшибкаZIP(НСтр("ru = 'Повторяющиеся имена ZIP недопустимы.'"));
	КонецЕсли;
	Имена.Вставить(Ключ, Истина);
КонецПроцедуры

Функция ДлинаДескриптора(Буфер, Начало, Предел, Контроль, Сжато, Размер)
	// CRC может совпасть с сигнатурой: проверяем обе допустимые формы.
	Если Начало + 12 <= Предел Тогда
		Если ЧислоLE(Буфер, Начало, 4) = Контроль И ЧислоLE(Буфер, Начало + 4, 4) = Сжато И ЧислоLE(Буфер, Начало + 8, 4) = Размер Тогда
			Возврат 12;
		КонецЕсли;
	КонецЕсли;
	Если Начало + 16 <= Предел Тогда
		Если ЧислоLE(Буфер, Начало, 4) = 134695760 И ЧислоLE(Буфер, Начало + 4, 4) = Контроль И ЧислоLE(Буфер, Начало + 8, 4) = Сжато И ЧислоLE(Буфер, Начало + 12, 4) = Размер Тогда
			Возврат 16;
		КонецЕсли;
	КонецЕсли;
	ОшибкаZIP();
КонецФункции

Функция ТаблицаCRC32()
	Таблица = Новый Массив;
	Для Индекс = 0 По 255 Цикл
		Значение = Индекс;
		Для Бит = 1 По 8 Цикл
			Если Значение % 2 = 1 Тогда
				Значение = ПобитовоеИсключительноеИли(Цел(Значение / 2), 3988292384);
			Иначе
				Значение = Цел(Значение / 2);
			КонецЕсли;
		КонецЦикла;
		Таблица.Добавить(Значение);
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция CRC32(Буфер, Таблица)
	Контроль = 4294967295;
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Номер = ПобитовоеИсключительноеИли(Контроль % 256, Буфер.Получить(Индекс));
		Контроль = ПобитовоеИсключительноеИли(Цел(Контроль / 256), Таблица[Номер]);
	КонецЦикла;
	Возврат ПобитовоеИсключительноеИли(Контроль, 4294967295);
КонецФункции

// Биты читаются LSB-first, код Хаффмана накапливается MSB-first (RFC1951 3.1.1).
Функция Биты(Состояние, Количество)
	Результат = 0;
	Вес = 1;
	Для Индекс = 1 По Количество Цикл
		Если Состояние.Бит >= Состояние.КонецБит Тогда
			ОшибкаZIP();
		КонецЕсли;
		Байт = Состояние.Буфер.Получить(Цел(Состояние.Бит / 8));
		Значение = Цел(Байт / Pow(2, Состояние.Бит % 8)) % 2;
		Результат = Результат + Значение * Вес;
		Вес = Вес * 2;
		Состояние.Бит = Состояние.Бит + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Дерево(Длины, Кодовое = Ложь)
	Количество = Новый Массив;
	Следующий = Новый Массив;
	Для Индекс = 0 По 15 Цикл
		Количество.Добавить(0);
		Следующий.Добавить(0);
	КонецЦикла;
	Максимум = 0;
	Для Каждого Длина Из Длины Цикл
		Если Длина < 0 Или Длина > 15 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Если Длина > 0 Тогда
			Количество[Длина] = Количество[Длина] + 1;
			Максимум = Макс(Максимум, Длина);
		КонецЕсли;
	КонецЦикла;
	Осталось = 1;
	Код = 0;
	Для Длина = 1 По 15 Цикл
		Осталось = Осталось * 2 - Количество[Длина];
		Если Осталось < 0 Тогда
			ОшибкаZIP();
		КонецЕсли;
		Код = (Код + Количество[Длина - 1]) * 2;
		Следующий[Длина] = Код;
	КонецЦикла;
	// Пустое distance-дерево допустимо до появления ссылки. Неполное дерево:
	// только один символ длины 1; code-length alphabet обязан быть полным.
	Если Осталось > 0 И Максимум > 0 Тогда
		Если Кодовое Или Максимум <> 1 Или Количество[1] <> 1 Тогда
			ОшибкаZIP();
		КонецЕсли;
	КонецЕсли;
	Если Кодовое И Максимум = 0 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Таблица = Новый Соответствие;
	Для Символ = 0 По Длины.Количество() - 1 Цикл
		Длина = Длины[Символ];
		Если Длина = 0 Тогда
			Продолжить;
		КонецЕсли;
		Таблица.Вставить(Pow(2, Длина) + Следующий[Длина], Символ);
		Следующий[Длина] = Следующий[Длина] + 1;
	КонецЦикла;
	Возврат Новый Структура("Таблица,Максимум", Таблица, Максимум);
КонецФункции

Функция СимволДерева(Состояние, ДеревоКодов)
	Код = 0;
	Для Длина = 1 По ДеревоКодов.Максимум Цикл
		Код = Код * 2 + Биты(Состояние, 1);
		Символ = ДеревоКодов.Таблица.Получить(Pow(2, Длина) + Код);
		Если Символ <> Неопределено Тогда
			Возврат Символ;
		КонецЕсли;
	КонецЦикла;
	ОшибкаZIP();
КонецФункции

Функция ФиксированныеДеревья()
	Литералы = Новый Массив;
	Для Символ = 0 По 287 Цикл
		Если Символ <= 143 Тогда
			Длина = 8;
		ИначеЕсли Символ <= 255 Тогда
			Длина = 9;
		ИначеЕсли Символ <= 279 Тогда
			Длина = 7;
		Иначе
			Длина = 8;
		КонецЕсли;
		Литералы.Добавить(Длина);
	КонецЦикла;
	Расстояния = Новый Массив;
	Для Символ = 0 По 31 Цикл
		Расстояния.Добавить(5);
	КонецЦикла;
	Возврат Новый Структура("Литералы,Расстояния", Дерево(Литералы), Дерево(Расстояния));
КонецФункции

Функция ДинамическиеДеревья(Состояние)
	ЧислоЛитералов = Биты(Состояние, 5) + 257;
	ЧислоРасстояний = Биты(Состояние, 5) + 1;
	ЧислоКодов = Биты(Состояние, 4) + 4;
	Если ЧислоЛитералов > 286 Тогда
		ОшибкаZIP();
	КонецЕсли;
	// Порядок RFC1951, явно задан без зависимости от локали строковых чисел.
	Порядок = Новый Массив;
	Порядок.Добавить(16);
	Порядок.Добавить(17);
	Порядок.Добавить(18);
	Порядок.Добавить(0);
	Порядок.Добавить(8);
	Порядок.Добавить(7);
	Порядок.Добавить(9);
	Порядок.Добавить(6);
	Порядок.Добавить(10);
	Порядок.Добавить(5);
	Порядок.Добавить(11);
	Порядок.Добавить(4);
	Порядок.Добавить(12);
	Порядок.Добавить(3);
	Порядок.Добавить(13);
	Порядок.Добавить(2);
	Порядок.Добавить(14);
	Порядок.Добавить(1);
	Порядок.Добавить(15);
	ДлиныКодов = Новый Массив;
	Для Индекс = 0 По 18 Цикл
		ДлиныКодов.Добавить(0);
	КонецЦикла;
	Для Индекс = 0 По ЧислоКодов - 1 Цикл
		ДлиныКодов[Порядок[Индекс]] = Биты(Состояние, 3);
	КонецЦикла;
	КодовоеДерево = Дерево(ДлиныКодов, Истина);
	Длины = Новый Массив;
	Всего = ЧислоЛитералов + ЧислоРасстояний;
	Пока Длины.Количество() < Всего Цикл
		Символ = СимволДерева(Состояние, КодовоеДерево);
		Если Символ < 16 Тогда
			Длины.Добавить(Символ);
			Продолжить;
		КонецЕсли;
		Значение = 0;
		Если Символ = 16 Тогда
			Если Длины.Количество() = 0 Тогда
				ОшибкаZIP();
			КонецЕсли;
			Значение = Длины[Длины.Количество() - 1];
			Повтор = Биты(Состояние, 2) + 3;
		ИначеЕсли Символ = 17 Тогда
			Повтор = Биты(Состояние, 3) + 3;
		ИначеЕсли Символ = 18 Тогда
			Повтор = Биты(Состояние, 7) + 11;
		Иначе
			ОшибкаZIP();
		КонецЕсли;
		Если Повтор > Всего - Длины.Количество() Тогда
			ОшибкаZIP();
		КонецЕсли;
		Для Индекс = 1 По Повтор Цикл
			Длины.Добавить(Значение);
		КонецЦикла;
	КонецЦикла;
	Если Длины[256] = 0 Тогда
		ОшибкаZIP();
	КонецЕсли;
	Литералы = Новый Массив;
	Расстояния = Новый Массив;
	Для Индекс = 0 По ЧислоЛитералов - 1 Цикл
		Литералы.Добавить(Длины[Индекс]);
	КонецЦикла;
	Для Индекс = ЧислоЛитералов По Всего - 1 Цикл
		Расстояния.Добавить(Длины[Индекс]);
	КонецЦикла;
	Возврат Новый Структура("Литералы,Расстояния", Дерево(Литералы), Дерево(Расстояния));
КонецФункции

Функция Распаковать(Буфер, Начало, Сжато, Размер)
	// Размер проверен на общий бюджет до выделения, фактический выход проверяется
	// перед каждым literal/stored block/back-reference, включая перекрывающиеся копии.
	Выход = Новый БуферДвоичныхДанных(Размер);
	Состояние = Новый Структура("Буфер,Бит,КонецБит", Буфер, Начало * 8, (Начало + Сжато) * 8);
	Позиция = 0;
	Последний = 0;
	Фиксированные = Неопределено;
	Пока Последний = 0 Цикл
		Последний = Биты(Состояние, 1);
		Вид = Биты(Состояние, 2);
		Если Вид = 0 Тогда
			Состояние.Бит = Цел((Состояние.Бит + 7) / 8) * 8;
			Длина = Биты(Состояние, 16);
			ОбратнаяДлина = Биты(Состояние, 16);
			Если Длина + ОбратнаяДлина <> 65535 Или Длина > Размер - Позиция Тогда
				ОшибкаZIP();
			КонецЕсли;
			Для Индекс = 1 По Длина Цикл
				Выход.Установить(Позиция, Биты(Состояние, 8));
				Позиция = Позиция + 1;
			КонецЦикла;
		ИначеЕсли Вид = 1 Или Вид = 2 Тогда
			Если Вид = 1 Тогда
				Если Фиксированные = Неопределено Тогда
					Фиксированные = ФиксированныеДеревья();
				КонецЕсли;
				Деревья = Фиксированные;
			Иначе
				Деревья = ДинамическиеДеревья(Состояние);
			КонецЕсли;
			Пока Истина Цикл
				Символ = СимволДерева(Состояние, Деревья.Литералы);
				Если Символ < 256 Тогда
					Если Позиция >= Размер Тогда
						ОшибкаZIP();
					КонецЕсли;
					Выход.Установить(Позиция, Символ);
					Позиция = Позиция + 1;
				ИначеЕсли Символ = 256 Тогда
					Прервать;
				Иначе
					Если Символ > 285 Тогда
						ОшибкаZIP();
					КонецЕсли;
					Если Символ = 285 Тогда
						Длина = 258;
					ИначеЕсли Символ < 265 Тогда
						Длина = Символ - 254;
					Иначе
						ДопБит = Цел((Символ - 261) / 4);
						Длина = 3 + Pow(2, ДопБит + 2) + ((Символ - 265) % 4) * Pow(2, ДопБит) + Биты(Состояние, ДопБит);
					КонецЕсли;
					// RFC1951: код 284 допускает длины 227..257; 258 кодируется 285.
					Если Символ = 284 И Длина = 258 Тогда
						ОшибкаZIP();
					КонецЕсли;
					КодРасстояния = СимволДерева(Состояние, Деревья.Расстояния);
					Если КодРасстояния > 29 Тогда
						ОшибкаZIP();
					КонецЕсли;
					Если КодРасстояния < 4 Тогда
						Расстояние = КодРасстояния + 1;
					Иначе
						ДопБит = Цел(КодРасстояния / 2) - 1;
						Расстояние = 1 + Pow(2, ДопБит + 1) + (КодРасстояния % 2) * Pow(2, ДопБит) + Биты(Состояние, ДопБит);
					КонецЕсли;
					Если Расстояние > Позиция Или Длина > Размер - Позиция Тогда
						ОшибкаZIP();
					КонецЕсли;
					Для Индекс = 1 По Длина Цикл
						Выход.Установить(Позиция, Выход.Получить(Позиция - Расстояние));
						Позиция = Позиция + 1;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ОшибкаZIP();
		КонецЕсли;
	КонецЦикла;
	Если Позиция <> Размер Или Цел((Состояние.Бит + 7) / 8) <> Начало + Сжато Тогда
		ОшибкаZIP();
	КонецЕсли;
	Возврат Выход;
КонецФункции

#КонецОбласти
