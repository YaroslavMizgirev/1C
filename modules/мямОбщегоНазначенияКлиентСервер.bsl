КонецПроцедуры

// Функция - Получить параметры данных выбора.
//
// Параметры:
//  СтрокаПоиска - Строка - Текст введенный пользователем.
//  Отбор - Структура - Где ключ - наименование параметра отбора и значение - значение параметра отбора. По умолчанию - Неопределено.
//   Если Неопределено, переданная переменная заменяется новой пустой структурой до преобразования ГруппыИЭлементы; готовая структура не копируется.
//  ГруппыИЭлементы - Строка - Принимаемые значения: "Группы", "ГруппыИЭлементы", "Элементы". По умолчанию - "Элементы".
//   Переданная строковая переменная заменяется значением ИспользованиеГруппИЭлементов после инициализации двух структур; неверное имя вызывает ошибку платформы.
//  ДополнительныеПараметры - Структура - Где ключ - наименование параметра дополнительного отбора и значение - значение параметра дополнительного отбора. По умолчанию - Неопределено.
//   Если Неопределено, переданная переменная заменяется новой пустой структурой до преобразования ГруппыИЭлементы; готовая структура не копируется.
//
// Возвращаемое значение:
//   - Структура:
//    * СтрокаПоиска - Строка.
//    * Отбор - Структура.
//    * ВыборГруппИЭлементов - ИспользованиеГруппИЭлементов.
//    * ДополнительныеПараметры - Структура.
//
Функция ПолучитьПараметрыДанныхВыбора(СтрокаПоиска="",Отбор=Неопределено,ДополнительныеПараметры=Неопределено,ГруппыИЭлементы="Элементы") Экспорт

	Отбор = ?(Отбор=Неопределено, Новый Структура, Отбор);
	ДополнительныеПараметры = ?(ДополнительныеПараметры=Неопределено, Новый Структура, ДополнительныеПараметры);
	ГруппыИЭлементы = ИспользованиеГруппИЭлементов[ГруппыИЭлементы];
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ПараметрыВыбора.Вставить("СтрокаПоиска", СтрокаПоиска);
	ПараметрыВыбора.Вставить("ВыборГруппИЭлементов", ГруппыИЭлементы);
	ПараметрыВыбора.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	Возврат ПараметрыВыбора;

КонецФункции

// Процедура - Установить полное наименование.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//   Меняет Объект.НаименованиеПолное при Принудительно или установленном признаке совпадения; при Принудительно существующий признак НаименованиеПолноеСовпадает устанавливает в Истина.
//  Принудительно - Булево.
//  ЗначениеПолногоНаименования - Строка.
//
Процедура УстановитьПолноеНаименование(Форма,Принудительно=Ложь,ЗначениеПолногоНаименования="") Экспорт

	Если Принудительно Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НаименованиеПолноеСовпадает") Тогда
			Форма.НаименованиеПолноеСовпадает = Истина;
		КонецЕсли;
		Форма.Объект.НаименованиеПолное = ?(ПустаяСтрока(ЗначениеПолногоНаименования), Форма.Объект.Наименование, ЗначениеПолногоНаименования);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НаименованиеПолноеСовпадает") И Форма.НаименованиеПолноеСовпадает Тогда
		Форма.Объект.НаименованиеПолное = ?(ПустаяСтрока(ЗначениеПолногоНаименования), Форма.Объект.Наименование, ЗначениеПолногоНаименования);
	КонецЕсли;

КонецПроцедуры

// Процедура - Установить признак наименование полное совпадает.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//   Безусловно присваивает реквизиту НаименованиеПолноеСовпадает результат сравнения полного и краткого наименований; отсутствующий реквизит вызывает ошибку.
//
Процедура УстановитьПризнакНаименованиеПолноеСовпадает(Форма) Экспорт

	Форма.НаименованиеПолноеСовпадает = Форма.Объект.НаименованиеПолное = Форма.Объект.Наименование;

КонецПроцедуры

// Функция - Это примитивный тип данных.
//
// Параметры:
//  ПроверяемоеЗначение  - Произвольный.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ЭтоПримитивныйТипДанных(Знач ПроверяемоеЗначение) Экспорт

	Если ТипЗнч(ПроверяемоеЗначение) = Тип("ОписаниеТипов") Тогда
		МассивТипов = ПроверяемоеЗначение.Типы();
		Если МассивТипов.Количество() > 0 Тогда мямМассивКлиентСервер.УдалитьВсеВхожденияТипаИзМассиваТипов(МассивТипов, Тип("Дата")); КонецЕсли;
		Если МассивТипов.Количество() > 0 Тогда мямМассивКлиентСервер.УдалитьВсеВхожденияТипаИзМассиваТипов(МассивТипов, Тип("Строка")); КонецЕсли;
		Если МассивТипов.Количество() > 0 Тогда мямМассивКлиентСервер.УдалитьВсеВхожденияТипаИзМассиваТипов(МассивТипов, Тип("Число")); КонецЕсли;
		Если МассивТипов.Количество() > 0 Тогда мямМассивКлиентСервер.УдалитьВсеВхожденияТипаИзМассиваТипов(МассивТипов, Тип("Булево")); КонецЕсли;

		Возврат МассивТипов.Количество() = 0;
	Иначе
		Возврат мямДатаКлиентСервер.ЭтоДата(ПроверяемоеЗначение) Или мямСтрокаКлиентСервер.ЭтоСтрока(ПроверяемоеЗначение) Или мямБулевоКлиентСервер.ЭтоБулево(ПроверяемоеЗначение) Или мямЧислоКлиентСервер.ЭтоЧисло(ПроверяемоеЗначение);
	КонецЕсли;

КонецФункции

