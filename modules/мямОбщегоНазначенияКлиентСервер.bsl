// Функция - В составе исключаемых реквизитов.
//
// Параметры:
//  ПроверяемыйРеквизит - Строка - Имя реквизита.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ВСоставеИсключаемыхРеквизитов(ПроверяемыйРеквизит) Экспорт

	МассивИсключаемыхРеквизитов = СтрРазделить("СтандартныйРеквизит.Ссылка,СтандартныйРеквизит.ЭтоГруппа,СтандартныйРеквизит.ПометкаУдаления,СтандартныйРеквизит.Предопределенный,СтандартныйРеквизит.ИмяПредопределенныхДанных,СтандартныйРеквизит.НомерСтроки", ",", Ложь);
	Возврат МассивИсключаемыхРеквизитов.Найти(ПроверяемыйРеквизит) <> Неопределено;

КонецФункции

// Процедура - Заполнить список метаданных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//   Дополняет СписокВыбора указанного элемента формы по мере обхода результата, без предварительной очистки.
//  ТипМетаданных - Строка - Имя типа метаданных.
//  ИмяЭлемента - Строка - Имя элемента на Форме.
//
Процедура ЗаполнитьСписокОбъектовМетаданных(Форма,ТипМетаданных,ИмяЭлемента) Экспорт

#Если Клиент И Не ТолстыйКлиентОбычноеПриложение Тогда
	СписокОбъектовМетаданных = мямОбщегоНазначенияВызовСервера.СписокОбъектовМетаданных(ТипМетаданных);
#Иначе
	СписокОбъектовМетаданных = мямОбщегоНазначения.СписокОбъектовМетаданных(ТипМетаданных);
#КонецЕсли
	Для Каждого ЭлементОбъектаМетаданных Из СписокОбъектовМетаданных Цикл
		Форма.Элементы[ИмяЭлемента].СписокВыбора.Добавить(ЭлементОбъектаМетаданных.Значение, ЭлементОбъектаМетаданных.Представление);
	КонецЦикла;

КонецПроцедуры

// Дополняет список выбора элемента формы реквизитами выбранной табличной части, исключая служебные поля. При
//   пустом имени табличной части ничего не делает.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с изменяемым списком выбора.
//   Дополняет СписокВыбора указанного элемента формы по мере обхода результата, без предварительной очистки. При пустом имени табличной части возвращается до изменений.
//  ТипМетаданных - Строка - имя коллекции метаданных во множественном числе, например Справочники.
//  ИмяОбъектаМетаданных - Строка - имя объекта в выбранной коллекции.
//  ИмяТабличнойЧасти - Строка - имя табличной части объекта.
//  ИмяЭлемента - Строка - имя элемента формы; его СписокВыбора дополняется без предварительной очистки.
Процедура ЗаполнитьСписокРеквизитовТабличнойЧасти(Форма,ТипМетаданных,ИмяОбъектаМетаданных,ИмяТабличнойЧасти,ИмяЭлемента) Экспорт

	Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда Возврат; КонецЕсли;

#Если Клиент И Не ТолстыйКлиентОбычноеПриложение Тогда
	СписокРеквизитовТабличнойЧасти = мямОбщегоНазначенияВызовСервера.СписокРеквизитовТабличнойЧасти(ТипМетаданных, ИмяОбъектаМетаданных, ИмяТабличнойЧасти);
#Иначе
	СписокРеквизитовТабличнойЧасти = мямОбщегоНазначения.СписокРеквизитовТабличнойЧасти(ТипМетаданных, ИмяОбъектаМетаданных, ИмяТабличнойЧасти);
#КонецЕсли
	Для Каждого РеквизитТабличнойЧасти Из СписокРеквизитовТабличнойЧасти Цикл
		Если Не мямОбщегоНазначенияКлиентСервер.ВСоставеИсключаемыхРеквизитов(РеквизитТабличнойЧасти.Значение) Тогда
			Форма.Элементы[ИмяЭлемента].СписокВыбора.Добавить(РеквизитТабличнойЧасти.Значение, РеквизитТабличнойЧасти.Представление);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дополняет список выбора элемента формы реквизитами и табличными частями объекта, исключая служебные поля.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//   Дополняет СписокВыбора указанного элемента формы по мере обхода результата, без предварительной очистки.
//  ТипМетаданных - Строка - имя коллекции метаданных.
//  ИмяОбъектаМетаданных - Строка - имя объекта в коллекции.
//  ИмяЭлемента - Строка - Имя элемента на Форме.
//
Процедура ЗаполнитьСписокРеквизитовТабличныхЧастей(Форма,ТипМетаданных,ИмяОбъектаМетаданных,ИмяЭлемента) Экспорт

#Если Клиент И Не ТолстыйКлиентОбычноеПриложение Тогда
	СписокРеквизитТабличнаяЧасть = мямОбщегоНазначенияВызовСервера.СписокРеквизитовТабличныхЧастей(ТипМетаданных, ИмяОбъектаМетаданных);
#Иначе
	СписокРеквизитТабличнаяЧасть = мямОбщегоНазначения.СписокРеквизитовТабличныхЧастей(ТипМетаданных, ИмяОбъектаМетаданных);
#КонецЕсли
	Для Каждого РеквизитТабличнаяЧасть Из СписокРеквизитТабличнаяЧасть Цикл
		Если Не мямОбщегоНазначенияКлиентСервер.ВСоставеИсключаемыхРеквизитов(РеквизитТабличнаяЧасть.Значение) Тогда
			Форма.Элементы[ИмяЭлемента].СписокВыбора.Добавить(РеквизитТабличнаяЧасть.Значение, РеквизитТабличнаяЧасть.Представление);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Процедура - Заполнить список типов метаданных
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//   Дополняет СписокВыбора указанного элемента формы по мере обхода результата, без предварительной очистки.
//  ИмяЭлемента - Строка - Имя элемента на Форме.
//
Процедура ЗаполнитьСписокТиповМетаданных(Форма,ИмяЭлемента) Экспорт

#Если Клиент И Не ТолстыйКлиентОбычноеПриложение Тогда
	ЗначенияТипаМетаданных = мямОбщегоНазначенияВызовСервера.ВсеТипыМетаданных();
#Иначе
	ЗначенияТипаМетаданных = мямОбщегоНазначения.ВсеТипыМетаданных();
#КонецЕсли
	Для Каждого ЗначениеТипаМетаданных Из ЗначенияТипаМетаданных Цикл
		Форма.Элементы[ИмяЭлемента].СписокВыбора.Добавить(ЗначениеТипаМетаданных.Значение, ЗначениеТипаМетаданных.Представление);
	КонецЦикла;

КонецПроцедуры

