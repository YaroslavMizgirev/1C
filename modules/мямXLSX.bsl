#Область ПрограммныйИнтерфейс

// Читает UTF-8 XML из проверенного архива в отдельную подпапку, без восстановления путей. Отсутствующая
//   часть, DTD или ошибка XML вызывает исключение; архив не закрывает.
//
// Параметры:
//  Архив - ЧтениеZipФайла - архив, проверенный ЧастиКнигиXLSX.
//  ИмяЧасти - Строка - разрешённое имя ZIP-части, не путь файловой системы.
//  КаталогЧтения - Строка - временный каталог владельца с завершающим разделителем; создаёт подпапку.
//
// Возвращаемое значение:
//  ДокументDOM - разобранный документ части.
Функция XMLИзАрхива(Архив, ИмяЧасти, КаталогЧтения) Экспорт

	ЗаписьАрхива = НайтиЧасть(Архив, ИмяЧасти);
	Если ЗаписьАрхива = Неопределено Тогда ВызватьИсключение НСтр("ru = 'Поврежденная книга: отсутствует часть.'") + " " + ИмяЧасти; КонецЕсли;
	// Каждая часть извлекается без восстановления путей в собственную папку.
	Подкаталог = КаталогЧтения + Строка(Новый УникальныйИдентификатор) + "/";
	СоздатьКаталог(Подкаталог);
	Архив.Извлечь(ЗаписьАрхива, Подкаталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	ЧастиПути = СтрРазделить(СтрЗаменить(ИмяЧасти, "\", "/"), "/");
	ТекстЧасти = Новый ТекстовыйДокумент;
	ТекстЧасти.Прочитать(Подкаталог + ЧастиПути[ЧастиПути.Количество() - 1], КодировкаТекста.UTF8);
	Если СтрНайти(ВРег(ТекстЧасти.ПолучитьТекст()), "<!DOCTYPE") > 0 Тогда ВызватьИсключение НСтр("ru = 'DTD в книге не поддерживается.'"); КонецЕсли;
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстЧасти.ПолучитьТекст());
	Попытка
		Строитель = Новый ПостроительDOM;
		ДокументЧасти = Строитель.Прочитать(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат ДокументЧасти;

КонецФункции

// Добавляет лист в конец книги. Неверное имя или повтор без учёта регистра вызывает исключение до
//   изменения книги.
//
// Параметры:
//  Книга - Структура - см. НоваяКнигаXLSX; дополняет ЛистыXLSX.
//   После проверки книги, имени и отсутствия повтора добавляет новый лист в переданный массив ЛистыXLSX.
//  ИмяЛиста - Строка - имя длиной 1–31 единица UTF-16, кроме History; см. ПроверитьИмяЛистаXLSX.
//
// Возвращаемое значение:
//  Структура - ИмяXLSX (Строка), ЯчейкиXLSX (Соответствие ключа координаты и значения). Заполнять через
//   УстановитьЯчейкуXLSX.
Функция ДобавитьЛистXLSX(Книга, ИмяЛиста) Экспорт

	ПроверитьКнигуЗаписиXLSX(Книга);
	ПроверитьИмяЛистаXLSX(ИмяЛиста);
	Для Каждого Лист Из Книга.ЛистыXLSX Цикл
		Если ВРег(Лист.ИмяXLSX) = ВРег(ИмяЛиста) Тогда
			ВызватьИсключение НСтр("ru = 'Лист XLSX с таким именем уже существует.'");
		КонецЕсли;
	КонецЦикла;
	НовыйЛист = Новый Структура("ИмяXLSX,ЯчейкиXLSX", ИмяЛиста, Новый Соответствие);
	Книга.ЛистыXLSX.Добавить(НовыйЛист);
	Возврат НовыйЛист;

КонецФункции

// Возвращает прямых детей с заданным локальным именем без проверки пространства имён.
//
// Параметры:
//  Узел - УзелDOM, Неопределено - родитель.
//  ЛокальноеИмя - Строка - искомое имя элемента.
//
// Возвращаемое значение:
//  Массив из УзелDOM - найденные дети; пустой для отсутствующего родителя.
Функция Дочерние(Узел, ЛокальноеИмя) Экспорт
	РезультатУзлов = Новый Массив;
	Если Узел = Неопределено Тогда Возврат РезультатУзлов; КонецЕсли;
	Для Каждого ДочернийУзел Из Узел.ДочерниеУзлы Цикл
		Если ДочернийУзел.ЛокальноеИмя = ЛокальноеИмя Тогда РезультатУзлов.Добавить(ДочернийУзел); КонецЕсли;
	КонецЦикла;
	Возврат РезультатУзлов;
КонецФункции

// Выбирает первого прямого ребёнка по локальному имени без проверки пространства имён.
//
// Параметры:
//  Узел - УзелDOM, Неопределено - родитель.
//  ЛокальноеИмя - Строка - искомое имя элемента.
//
// Возвращаемое значение:
//  УзелDOM, Неопределено - первый найденный узел либо отсутствие.
Функция Дочерний(Узел, ЛокальноеИмя) Экспорт
	СписокУзлов = Дочерние(Узел, ЛокальноеИмя);
	Возврат ?(СписокУзлов.Количество() = 0, Неопределено, СписокУзлов[0]);
КонецФункции

// Создаёт независимую книгу для заполнения на сервере. Книгу и листы следует менять методами этого модуля;
//   память зависит от числа и объёма ячеек.
//
// Возвращаемое значение:
//  Структура - ЛистыXLSX (Массив листов); изначально листов нет. См. ДобавитьЛистXLSX.
Функция НоваяКнигаXLSX() Экспорт

	Возврат Новый Структура("ЛистыXLSX", Новый Массив);

КонецФункции

// Собирает полный Transitional XLSX во временном каталоге, не меняя книгу. Пустая книга, ошибка записи,
//   архива или очистки вызывает исключение с причиной. Даты записывает в системе 1900 до секунды.
//
// Параметры:
//  Книга - Структура - заполненная НоваяКнигаXLSX хотя бы с одним листом.
//
// Возвращаемое значение:
//  ДвоичныеДанные - полный ZIP книги; пиковая память зависит от ячеек, XML и архива. Открытие файла в
//   Excel и нативная проверка требуют отдельной приёмки.
Функция СформироватьXLSX(Книга) Экспорт

	ПроверитьКнигуЗаписиXLSX(Книга);
	Если Книга.ЛистыXLSX.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В книге XLSX должен быть хотя бы один лист.'");
	КонецЕсли;
	КаталогСборки = ФайловаяСистема.СоздатьВременныйКаталог("xlsx");
	АрхивЗаписи = Неопределено;
	Попытка
		ЗаписатьЧастиКнигиXLSX(Книга, КаталогСборки);
		АрхивЗаписи = Новый ЗаписьФайлаАрхива;
		АрхивЗаписи.Добавить(КаталогСборки + "*",
			РежимСохраненияПутейФайлаАрхива.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговФайлаАрхива.ОбрабатыватьРекурсивно);
		ДанныеКниги = АрхивЗаписи.ПолучитьДвоичныеДанные();
		АрхивЗаписи = Неопределено;
	Исключение
		Причина = ИнформацияОбОшибке();
		ОшибкиОчистки = ОчиститьРесурсыЗаписиXLSX(АрхивЗаписи, КаталогСборки);
		ТекстОшибки = НСтр("ru = 'Не удалось сформировать XLSX.'") + ОшибкиОчистки;
		ВызватьИсключение(ТекстОшибки,,,, Причина);
	КонецПопытки;
	ОшибкиОчистки = ОчиститьРесурсыЗаписиXLSX(АрхивЗаписи, КаталогСборки);
	Если Не ПустаяСтрока(ОшибкиОчистки) Тогда
		ВызватьИсключение НСтр("ru = 'XLSX сформирован, но временные ресурсы не очищены.'") + ОшибкиОчистки;
	КонецЕсли;
	Возврат ДанныеКниги;

КонецФункции

// Собирает текст потомков t, включая фрагменты форматированной строки.
//
// Параметры:
//  Узел - УзелDOM, Неопределено - узел строки или ячейки.
//
// Возвращаемое значение:
//  Строка - объединённый текст; для отсутствующего узла пустая строка.
Функция ТекстУзлов(Узел) Экспорт
	Если Узел = Неопределено Тогда Возврат ""; КонецЕсли;
	Если Узел.ЛокальноеИмя = "t" Тогда Возврат Узел.ТекстовоеСодержимое; КонецЕсли;
	ТекстРезультата = "";
	Для Каждого ДочернийУзел Из Узел.ДочерниеУзлы Цикл
		ТекстРезультата = ТекстРезультата + ТекстУзлов(ДочернийУзел);
	КонецЦикла;
	Возврат ТекстРезультата;
КонецФункции

// Заменяет ячейку; Неопределено и Null удаляют значение. Строки, включая начинающиеся с =, +, -, @,
//   остаются текстом. Неверное значение не меняет прежнюю ячейку.
//
// Параметры:
//  Лист - Структура - см. ДобавитьЛистXLSX; меняет ЯчейкиXLSX на месте.
//   После проверки листа, координат и значения меняет ЯчейкиXLSX: для Неопределено/Null удаляет ячейку, иначе вставляет либо заменяет её.
//  НомерСтроки - Число - целое от 1 до 1048576.
//  НомерКолонки - Число - целое от 1 до 16384.
//  Значение - Строка, Число, Булево, Дата, Неопределено, Null - строка до 32767 единиц UTF-16, число до 15
//   значащих цифр, дата от 1900-01-01 без смены часового пояса.
Процедура УстановитьЯчейкуXLSX(Лист, НомерСтроки, НомерКолонки, Значение) Экспорт

	ПроверитьЛистЗаписиXLSX(Лист);
	Попытка
		ПроверитьКоординатуXLSX(НомерСтроки, 1048576);
		ПроверитьКоординатуXLSX(НомерКолонки, 16384);
		ПроверитьЗначениеЯчейкиXLSX(Значение);
	Исключение
		Причина = ИнформацияОбОшибке();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Некорректная ячейка XLSX: строка %1, колонка %2.'"),
			НомерСтроки, НомерКолонки);
		ВызватьИсключение(ТекстОшибки,,,, Причина);
	КонецПопытки;
	КлючЯчейки = (НомерСтроки - 1) * 16384 + НомерКолонки;
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Лист.ЯчейкиXLSX.Удалить(КлючЯчейки);
	Иначе
		Лист.ЯчейкиXLSX.Вставить(КлючЯчейки, Значение);
	КонецЕсли;

КонецПроцедуры

// Находит части книги по связям пакета и workbook. Повреждение, неверный тип или внешняя связь вызывает
//   исключение; архив и каталог остаются в ведении вызывающего кода.
//
// Параметры:
//  Архив - ЧтениеZipФайла - открытый архив; проверяются имена, количество и распакованный размер.
//  КаталогЧтения - Строка - временный каталог с завершающим разделителем, в который извлекает части.
//
// Возвращаемое значение:
//  Структура - Книга (ДокументDOM workbook), ПутиЛистов (Соответствие r:id → имя ZIP-части), Стили и
//   ОбщиеСтроки (ДокументDOM либо Неопределено).
Функция ЧастиКнигиXLSX(Архив, КаталогЧтения) Экспорт

	ПроверитьАрхив(Архив);
	КорневыеСвязи = ПрочитатьСвязи(Архив, "_rels/.rels", КаталогЧтения);
	СвязьКниги = СвязьПоТипу(КорневыеСвязи, "officeDocument", Истина);
	ИмяКниги = ВнутренняяЧасть(Архив, "", СвязьКниги);
	ПроверитьТипКниги(Архив, ИмяКниги, КаталогЧтения);
	Книга = XMLИзАрхива(Архив, ИмяКниги, КаталогЧтения);
	ПространствоЛистов = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
	ПроверитьКореньXML(Книга, "workbook", ПространствоЛистов);
	ЧастиПути = СтрРазделить(ИмяКниги, "/");
	ИмяФайла = ЧастиПути[ЧастиПути.Количество() - 1];
	КаталогКниги = Лев(ИмяКниги, СтрДлина(ИмяКниги) - СтрДлина(ИмяФайла));
	ИмяСвязей = КаталогКниги + "_rels/" + ИмяФайла + ".rels";
	Связи = ПрочитатьСвязи(Архив, ИмяСвязей, КаталогЧтения);
	ПутиЛистов = Новый Соответствие;
	Листы = Дочерние(Дочерний(Книга.ЭлементДокумента, "sheets"), "sheet");
	Для Каждого Лист Из Листы Цикл
		ИД = Лист.ПолучитьАтрибут("http://schemas.openxmlformats.org/officeDocument/2006/relationships", "id");
		Связь = Связи.Получить(ИД);
		Если ПустаяСтрока(ИД) Или Связь = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Отсутствует связь листа XLSX.'");
		КонецЕсли;
		Если Связь.Тип <> ТипСвязи("worksheet") Тогда
			ВызватьИсключение НСтр("ru = 'Неверный тип связи листа XLSX.'");
		КонецЕсли;
		ПутиЛистов.Вставить(ИД, ВнутренняяЧасть(Архив, ИмяКниги, Связь));
	КонецЦикла;
	Стили = НеобязательнаяЧасть(Архив, ИмяКниги, Связи, "styles", "styleSheet", КаталогЧтения);
	Общие = НеобязательнаяЧасть(Архив, ИмяКниги, Связи, "sharedStrings", "sst", КаталогЧтения);
	Возврат Новый Структура("Книга,ПутиЛистов,Стили,ОбщиеСтроки", Книга, ПутиЛистов, Стили, Общие);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Упорядочивает заполненные ячейки по координатам и формирует лист без пустых промежуточных строк.
//
// Параметры:
//  Лист - Структура - см. ДобавитьЛистXLSX; не изменяется.
//
// Возвращаемое значение:
//  Строка - XML worksheet с sheetData.
Функция XMLЛистаЗаписиXLSX(Лист)
	ПроверитьЛистЗаписиXLSX(Лист);
	ТаблицаЯчеек = Новый ТаблицаЗначений;
	ТаблицаЯчеек.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Число"));
	ТаблицаЯчеек.Колонки.Добавить("Значение");
	Для Каждого Ячейка Из Лист.ЯчейкиXLSX Цикл
		СтрокаЯчейки = ТаблицаЯчеек.Добавить();
		СтрокаЯчейки.Ключ = Ячейка.Ключ;
		СтрокаЯчейки.Значение = Ячейка.Значение;
	КонецЦикла;
	ТаблицаЯчеек.Сортировать("Ключ Возр");
	Фрагменты = Новый Массив;
	Фрагменты.Добавить("<worksheet xmlns=""http://schemas.openxmlformats.org/spreadsheetml/2006/main""><sheetData>");
	ТекущаяСтрока = 0;
	Для Каждого Ячейка Из ТаблицаЯчеек Цикл
		НомерСтроки = Цел((Ячейка.Ключ - 1) / 16384) + 1;
		НомерКолонки = Ячейка.Ключ - (НомерСтроки - 1) * 16384;
		Если НомерСтроки <> ТекущаяСтрока Тогда
			Если ТекущаяСтрока <> 0 Тогда Фрагменты.Добавить("</row>"); КонецЕсли;
			Фрагменты.Добавить("<row r=""" + XMLСтрока(НомерСтроки) + """>");
			ТекущаяСтрока = НомерСтроки;
		КонецЕсли;
		Адрес = АдресЯчейкиЗаписиXLSX(НомерСтроки, НомерКолонки);
		Фрагменты.Добавить(XMLЯчейкиЗаписиXLSX(Адрес, Ячейка.Значение));
	КонецЦикла;
	Если ТекущаяСтрока <> 0 Тогда Фрагменты.Добавить("</row>"); КонецЕсли;
	Фрагменты.Добавить("</sheetData></worksheet>");
	Возврат СтрСоединить(Фрагменты);
КонецФункции

// Формирует XML одной ячейки без формул; дату переводит в систему Excel 1900 с поправкой на фиктивный
//   день.
//
// Параметры:
//  Адрес - Строка - проверенный адрес ячейки.
//  Значение - Строка, Число, Булево, Дата - проверенное непустое значение.
//
// Возвращаемое значение:
//  Строка - элемент c; строка записана как inlineStr, дата со стилем 1.
Функция XMLЯчейкиЗаписиXLSX(Адрес, Значение)
	ТипЗначения = ТипЗнч(Значение);
	Начало = "<c r=""" + Адрес + """";
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Начало + " t=""inlineStr""><is><t xml:space=""preserve"">"
			+ ТекстXMLЗаписиXLSX(Значение) + "</t></is></c>";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Начало + " t=""b""><v>" + ?(Значение, "1", "0") + "</v></c>";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		// Excel включает несуществующий день 1900-02-29 под номером 60.
		Дней = (Значение - Дата(1899, 12, 31)) / 86400;
		Если Значение >= Дата(1900, 3, 1) Тогда Дней = Дней + 1; КонецЕсли;
		Возврат Начало + " s=""1""><v>" + XMLСтрока(Дней) + "</v></c>";
	КонецЕсли;
	Возврат Начало + "><v>" + XMLСтрока(Значение) + "</v></c>";
КонецФункции

// Строит адрес ячейки из проверенных координат.
//
// Параметры:
//  НомерСтроки - Число - целый номер строки с единицы.
//  НомерКолонки - Число - целый номер колонки с единицы.
//
// Возвращаемое значение:
//  Строка - адрес вида AA17.
Функция АдресЯчейкиЗаписиXLSX(НомерСтроки, НомерКолонки)
	Буквы = "";
	Остаток = НомерКолонки;
	Пока Остаток > 0 Цикл
		Частное = Цел((Остаток - 1) / 26);
		Буквы = Сред("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Остаток - Частное * 26, 1) + Буквы;
		Остаток = Частное;
	КонецЦикла;
	Возврат Буквы + XMLСтрока(НомерСтроки);
КонецФункции

// Выделяет буквенную часть адреса ячейки. Отсутствие букв или длина больше трёх вызывает исключение.
//
// Параметры:
//  АдресЯчейки - Строка - адрес вида AA17 с заглавными латинскими буквами.
//
// Возвращаемое значение:
//  Строка - буквы колонки; номер строки проверяет вызывающий метод.
Функция БуквыКолонки(АдресЯчейки)

	Буквы = "";
	Для Позиция = 1 По СтрДлина(АдресЯчейки) Цикл
		Буква = Сред(АдресЯчейки, Позиция, 1);
		Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Буква) = 0 Тогда
			Прервать;
		КонецЕсли;
		Буквы = Буквы + Буква;
	КонецЦикла;
	Если ПустаяСтрока(Буквы) Или СтрДлина(Буквы) > 3 Тогда ВызватьИсключение "Недопустимый адрес ячейки."; КонецЕсли;
	Возврат Буквы;

КонецФункции

// Разрешает цель внутренней связи и проверяет наличие части. Внешний/неизвестный режим и отсутствие части
//   вызывают исключение.
//
// Параметры:
//  Архив - ЧтениеZipФайла - проверенный архив.
//  Источник - Строка - имя части-источника либо пусто для корня.
//  Связь - Структура - Тип, Цель, Режим из ПрочитатьСвязи.
//   У внутренней связи РазрешитьЦель удаляет начальный / из свойства Цель, если он есть; свойство меняется и при последующей ошибке пути или отсутствии части архива.
//
// Возвращаемое значение:
//  Строка - имя существующей ZIP-части.
Функция ВнутренняяЧасть(Архив, Источник, Связь)
	Если Связь.Режим <> "Internal" Тогда
		ВызватьИсключение НСтр("ru = 'Внешняя или неизвестная связь части OOXML.'");
	КонецЕсли;
	Имя = РазрешитьЦель(Источник, Связь.Цель);
	Если НайтиЧасть(Архив, Имя) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Отсутствует связанная часть OOXML.'");
	КонецЕсли;
	Возврат Имя;
КонецФункции

// Переводит целую часть серийной даты в календарную строку. Неверные значения и фиктивный день 1900-02-29
//   не принимает.
//
// Параметры:
//  Сырое - Строка - серийное число Excel.
//  Даты1904 - Булево - использовать начало отсчёта 1904 вместо 1900.
//
// Возвращаемое значение:
//  Строка - dd.MM.yyyy либо пустая строка при отказе.
Функция ДатаExcel(Сырое, Даты1904)
	Попытка
		СерийнаяДата = мямЧислоКлиентСервер.РазобратьЧисло(Сырое);
	Исключение
		Возврат "";
	КонецПопытки;
	Если СерийнаяДата = Неопределено Тогда Возврат ""; КонецЕсли;
	Если СерийнаяДата < 1 Или СерийнаяДата > 2958465 Или (Не Даты1904 И Цел(СерийнаяДата) = 60) Тогда Возврат ""; КонецЕсли;
	Попытка
		НачалоОтсчета = ?(Даты1904, Дата(1904, 1, 1), Дата(1899, 12, 31));
		Поправка = ?(Не Даты1904 И СерийнаяДата > 60, 1, 0);
		Возврат Формат(НачалоОтсчета + (Цел(СерийнаяДата) - Поправка) * 86400, "ДФ=dd.MM.yyyy");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Добавляет описание ContentType, отклоняя пустые, повторные или чужие элементы исключением.
//
// Параметры:
//  Типы - Соответствие - дополняемый индекс частей или расширений → ContentType.
//   В переданное соответствие добавляет новую пару после проверки узла; любой существующий ключ вызывает исключение до вставки.
//  Ключ - Строка - нормализованное имя части либо расширение.
//  Узел - ЭлементDOM - Override или Default из [Content_Types].xml.
Процедура ДобавитьТипСодержимого(Типы, Ключ, Узел)
	Тип = Узел.ПолучитьАтрибут("ContentType");
	Если Узел.URIПространстваИмен <> "http://schemas.openxmlformats.org/package/2006/content-types"
		Или ПустаяСтрока(Ключ) Или ПустаяСтрока(Тип) Или Типы.Получить(Ключ) <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неоднозначное описание типа содержимого OOXML.'");
	КонецЕсли;
	Типы.Вставить(Ключ, Тип);
КонецПроцедуры

// Записывает XML-часть в UTF-8 с декларацией. Закрывает запись и при ошибке; сбой закрытия сохраняет
//   первичную причину.
//
// Параметры:
//  ИмяФайла - Строка - полный путь создаваемого файла.
//  XMLЧасти - Строка - содержимое XML без декларации.
Процедура ЗаписатьXMLЧастьXLSX(ИмяФайла, XMLЧасти)
	ЗаписьЧасти = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Попытка
		ЗаписьЧасти.Записать("<?xml version=""1.0"" encoding=""UTF-8""?>" + XMLЧасти);
	Исключение
		Причина = ИнформацияОбОшибке();
		Попытка
			ЗаписьЧасти.Закрыть();
		Исключение
			ТекстОшибки = НСтр("ru = 'Ошибка закрытия XML после ошибки записи.'")
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение(ТекстОшибки,,,, Причина);
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ЗаписьЧасти.Закрыть();
КонецПроцедуры

// Создаёт на диске части XLSX: листы, книгу, стили, связи и типы содержимого. Ошибки файловой системы
//   передаются вызывающему методу.
//
// Параметры:
//  Книга - Структура - проверенная книга с листами, не изменяется.
//  КаталогСборки - Строка - временный каталог с завершающим разделителем; создаёт вложенные папки и файлы.
Процедура ЗаписатьЧастиКнигиXLSX(Книга, КаталогСборки)
	СоздатьКаталог(КаталогСборки + "_rels");
	СоздатьКаталог(КаталогСборки + "xl/_rels");
	СоздатьКаталог(КаталогСборки + "xl/worksheets");
	КорневыеСвязи = "<Relationships xmlns=""http://schemas.openxmlformats.org/package/2006/relationships""><Relationship Id=""rId1"" Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument"" Target=""xl/workbook.xml""/></Relationships>";
	ЗаписатьXMLЧастьXLSX(КаталогСборки + "_rels/.rels", КорневыеСвязи);
	Стили = "<styleSheet xmlns=""http://schemas.openxmlformats.org/spreadsheetml/2006/main""><numFmts count=""1""><numFmt numFmtId=""164"" formatCode=""yyyy-mm-dd hh:mm:ss""/></numFmts><fonts count=""1""><font/></fonts><fills count=""2""><fill><patternFill patternType=""none""/></fill><fill><patternFill patternType=""gray125""/></fill></fills><borders count=""1""><border/></borders><cellStyleXfs count=""1""><xf numFmtId=""0"" fontId=""0"" fillId=""0"" borderId=""0""/></cellStyleXfs><cellXfs count=""2""><xf numFmtId=""0"" fontId=""0"" fillId=""0"" borderId=""0"" xfId=""0""/><xf numFmtId=""164"" fontId=""0"" fillId=""0"" borderId=""0"" xfId=""0"" applyNumberFormat=""1""/></cellXfs><cellStyles count=""1""><cellStyle name=""Normal"" xfId=""0"" builtinId=""0""/></cellStyles></styleSheet>";
	ЗаписатьXMLЧастьXLSX(КаталогСборки + "xl/styles.xml", Стили);
	ОписаниеКниги = Новый Массив;
	ОписаниеКниги.Добавить("<workbook xmlns=""http://schemas.openxmlformats.org/spreadsheetml/2006/main"" xmlns:r=""http://schemas.openxmlformats.org/officeDocument/2006/relationships""><workbookPr date1904=""0""/><sheets>");
	СвязиКниги = Новый Массив;
	СвязиКниги.Добавить("<Relationships xmlns=""http://schemas.openxmlformats.org/package/2006/relationships""><Relationship Id=""styles"" Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles"" Target=""styles.xml""/>");
	ТипыЧастей = Новый Массив;
	ТипыЧастей.Добавить("<Types xmlns=""http://schemas.openxmlformats.org/package/2006/content-types""><Default Extension=""rels"" ContentType=""application/vnd.openxmlformats-package.relationships+xml""/><Default Extension=""xml"" ContentType=""application/xml""/><Override PartName=""/xl/workbook.xml"" ContentType=""application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml""/><Override PartName=""/xl/styles.xml"" ContentType=""application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml""/>");
	Для ИндексЛиста = 0 По Книга.ЛистыXLSX.Количество() - 1 Цикл
		Лист = Книга.ЛистыXLSX[ИндексЛиста];
		ПроверитьЛистЗаписиXLSX(Лист);
		Номер = XMLСтрока(ИндексЛиста + 1);
		ИмяЧасти = "sheet" + Номер + ".xml";
		ИмяЛистаXML = ТекстXMLЗаписиXLSX(Лист.ИмяXLSX);
		ОписаниеКниги.Добавить("<sheet name=""" + ИмяЛистаXML + """ sheetId=""" + Номер + """ r:id=""rId" + Номер + """/>");
		СвязиКниги.Добавить("<Relationship Id=""rId" + Номер + """ Type=""http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet"" Target=""worksheets/" + ИмяЧасти + """/>");
		ТипыЧастей.Добавить("<Override PartName=""/xl/worksheets/" + ИмяЧасти + """ ContentType=""application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml""/>");
		ЗаписатьXMLЧастьXLSX(КаталогСборки + "xl/worksheets/" + ИмяЧасти, XMLЛистаЗаписиXLSX(Лист));
	КонецЦикла;
	ОписаниеКниги.Добавить("</sheets></workbook>");
	СвязиКниги.Добавить("</Relationships>");
	ТипыЧастей.Добавить("</Types>");
	ЗаписатьXMLЧастьXLSX(КаталогСборки + "xl/workbook.xml", СтрСоединить(ОписаниеКниги));
	ЗаписатьXMLЧастьXLSX(КаталогСборки + "xl/_rels/workbook.xml.rels", СтрСоединить(СвязиКниги));
	ЗаписатьXMLЧастьXLSX(КаталогСборки + "[Content_Types].xml", СтрСоединить(ТипыЧастей));
КонецПроцедуры

// Распознаёт стандартные форматы 14–22 и пользовательские форматы с yy и d.
//
// Параметры:
//  Стили - ДокументDOM - styleSheet книги.
//
// Возвращаемое значение:
//  Соответствие - строковый индекс ячейкового стиля → Истина для распознанной даты.
Функция НайтиСтилиДат(Стили)
	ФорматыДат = Новый Соответствие;
	Для ИДФормата = 14 По 22 Цикл ФорматыДат.Вставить(Формат(ИДФормата, "ЧГ=0"), Истина); КонецЦикла;
	Для Каждого ФорматXML Из Дочерние(Дочерний(Стили.ЭлементДокумента, "numFmts"), "numFmt") Цикл
		КодФормата = НРег(ФорматXML.ПолучитьАтрибут("formatCode"));
		Если СтрНайти(КодФормата, "yy") > 0 И СтрНайти(КодФормата, "d") > 0 Тогда ФорматыДат.Вставить(ФорматXML.ПолучитьАтрибут("numFmtId"), Истина); КонецЕсли;
	КонецЦикла;
	РезультатСтилей = Новый Соответствие; ИндексСтиля = 0;
	Для Каждого СтильXML Из Дочерние(Дочерний(Стили.ЭлементДокумента, "cellXfs"), "xf") Цикл
		Если ФорматыДат.Получить(СтильXML.ПолучитьАтрибут("numFmtId")) = Истина Тогда РезультатСтилей.Вставить(Формат(ИндексСтиля, "ЧГ=0"), Истина); КонецЕсли;
		ИндексСтиля = ИндексСтиля + 1;
	КонецЦикла;
	Возврат РезультатСтилей;
КонецФункции

// Ищет запись по точному имени после приведения обратных косых черт к прямым.
//
// Параметры:
//  Архив - ЧтениеZipФайла - открытый архив.
//  ИмяЧасти - Строка - разрешённое имя ZIP-части.
//
// Возвращаемое значение:
//  ЭлементZipФайла, Неопределено - найденная запись либо отсутствие.
Функция НайтиЧасть(Архив, ИмяЧасти)

	Для Каждого ЭлементZIP Из Архив.Элементы Цикл
		Если СтрЗаменить(ЭлементZIP.ПолноеИмя, "\", "/") = ИмяЧасти Тогда Возврат ЭлементZIP; КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Читает необязательную часть по типу связи и проверяет её корень. Отсутствие допустимо; повреждение
//   найденной части вызывает исключение.
//
// Параметры:
//  Архив - ЧтениеZipФайла - проверенный архив.
//  Источник - Строка - имя части книги.
//  Связи - Соответствие - связи книги.
//  Тип - Строка - короткий тип связи.
//  Корень - Строка - ожидаемое имя корня.
//  Каталог - Строка - временный каталог извлечения с завершающим разделителем.
//
// Возвращаемое значение:
//  ДокументDOM, Неопределено - прочитанная часть либо отсутствие связи.
Функция НеобязательнаяЧасть(Архив, Источник, Связи, Тип, Корень, Каталог)
	Связь = СвязьПоТипу(Связи, Тип);
	Если Связь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = ВнутренняяЧасть(Архив, Источник, Связь);
	Документ = XMLИзАрхива(Архив, Имя, Каталог);
	ПроверитьКореньXML(Документ, Корень, "http://schemas.openxmlformats.org/spreadsheetml/2006/main");
	Возврат Документ;
КонецФункции

// Завершает архив и удаляет каталог даже при ошибке завершения. Ошибки очистки возвращает текстом, не
//   скрывая их.
//
// Параметры:
//  АрхивЗаписи - ЗаписьФайлаАрхива, Неопределено - незавершённый архив.
//  КаталогСборки - Строка - временный каталог, подлежащий удалению.
//
// Возвращаемое значение:
//  Строка - сообщения ошибок с переводами строк либо пустая строка.
Функция ОчиститьРесурсыЗаписиXLSX(АрхивЗаписи, КаталогСборки)
	ОшибкиОчистки = "";
	Если АрхивЗаписи <> Неопределено Тогда
		Попытка
			АрхивЗаписи.ПолучитьДвоичныеДанные();
		Исключение
			ОшибкиОчистки = Символы.ПС + НСтр("ru = 'Ошибка закрытия архива XLSX:'")
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Попытка
		УдалитьФайлы(КаталогСборки);
	Исключение
		ОшибкиОчистки = ОшибкиОчистки + Символы.ПС + НСтр("ru = 'Ошибка удаления временного каталога XLSX:'")
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ОшибкиОчистки;
КонецФункции

// Отклоняет исключением небезопасные/повторные имена, более 1000 записей или общий размер без сжатия свыше
//   64 МиБ. Регистровые коллизии также запрещены.
//
// Параметры:
//  Архив - ЧтениеZipФайла - открытый архив; не изменяется и не закрывается.
Процедура ПроверитьАрхив(Архив)
	Если Архив.Элементы.Количество() > 1000 Тогда
		ВызватьИсключение НСтр("ru = 'Слишком много файлов в книге.'");
	КонецЕсли;
	Размер = 0;
	Имена = Новый Соответствие;
	Для Каждого Запись Из Архив.Элементы Цикл
		Имя = СтрЗаменить(Запись.ПолноеИмя, "\", "/");
		Если Прав(Имя, 1) = "/" Тогда
			Имя = Лев(Имя, СтрДлина(Имя) - 1);
		КонецЕсли;
		ПроверитьСимволыПути(Имя);
		Если Лев(Имя, 1) = "/" Тогда
			ВызватьИсключение НСтр("ru = 'Абсолютное имя ZIP-записи недопустимо.'");
		КонецЕсли;
		Для Каждого Сегмент Из СтрРазделить(Имя, "/", Истина) Цикл
			Если Сегмент = "." Или Сегмент = ".." Тогда
				ВызватьИсключение НСтр("ru = 'Недопустимое имя ZIP-записи.'");
			КонецЕсли;
		КонецЦикла;
		// Запрещаем также регистровые коллизии, не выбирая одну из двух записей.
		Ключ = НРег(Имя);
		Если Имена.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Повторяющиеся ZIP-записи в книге.'");
		КонецЕсли;
		Имена.Вставить(Ключ, Истина);
		Размер = Размер + Запись.РазмерНесжатого;
		Если Размер > 67108864 Тогда
			ВызватьИсключение НСтр("ru = 'Распакованная книга превышает 64 МБ.'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проверяет поддерживаемый тип, длину/символы строки, точность числа и нижнюю границу даты. Нарушение
//   вызывает исключение до записи ячейки.
//
// Параметры:
//  Значение - Строка, Число, Булево, Дата, Неопределено, Null - новое значение; см. УстановитьЯчейкуXLSX.
Процедура ПроверитьЗначениеЯчейкиXLSX(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или ТипЗначения = Тип("Null") Или ТипЗначения = Тип("Булево") Тогда
		Возврат;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Если СтрДлина(Значение) > 32767 Тогда
			ВызватьИсключение НСтр("ru = 'Строка XLSX превышает 32767 единиц UTF-16.'");
		КонецЕсли;
		ПроверитьТекстЗаписиXLSX(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		ТекстЧисла = СтрЗаменить(СтрЗаменить(XMLСтрока(Значение), "-", ""), ".", "");
		Пока Лев(ТекстЧисла, 1) = "0" Цикл
			ТекстЧисла = Сред(ТекстЧисла, 2);
		КонецЦикла;
		Пока Прав(ТекстЧисла, 1) = "0" Цикл
			ТекстЧисла = Лев(ТекстЧисла, СтрДлина(ТекстЧисла) - 1);
		КонецЦикла;
		Если СтрДлина(ТекстЧисла) > 15 Тогда
			ВызватьИсключение НСтр("ru = 'Число XLSX содержит более 15 значащих цифр; передайте идентификатор строкой.'");
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Значение < Дата(1900, 1, 1) Тогда
			ВызватьИсключение НСтр("ru = 'Дата XLSX должна быть не ранее 1900-01-01; для пустоты передайте Неопределено.'");
		КонецЕсли;
	Иначе
		ВызватьИсключение НСтр("ru = 'XLSX поддерживает только строку, число, булево, дату и очистку значения.'");
	КонецЕсли;
КонецПроцедуры

// Проверяет имя листа до изменения книги: длину, символы, крайние апострофы, History и пробельное имя.
//   Нарушение вызывает исключение.
//
// Параметры:
//  ИмяЛиста - Строка - предлагаемое имя листа, не изменяется; уникальность проверяется отдельно.
Процедура ПроверитьИмяЛистаXLSX(ИмяЛиста)
	Если ТипЗнч(ИмяЛиста) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Имя листа XLSX должно быть строкой.'");
	КонецЕсли;
	Если СтрДлина(ИмяЛиста) < 1 Или СтрДлина(ИмяЛиста) > 31
		Или Лев(ИмяЛиста, 1) = "'" Или Прав(ИмяЛиста, 1) = "'" Или ВРег(ИмяЛиста) = "HISTORY" Тогда
		ВызватьИсключение НСтр("ru = 'Недопустимое имя листа XLSX: длина 1..31, без крайних апострофов и имени History.'");
	КонецЕсли;
	ПроверитьТекстЗаписиXLSX(ИмяЛиста);
	ТолькоПробельные = Истина;
	Для Позиция = 1 По СтрДлина(ИмяЛиста) Цикл
		Знак = Сред(ИмяЛиста, Позиция, 1);
		Код = КодСимвола(ИмяЛиста, Позиция);
		Если СтрНайти("[]:*?/\", Знак) > 0 Или Код < 32 Или (Код >= 127 И Код <= 159) Тогда
			ВызватьИсключение НСтр("ru = 'Имя листа XLSX содержит запрещенный или управляющий символ.'");
		КонецЕсли;
		Если Не (Код = 32 Или Код = 160 Или Код = 5760 Или (Код >= 8192 И Код <= 8202)
			Или Код = 8232 Или Код = 8233 Или Код = 8239 Или Код = 8287 Или Код = 12288) Тогда
			ТолькоПробельные = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если ТолькоПробельные Тогда
		ВызватьИсключение НСтр("ru = 'Имя листа XLSX не может состоять только из пробельных символов.'");
	КонецЕсли;
КонецПроцедуры

// Отклоняет исключением значение без массива листов книги.
//
// Параметры:
//  Книга - Структура - ожидается поле ЛистыXLSX типа Массив; значение не изменяется.
Процедура ПроверитьКнигуЗаписиXLSX(Книга)
	Если ТипЗнч(Книга) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидается книга из НоваяКнигаXLSX.'");
	КонецЕсли;
	Если Не Книга.Свойство("ЛистыXLSX") Тогда
		ВызватьИсключение НСтр("ru = 'В аргументе отсутствует список листов XLSX.'");
	КонецЕсли;
	Если ТипЗнч(Книга.ЛистыXLSX) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'Список листов XLSX должен быть массивом.'");
	КонецЕсли;
КонецПроцедуры

// Отклоняет исключением нецелую или выходящую за границы координату.
//
// Параметры:
//  Координата - Число - проверяемый номер строки/колонки с единицы.
//  Максимум - Число - верхняя граница включительно.
Процедура ПроверитьКоординатуXLSX(Координата, Максимум)
	Если ТипЗнч(Координата) <> Тип("Число") Тогда
		ВызватьИсключение НСтр("ru = 'Координата XLSX должна иметь тип Число.'");
	КонецЕсли;
	Если Координата < 1 Или Координата > Максимум Или Координата <> Цел(Координата) Тогда
		ВызватьИсключение НСтр("ru = 'Координата XLSX должна быть целой и входить в границы листа.'");
	КонецЕсли;
КонецПроцедуры

// Проверяет локальное имя и пространство имён корня; несовпадение вызывает исключение.
//
// Параметры:
//  Документ - ДокументDOM - разобранная XML-часть.
//  Имя - Строка - ожидаемое имя корня.
//  Пространство - Строка - ожидаемый URI пространства имён.
Процедура ПроверитьКореньXML(Документ, Имя, Пространство)
	Корень = Документ.ЭлементДокумента;
	Если Корень.ЛокальноеИмя <> Имя Или Корень.URIПространстваИмен <> Пространство Тогда
		ВызватьИсключение НСтр("ru = 'Неподдерживаемая структура части OOXML.'");
	КонецЕсли;
КонецПроцедуры

// Отклоняет исключением значение без имени и соответствия ячеек листа.
//
// Параметры:
//  Лист - Структура - ожидаются ИмяXLSX (Строка) и ЯчейкиXLSX (Соответствие); не изменяется.
Процедура ПроверитьЛистЗаписиXLSX(Лист)
	Если ТипЗнч(Лист) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидается лист из ДобавитьЛистXLSX.'");
	КонецЕсли;
	Если Не Лист.Свойство("ИмяXLSX") Или Не Лист.Свойство("ЯчейкиXLSX") Тогда
		ВызватьИсключение НСтр("ru = 'В аргументе отсутствуют поля листа XLSX.'");
	КонецЕсли;
	Если ТипЗнч(Лист.ИмяXLSX) <> Тип("Строка") Или ТипЗнч(Лист.ЯчейкиXLSX) <> Тип("Соответствие") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректная структура листа XLSX.'");
	КонецЕсли;
КонецПроцедуры

// Запрещает неоднозначные символы пути OOXML, включая проценты, управляющие символы и двойную косую черту.
//   Ничего не декодирует; нарушение вызывает исключение.
//
// Параметры:
//  Имя - Строка - имя записи или цель связи; не изменяется.
Процедура ПроверитьСимволыПути(Имя)

	Если ПустаяСтрока(Имя) Или СтрНайти(Имя, "\") > 0 Или СтрНайти(Имя, ":") > 0
		Или СтрНайти(Имя, "?") > 0 Или СтрНайти(Имя, "#") > 0
		Или СтрНайти(Имя, "%") > 0 Или СтрНайти(Имя, "//") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Недопустимый путь части OOXML.'");
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Код = КодСимвола(Имя, Индекс);
		Если Код < 32 Или Код = 127 Тогда
			ВызватьИсключение НСтр("ru = 'Управляющий символ в пути OOXML.'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отклоняет исключением запрещённые XML 1.0 символы и непарные суррогатные единицы UTF-16.
//
// Параметры:
//  Текст - Строка - текст ячейки или имя листа; не изменяется.
Процедура ПроверитьТекстЗаписиXLSX(Текст)
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код >= 55296 И Код <= 56319 Тогда
			Если Позиция = СтрДлина(Текст) Тогда
				ВызватьИсключение НСтр("ru = 'В тексте XLSX обнаружена непарная суррогатная единица UTF-16.'");
			КонецЕсли;
			СледующийКод = КодСимвола(Текст, Позиция + 1);
			Если СледующийКод < 56320 Или СледующийКод > 57343 Тогда
				ВызватьИсключение НСтр("ru = 'В тексте XLSX обнаружена непарная суррогатная единица UTF-16.'");
			КонецЕсли;
			Позиция = Позиция + 1;
		ИначеЕсли (Код < 32 И Код <> 9 И Код <> 10 И Код <> 13)
			Или (Код >= 56320 И Код <= 57343) Или Код = 65534 Или Код = 65535 Тогда
			ВызватьИсключение НСтр("ru = 'Текст XLSX содержит символ, запрещенный XML 1.0.'");
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
КонецПроцедуры

// Проверяет по [Content_Types].xml, что workbook является обычной книгой XLSX. Неоднозначный тип или иной
//   формат вызывает исключение.
//
// Параметры:
//  Архив - ЧтениеZipФайла - проверенный архив.
//  ИмяКниги - Строка - разрешённое имя workbook.
//  Каталог - Строка - временный каталог извлечения с завершающим разделителем.
Процедура ПроверитьТипКниги(Архив, ИмяКниги, Каталог)
	Документ = XMLИзАрхива(Архив, "[Content_Types].xml", Каталог);
	ПроверитьКореньXML(Документ, "Types", "http://schemas.openxmlformats.org/package/2006/content-types");
	Переопределения = Новый Соответствие;
	ПоРасширению = Новый Соответствие;
	Для Каждого Узел Из Дочерние(Документ.ЭлементДокумента, "Override") Цикл
		Имя = Узел.ПолучитьАтрибут("PartName");
		Если Лев(Имя, 1) <> "/" Тогда
			ВызватьИсключение НСтр("ru = 'Неверное имя части в типах содержимого OOXML.'");
		КонецЕсли;
		Имя = РазрешитьЦель("", Имя);
		ДобавитьТипСодержимого(Переопределения, Имя, Узел);
	КонецЦикла;
	Для Каждого Узел Из Дочерние(Документ.ЭлементДокумента, "Default") Цикл
		ДобавитьТипСодержимого(ПоРасширению, НРег(Узел.ПолучитьАтрибут("Extension")), Узел);
	КонецЦикла;
	Тип = Переопределения.Получить(ИмяКниги);
	Если Тип = Неопределено Тогда
		ЧастиПути = СтрРазделить(ИмяКниги, "/");
		ЧастиИмени = СтрРазделить(ЧастиПути[ЧастиПути.Количество() - 1], ".");
		Если ЧастиИмени.Количество() > 1 Тогда
			Тип = ПоРасширению.Получить(НРег(ЧастиИмени[ЧастиИмени.Количество() - 1]));
		КонецЕсли;
	КонецЕсли;
	Если Тип <> "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml" Тогда
		ВызватьИсключение НСтр("ru = 'Поддерживается только незашифрованная книга XLSX (OOXML).'");
	КонецЕсли;
КонецПроцедуры

// Читает Relationships, проверяя обязательные атрибуты и уникальность Id. Повреждение вызывает исключение.
//
// Параметры:
//  Архив - ЧтениеZipФайла - проверенный открытый архив.
//  Имя - Строка - имя части связей в ZIP.
//  Каталог - Строка - временный каталог для извлечения с завершающим разделителем.
//
// Возвращаемое значение:
//  Соответствие - Id → Структура (Тип, Цель, Режим); отсутствующий TargetMode означает Internal.
Функция ПрочитатьСвязи(Архив, Имя, Каталог)
	Документ = XMLИзАрхива(Архив, Имя, Каталог);
	Пространство = "http://schemas.openxmlformats.org/package/2006/relationships";
	ПроверитьКореньXML(Документ, "Relationships", Пространство);
	Результат = Новый Соответствие;
	Для Каждого Узел Из Дочерние(Документ.ЭлементДокумента, "Relationship") Цикл
		ИД = Узел.ПолучитьАтрибут("Id");
		Тип = Узел.ПолучитьАтрибут("Type");
		Цель = Узел.ПолучитьАтрибут("Target");
		Если Узел.URIПространстваИмен <> Пространство Или ПустаяСтрока(ИД)
			Или ПустаяСтрока(Тип) Или ПустаяСтрока(Цель) Или Результат.Получить(ИД) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Поврежденные или неоднозначные связи OOXML.'");
		КонецЕсли;
		АтрибутРежима = Узел.Атрибуты.ПолучитьИменованныйЭлемент("TargetMode");
		Режим = "Internal";
		Если АтрибутРежима <> Неопределено Тогда
			Режим = АтрибутРежима.Значение;
		КонецЕсли;
		Результат.Вставить(ИД, Новый Структура("Тип,Цель,Режим", Тип, Цель, Режим));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получает разрешённую ZIP-часть листа по r:id из workbook.
//
// Параметры:
//  Связи - Соответствие - ПутиЛистов результата ЧастиКнигиXLSX.
//  ЛистКниги - ЭлементDOM - элемент sheet книги.
//
// Возвращаемое значение:
//  Строка, Неопределено - имя части либо отсутствие соответствия.
Функция ПутьЛиста(Связи, ЛистКниги)
	ИД = ЛистКниги.ПолучитьАтрибут("http://schemas.openxmlformats.org/officeDocument/2006/relationships", "id");
	Возврат Связи.Получить(ИД);
КонецФункции

// Разрешает . и .. относительно части-источника либо корня пакета. Пустой сегмент и выход за корень
//   вызывают исключение.
//
// Параметры:
//  Источник - Строка - имя ZIP-части, пусто для корня.
//  Цель - Строка - Target связи; при корневой цели удаляет начальную косую черту в параметре.
//   После проверки символов удаляет начальный / из самой переданной переменной, если он есть; изменение сохраняется при последующей ошибке пути.
//
// Возвращаемое значение:
//  Строка - нормализованное внутреннее имя ZIP-части.
Функция РазрешитьЦель(Источник, Цель)
	ПроверитьСимволыПути(Цель);
	РезультатПути = Новый Массив;
	Если Лев(Цель, 1) = "/" Тогда
		Цель = Сред(Цель, 2);
	ИначеЕсли Не ПустаяСтрока(Источник) Тогда
		Части = СтрРазделить(Источник, "/");
		Для Индекс = 0 По Части.Количество() - 2 Цикл
			РезультатПути.Добавить(Части[Индекс]);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(Цель, "/", Истина) Цикл
		Если ПустаяСтрока(Сегмент) Тогда
			ВызватьИсключение НСтр("ru = 'Пустой сегмент пути OOXML.'");
		ИначеЕсли Сегмент = ".." Тогда
			Если РезультатПути.Количество() = 0 Тогда
				ВызватьИсключение НСтр("ru = 'Выход за корень пакета OOXML.'");
			КонецЕсли;
			РезультатПути.Удалить(РезультатПути.Количество() - 1);
		ИначеЕсли Сегмент <> "." Тогда
			РезультатПути.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;
	Если РезультатПути.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не задана часть OOXML.'");
	КонецЕсли;
	Возврат СтрСоединить(РезультатПути, "/");
КонецФункции

// Выбирает единственную связь заданного типа. Повтор и отсутствие обязательной связи вызывают исключение.
//
// Параметры:
//  Связи - Соответствие - результат ПрочитатьСвязи.
//  ИмяТипа - Строка - короткое имя типа для ТипСвязи.
//  Обязательная - Булево - запрещает отсутствие связи.
//
// Возвращаемое значение:
//  Структура, Неопределено - Тип, Цель, Режим найденной связи либо отсутствие.
Функция СвязьПоТипу(Связи, ИмяТипа, Обязательная = Ложь)
	Результат = Неопределено;
	Для Каждого Элемент Из Связи Цикл
		Если Элемент.Значение.Тип = ТипСвязи(ИмяТипа) Тогда
			Если Результат <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Неоднозначный тип связи OOXML.'");
			КонецЕсли;
			Результат = Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Обязательная И Результат = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Отсутствует необходимая связь OOXML.'");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Защищает буквальные _xHHHH_ и XML-символы, сохраняя переводы строк и табуляцию.
//
// Параметры:
//  Текст - Строка - проверенный текст ячейки или имени.
//
// Возвращаемое значение:
//  Строка - текст для включения в XML; CR кодируется по ST_Xstring, LF/TAB — ссылками XML.
Функция ТекстXMLЗаписиXLSX(Текст)
	Фрагменты = Новый Массив;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если Знак = "_" И Сред(Текст, Позиция + 1, 1) = "x"
			И Сред(Текст, Позиция + 6, 1) = "_" Тогда
			ЭтоEscape = Истина;
			Для Смещение = 2 По 5 Цикл
				Если СтрНайти("0123456789abcdef", НРег(Сред(Текст, Позиция + Смещение, 1))) = 0 Тогда
					ЭтоEscape = Ложь;
				КонецЕсли;
			КонецЦикла;
			Если ЭтоEscape Тогда Знак = "_x005F_"; КонецЕсли;
		КонецЕсли;
		Фрагменты.Добавить(Знак);
	КонецЦикла;
	Результат = СтрСоединить(Фрагменты);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&apos;");
	Результат = СтрЗаменить(Результат, Символ(13), "_x000D_");
	Результат = СтрЗаменить(Результат, Символ(10), "&#10;");
	Возврат СтрЗаменить(Результат, Символ(9), "&#9;");
КонецФункции

// Дополняет короткое имя типа связи пространством Transitional OOXML.
//
// Параметры:
//  Имя - Строка - officeDocument, worksheet, styles или sharedStrings.
//
// Возвращаемое значение:
//  Строка - полный URI типа связи.
Функция ТипСвязи(Имя)
	Возврат "http://schemas.openxmlformats.org/officeDocument/2006/relationships/" + Имя;
КонецФункции

// Декодирует присутствующие строки XML-листа, не вычисляя формулы и не преобразуя числовой текст в число.
// Неверное имя или пространство имён корневого элемента вызывает исключение; без sheetData возвращает
// пустой массив. Проверки адреса, порядка строк и индекса общей строки могут вызвать исключение;
// частичный массив тогда не возвращается. Некорректная серийная дата даёт пустую СохраненнаяДата.
// Входные значения не изменяет.
//
// Параметры:
//  ЛистXML - ДокументDOM - worksheet в пространстве имён Transitional OOXML; строки по возрастанию до 20000.
//  ОбщиеСтроки - Массив из Строка - таблица sharedStrings для ячеек типа s.
//  СтилиДат - Соответствие - строковый индекс стиля → Истина для распознанного формата даты.
//  Даты1904 - Булево - система дат workbook: Истина для 1904, Ложь для 1900.
//
// Возвращаемое значение:
//  Массив из Структура - только присутствующие строки в порядке XML:
//   * Номер - Число - исходный номер строки.
//   * Ячейки - Соответствие - буквы колонки → Структура ячейки:
//     * Текст - Строка - исходное v, общая строка либо текст inlineStr; серийная дата и экспонента остаются текстом.
//     * НетКэша - Булево - есть формула без непустого v.
//     * ОшибкаExcel - Булево - тип ячейки e.
//     * Адрес - Строка - исходный адрес ячейки.
//     * Формула - Булево - есть элемент f; формула не вычисляется.
//     * СохраненнаяДата - Строка - dd.MM.yyyy либо пусто; используется существующая ДатаExcel.
//     * Числовая - Булево - тип отсутствует либо n; это признак, а не результат разбора числа.
Функция ПрочитатьМатрицу(ЛистXML, ОбщиеСтроки, СтилиДат, Даты1904)
	Если ЛистXML.ЭлементДокумента.ЛокальноеИмя <> "worksheet" Или ЛистXML.ЭлементДокумента.URIПространстваИмен <> "http://schemas.openxmlformats.org/spreadsheetml/2006/main" Тогда
		ВызватьИсключение "Неподдерживаемая структура листа.";
	КонецЕсли;
	Матрица = Новый Массив;
	ПредыдущаяСтрока = 0;
	Для Каждого УзелСтроки Из Дочерние(Дочерний(ЛистXML.ЭлементДокумента, "sheetData"), "row") Цикл
		НомерСтроки = Число(УзелСтроки.ПолучитьАтрибут("r"));
		Если НомерСтроки <= ПредыдущаяСтрока Или НомерСтроки > 20000 Тогда ВызватьИсключение "Некорректный номер или слишком много строк листа."; КонецЕсли;
		ПредыдущаяСтрока = НомерСтроки;
		Ячейки = Новый Соответствие;
		Для Каждого УзелЯчейки Из Дочерние(УзелСтроки, "c") Цикл
			АдресЯчейки = УзелЯчейки.ПолучитьАтрибут("r");
			Колонка = БуквыКолонки(АдресЯчейки);
			Если Сред(АдресЯчейки, СтрДлина(Колонка) + 1) <> Формат(НомерСтроки, "ЧГ=0") Тогда ВызватьИсключение "Адрес ячейки не соответствует строке."; КонецЕсли;
			Если Ячейки.Получить(Колонка) <> Неопределено Тогда ВызватьИсключение "Повторяющиеся ячейки листа."; КонецЕсли;
			УзелЗначения = Дочерний(УзелЯчейки, "v");
			Сырое = ?(УзелЗначения = Неопределено, "", УзелЗначения.ТекстовоеСодержимое);
			ТипЯчейки = УзелЯчейки.ПолучитьАтрибут("t");
			НетКэша = Дочерний(УзелЯчейки, "f") <> Неопределено И (УзелЗначения = Неопределено Или ПустаяСтрока(Сырое));
			Если ТипЯчейки = "s" И Не НетКэша Тогда
				ИндексСтроки = Число(Сырое);
				Если ИндексСтроки < 0 Или ИндексСтроки >= ОбщиеСтроки.Количество() Тогда ВызватьИсключение "Поврежденная таблица строк книги."; КонецЕсли;
				Сырое = ОбщиеСтроки[ИндексСтроки];
			ИначеЕсли ТипЯчейки = "inlineStr" Тогда
				Сырое = ТекстУзлов(Дочерний(УзелЯчейки, "is"));
			КонецЕсли;
			СохраненнаяДата = "";
			Если СтилиДат.Получить(УзелЯчейки.ПолучитьАтрибут("s")) = Истина И Не НетКэша Тогда
				СохраненнаяДата = ДатаExcel(Сырое, Даты1904);
			КонецЕсли;
			Ячейки.Вставить(Колонка, Новый Структура("Текст,НетКэша,ОшибкаExcel,Адрес,Формула,СохраненнаяДата,Числовая", Сырое, НетКэша, ТипЯчейки = "e", АдресЯчейки, Дочерний(УзелЯчейки, "f") <> Неопределено, СохраненнаяДата, ТипЯчейки = Неопределено Или ТипЯчейки = "n"));
		КонецЦикла;
		Матрица.Добавить(Новый Структура("Номер,Ячейки", НомерСтроки, Ячейки));
	КонецЦикла;
	Возврат Матрица;
КонецФункции

#КонецОбласти
