// Функция удаляет набор записей регистра сведений.
//
// Параметры:
//  НаборЗаписей   - РегистрСведенийНаборЗаписей.
//   Удаляет строки из самого переданного набора в памяти с конца. Набор не записывает в базу; при последующей ошибке уведомления уже удалённые строки не восстанавливает.
//  РежимСообщений - Строка - "Нет", "Все", "Ошибки".
//
// Возвращаемое значение:
//  Булево - действие выполнено.
//
Функция УдалитьНаборЗаписейРегистра(НаборЗаписей, РежимСообщений="Ошибки") Экспорт

		ДействиеВыполнено  = Ложь;
		РежимыВывода = ОпределитьРежимыВывода(РежимСообщений);
		ТекстВыполнено = НСтр("ru='Набор записей ""%1"" удален.';");
		ТекстЖР = НСтр("ru='МЯМ.ОшибкаУдаленияНабораЗаписейРегистра';");

		Попытка
			НомерПоследнейЗаписи = НаборЗаписей.Количество() - 1;
			Пока НомерПоследнейЗаписи >= 0 Цикл
				НаборЗаписей.Удалить(НаборЗаписей[НомерПоследнейЗаписи]);
				НомерПоследнейЗаписи = НомерПоследнейЗаписи - 1;
			КонецЦикла;
			ДействиеВыполнено = Истина;
			Если РежимыВывода.ВыводитьИнформацию Тогда
				ТекстВыполнено = СтрШаблон(ТекстВыполнено, НаборЗаписей.Метаданные().ПолноеИмя());
				ОбщегоНазначения.СообщитьПользователю(ТекстВыполнено);
			КонецЕсли;

		Исключение
			ДействиеВыполнено = Ложь;
			Если РежимыВывода.ВыводитьОшибки Тогда ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецЕсли;
			ЗаписьЖурналаРегистрации(ТекстЖР, мямЖурналРегистрацииКлиентСервер.УровеньЖурналаРегистрацииИнформация(),,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		Возврат ДействиеВыполнено;

	КонецФункции

