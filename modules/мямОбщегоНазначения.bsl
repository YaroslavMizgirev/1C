// Возвращает тип значения доступной предопределённой характеристики найденного плана. Имя проверяет через
//   коллекцию метаданных; чтение выполняет с обычными правами/RLS. Неизвестный план, отказ доступа или
//   отсутствие характеристики вызывает исключение.
//
// Параметры:
//  ИмяПланаВидовХарактеристик - Строка - имя существующего плана, не фрагмент запроса.
//  ИмяПредопределенныхДанных - Строка - имя предопределённого элемента плана; передаётся параметром запроса.
//
// Возвращаемое значение:
//  ОписаниеТипов - тип значения найденной характеристики.
Функция ОписаниеТипаПредопределеннойХарактеристики(ИмяПланаВидовХарактеристик,ИмяПредопределенныхДанных) Экспорт

		ПланМетаданных = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПланаВидовХарактеристик);
        Если ПланМетаданных = Неопределено Тогда
            ВызватьИсключение "План видов характеристик не найден.";
        КонецЕсли;
        ВыполнитьПроверкуПравДоступа("Чтение", ПланМетаданных);

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	%1 КАК Т
		|ГДЕ
		|	Т.Предопределенный
		|	И Т.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
		Запрос.Текст = СтрШаблон(Запрос.Текст, "ПланВидовХарактеристик." + ПланМетаданных.Имя);
		Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенныхДанных);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			Возврат ВыборкаЗапроса.Ссылка.ТипЗначения;
		КонецЦикла;

		ТекстСообщения = НСтр("ru='Неопределено имя предопределенных данных';");
		ВызватьИсключение ТекстСообщения;

	КонецФункции

