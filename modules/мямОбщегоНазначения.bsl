#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Фильтрует список объектов по представлению через ПОДОБНО и возвращает совпадения в порядке синонима. Символы
//   шаблона в тексте поиска сохраняют смысл.
//
// Параметры:
//  СписокВыбораОбъектаМетаданных - СписокЗначений - имена и представления исходных объектов; не изменяется.
//  Текст - Строка - фрагмент или шаблон поиска по представлению.
//
// Возвращаемое значение:
//  СписокЗначений - имена и представления совпавших объектов; пустой при отсутствии совпадений.
Функция СформироватьДанныеВыбораМетаданных(Знач СписокВыбораОбъектаМетаданных,Текст) Экспорт

		СписокВыбора = Новый СписокЗначений;

		ТаблицаВыбора = Новый ТаблицаЗначений;
		ТаблицаВыбора.Колонки.Добавить("ИмяОбъекта", мямОбщегоНазначенияКлиентСервер.ОписаниеТипаСтрока(255));
		ТаблицаВыбора.Колонки.Добавить("СинонимОбъекта", мямОбщегоНазначенияКлиентСервер.ОписаниеТипаСтрока(500));
		Для Каждого ЭлементВыбора Из СписокВыбораОбъектаМетаданных Цикл
			НоваяСтрока = ТаблицаВыбора.Добавить();
			НоваяСтрока.ИмяОбъекта = ЭлементВыбора.Значение;
			НоваяСтрока.СинонимОбъекта = ЭлементВыбора.Представление;
		КонецЦикла;
		Если ТаблицаВыбора.Количество() = 0 Тогда Возврат СписокВыбора; КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТЗ.ИмяОбъекта КАК ИмяОбъекта,
		|	ТЗ.СинонимОбъекта КАК СинонимОбъекта
		|ПОМЕСТИТЬ ВТ_Объекты
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Объекты.ИмяОбъекта КАК ИмяОбъекта,
		|	ВТ_Объекты.СинонимОбъекта КАК СинонимОбъекта
		|ИЗ
		|	ВТ_Объекты КАК ВТ_Объекты
		|ГДЕ
		|	ВТ_Объекты.СинонимОбъекта ПОДОБНО &СтрокаПоиска
		|
		|УПОРЯДОЧИТЬ ПО
		|	СинонимОбъекта";
		Запрос.УстановитьПараметр("ТЗ", ТаблицаВыбора);
		Запрос.УстановитьПараметр("СтрокаПоиска", "%" + Текст + "%");
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаИзРезультатаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаИзРезультатаЗапроса.Следующий() Цикл
			СписокВыбора.Добавить(ВыборкаИзРезультатаЗапроса.ИмяОбъекта, ВыборкаИзРезультатаЗапроса.СинонимОбъекта);
		КонецЦикла;

		Возврат СписокВыбора;

	КонецФункции

#КонецЕсли

