// Выполняет проверку заполнения объекта.
//
// Параметры:
//  ТекущийОбъект - Объект проверки.
//  ВыводитьОшибки - Булево - необходимость вывода сообщения.
//  РежимЗаписи - РежимЗаписиДокумента.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПроверитьЗаполнение(ТекущийОбъект,ВыводитьОшибки,РежимЗаписи)

		Успех = Истина;
		Если ТекущийОбъект.ОбменДанными.Загрузка Тогда Возврат Успех; КонецЕсли;

		Если ТекущийОбъект.Метаданные().Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			// Перед проведением вызываем проверку заполнения.
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Успех = ТекущийОбъект.ПроверитьЗаполнение();
			КонецЕсли;
		Иначе
			// Перед записью, если проведение не поддерживается, вызываем проверку заполнения.
			Успех = ТекущийОбъект.ПроверитьЗаполнение();
		КонецЕсли;

		Если НЕ Успех И ВыводитьОшибки Тогда
			// Ошибка проверки заполнения признана некритической. Сообщение не выводим.
			ШаблонСоообщения = НСтр("ru='При проверке заполнения данных произошли ошибки ""%1""';en='When checking the completion of the data occurred error ""%1""'");
			ТекстСообщения = СтрШаблон(ШаблонСоообщения, ТекущийОбъект.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;

		Возврат Успех;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Собирает стандартные и прикладные реквизиты уже найденной табличной части; прикладные значения не читает.
//
// Параметры:
//  ТабличнаяЧастьОбъектаМетаданных - ОбъектМетаданных - табличная часть выбранного объекта.
//
// Возвращаемое значение:
//  СписокЗначений - путь реквизита и его представление; для отсутствующих коллекций список пуст.
Функция СписокРеквизитовТабличнойЧастиОбъекта(ТабличнаяЧастьОбъектаМетаданных)

		СписокРеквизитовТабличнойЧасти = Новый СписокЗначений;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабличнаяЧастьОбъектаМетаданных, "СтандартныеРеквизиты") Тогда
			Для Каждого СтандартныйРеквизитТабличнойЧасти Из ТабличнаяЧастьОбъектаМетаданных.СтандартныеРеквизиты Цикл
				СписокРеквизитовТабличнойЧасти.Добавить("СтандартныйРеквизит."+СтандартныйРеквизитТабличнойЧасти.Имя, СтрШаблон(НСтр("ru='Стандартный реквизит ""%1%2""';en='Standard requisite ""%1%2""';"), СтандартныйРеквизитТабличнойЧасти.Имя, ?(ПустаяСтрока(СтандартныйРеквизитТабличнойЧасти.Синоним), "", ": "+СтандартныйРеквизитТабличнойЧасти.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабличнаяЧастьОбъектаМетаданных, "Реквизиты") Тогда
			Для Каждого РеквизитТабличнойЧасти Из ТабличнаяЧастьОбъектаМетаданных.Реквизиты Цикл
				МассивЭлементов = СтрРазделить(РеквизитТабличнойЧасти.ПолноеИмя(), ".", Ложь);
				СписокРеквизитовТабличнойЧасти.Добавить(МассивЭлементов[МассивЭлементов.ВГраница()-1]+"."+МассивЭлементов[МассивЭлементов.ВГраница()], СтрШаблон(НСтр("ru='Реквизит ""%1%2""';en='Requisite ""%1%2""';"), РеквизитТабличнойЧасти.Имя, ?(ПустаяСтрока(РеквизитТабличнойЧасти.Синоним), "", ": "+РеквизитТабличнойЧасти.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Возврат СписокРеквизитовТабличнойЧасти;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Собирает поля найденного объекта метаданных, включая применимые общие реквизиты и табличные части.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - найденный объект, например справочник или регистр.
//
// Возвращаемое значение:
//  СписокЗначений - путь поля и представление; состав зависит от вида объекта.
Функция СписокРеквизитовТабличныхЧастейОбъекта(ОбъектМетаданных)

		СписокРеквизитТабличнаяЧасть = Новый СписокЗначений;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектМетаданных, "СтандартныеРеквизиты") Тогда
			Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
				СписокРеквизитТабличнаяЧасть.Добавить("СтандартныйРеквизит."+СтандартныйРеквизит.Имя, СтрШаблон(НСтр("ru='Стандартный реквизит ""%1%2""';en='Standard requisite ""%1%2""';"), СтандартныйРеквизит.Имя, ?(ПустаяСтрока(СтандартныйРеквизит.Синоним), "", ": "+СтандартныйРеквизит.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
			ЭлементСоставаОбщегоРеквизита = ОбщийРеквизит.Состав.Найти(ОбъектМетаданных);
			Если ЭлементСоставаОбщегоРеквизита <> Неопределено И (ЭлементСоставаОбщегоРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Или (ЭлементСоставаОбщегоРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто И ОбщийРеквизит.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать)) Тогда
				СписокРеквизитТабличнаяЧасть.Добавить(ОбщийРеквизит.ПолноеИмя(), СтрШаблон(НСтр("ru='Общий реквизит ""%1%2""';en='Common requisite ""%1%2""';"), ОбщийРеквизит.Имя, ?(ПустаяСтрока(ОбщийРеквизит.Синоним), "", ": "+ОбщийРеквизит.Синоним)));
			КонецЕсли;
		КонецЦикла;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектМетаданных, "Измерения") Тогда
			Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
				МассивЭлементов = СтрРазделить(Измерение.ПолноеИмя(), ".", Ложь);
				СписокРеквизитТабличнаяЧасть.Добавить(МассивЭлементов[МассивЭлементов.ВГраница()-1]+"."+МассивЭлементов[МассивЭлементов.ВГраница()], СтрШаблон(НСтр("ru='Измерение ""%1%2""';en='Measurement ""%1%2""';"), Измерение.Имя, ?(ПустаяСтрока(Измерение.Синоним), "", ": "+Измерение.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектМетаданных, "Ресурсы") Тогда
			Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
				МассивЭлементов = СтрРазделить(Ресурс.ПолноеИмя(), ".", Ложь);
				СписокРеквизитТабличнаяЧасть.Добавить(МассивЭлементов[МассивЭлементов.ВГраница()-1]+"."+МассивЭлементов[МассивЭлементов.ВГраница()], СтрШаблон(НСтр("ru='Ресурс ""%1%2""';en='Resource ""%1%2""';"), Ресурс.Имя, ?(ПустаяСтрока(Ресурс.Синоним), "", ": "+Ресурс.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектМетаданных, "Реквизиты") Тогда
			Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
				МассивЭлементов = СтрРазделить(Реквизит.ПолноеИмя(), ".", Ложь);
				СписокРеквизитТабличнаяЧасть.Добавить(МассивЭлементов[МассивЭлементов.ВГраница()-1]+"."+МассивЭлементов[МассивЭлементов.ВГраница()], СтрШаблон(НСтр("ru='Реквизит ""%1%2""';en='Requisite ""%1%2""';"), Реквизит.Имя, ?(ПустаяСтрока(Реквизит.Синоним), "", ": "+Реквизит.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектМетаданных, "ТабличныеЧасти") Тогда
			Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
				МассивЭлементов = СтрРазделить(ТабличнаяЧасть.ПолноеИмя(), ".", Ложь);
				СписокРеквизитТабличнаяЧасть.Добавить(МассивЭлементов[МассивЭлементов.ВГраница()-1]+"."+МассивЭлементов[МассивЭлементов.ВГраница()], СтрШаблон(НСтр("ru='Табличная часть ""%1%2""';en='Tabular section ""%1%2""';"), МассивЭлементов[МассивЭлементов.ВГраница()], ?(ПустаяСтрока(ТабличнаяЧасть.Синоним), "", ": "+ТабличнаяЧасть.Синоним)));
			КонецЦикла;
		КонецЕсли;

		Возврат СписокРеквизитТабличнаяЧасть;

	КонецФункции

#КонецЕсли

#КонецОбласти
