// Возвращает метаданные реквизита по каноническому пути, сохраненному
// в реквизите ЗаполняемыйРеквизит справочника мямЗначенияПоУмолчанию.
//
// Параметры:
//  ПутьРеквизита - Строка.
//
// Возвращаемое значение:
//  ОбъектМетаданных - Неопределено, если путь не распознан.
//
Функция РеквизитМетаданныхПоПути(ПутьРеквизита) Экспорт

		МассивЭлементов = СтрРазделить(ПутьРеквизита, ".", Ложь);
		Если МассивЭлементов.Количество() < 2 Тогда
			Возврат Неопределено;
		КонецЕсли;

		ИндексОбщегоРеквизита = МассивЭлементов.Найти("ОбщийРеквизит");
		Если ИндексОбщегоРеквизита <> Неопределено Тогда
			Если ИндексОбщегоРеквизита + 1 >= МассивЭлементов.Количество() Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Метаданные.ОбщиеРеквизиты[МассивЭлементов[ИндексОбщегоРеквизита + 1]];
		КонецЕсли;

		ИндексСтандартногоРеквизита = МассивЭлементов.Найти("СтандартныйРеквизит");
		Если ИндексСтандартногоРеквизита <> Неопределено Тогда
			Если ИндексСтандартногоРеквизита + 1 >= МассивЭлементов.Количество() Тогда
				Возврат Неопределено;
			КонецЕсли;

			ИмяТабличнойЧасти = ИмяТабличнойЧастиЦели(ПутьРеквизита);
			Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
				ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(МассивЭлементов[0] + "." + МассивЭлементов[1]);
			Иначе
				ПолноеИмяТабличнойЧасти = МассивЭлементов[0] + "." + МассивЭлементов[1]
					+ ".ТабличнаяЧасть." + ИмяТабличнойЧасти;
				ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТабличнойЧасти);
			КонецЕсли;

			Если ОбъектМетаданных = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат ОбъектМетаданных.СтандартныеРеквизиты[МассивЭлементов[ИндексСтандартногоРеквизита + 1]];
		КонецЕсли;

		Возврат Метаданные.НайтиПоПолномуИмени(ПутьРеквизита);

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Процедура - Рекурсивное заполнение таблицы значений.
//
// Параметры:
//  ТаблицаЗначений  - ТаблицаЗначений.
//   Дополняет переданную таблицу строками потомков дерева рекурсивно; существующие строки сохраняет, изменения выполняются по мере обхода.
//  СтрокаДерева   - СтрокаДереваЗначений.
//
Процедура РекурсивноеЗаполнениеТаблицыЗначений(ТаблицаЗначений, СтрокаДерева) Экспорт

		Для Каждого Строка Из СтрокаДерева.Строки Цикл
			НоваяСтрока = ТаблицаЗначений.Добавить();
			Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = Строка[Колонка.Имя];
			КонецЦикла;
			РекурсивноеЗаполнениеТаблицыЗначений(ТаблицаЗначений, Строка);
		КонецЦикла;

	КонецПроцедуры

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Собирает объекты выбранной категории и сортирует по представлению. Прикладные записи не читает.
//
// Параметры:
//  ТипМетаданных - Строка - имя коллекции метаданных во множественном числе, например Справочники.
//
// Возвращаемое значение:
//  СписокЗначений - имя объекта и его синоним, по возрастанию представления.
Функция СписокОбъектовМетаданных(ТипМетаданных) Экспорт

		СписокОбъектовМетаданных = Новый СписокЗначений;
		Для Каждого ЭлементМетаданных Из Метаданные[ТипМетаданных] Цикл
			СписокОбъектовМетаданных.Добавить(ЭлементМетаданных.Имя, ЭлементМетаданных.Синоним);
		КонецЦикла;
		СписокОбъектовМетаданных.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
		Возврат СписокОбъектовМетаданных;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Находит табличную часть по именам и возвращает доступные в её метаданных реквизиты.
//
// Параметры:
//  ТипМетаданных - Строка - имя коллекции метаданных во множественном числе, например Справочники.
//  ИмяОбъектаМетаданных - Строка - имя объекта в выбранной коллекции.
//  ИмяТабличнойЧасти - Строка - имя табличной части объекта.
//
// Возвращаемое значение:
//  СписокЗначений - пути стандартных и прикладных реквизитов табличной части с представлениями.
Функция СписокРеквизитовТабличнойЧасти(ТипМетаданных,ИмяОбъектаМетаданных,ИмяТабличнойЧасти) Экспорт

		ТабличнаяЧастьОбъектаМетаданных = Метаданные.НайтиПоПолномуИмени(ТипМетаданныхЕдинственноеЧисло(ТипМетаданных)+"."+ИмяОбъектаМетаданных+"."+ИмяТабличнойЧасти);
		Возврат СписокРеквизитовТабличнойЧастиОбъекта(ТабличнаяЧастьОбъектаМетаданных);

	КонецФункции

