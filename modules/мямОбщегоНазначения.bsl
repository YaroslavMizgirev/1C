#Область ПрограммныйИнтерфейс

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Собирает поддерживаемые категории метаданных для списка выбора, не читая прикладные данные.
//
// Возвращаемое значение:
//  СписокЗначений - значение: имя коллекции; представление: локализованное название категории.
Функция ВсеТипыМетаданных() Экспорт

		МассивМетаданных = Новый СписокЗначений;
		МассивМетаданных.Добавить("Справочники", НСтр("ru='Справочник';en='Catalog';"));
		МассивМетаданных.Добавить("Документы", НСтр("ru='Документ';en='Document';"));
		МассивМетаданных.Добавить("Обработки", НСтр("ru='Обработка';en='Processing';"));
		МассивМетаданных.Добавить("ПланыВидовХарактеристик", НСтр("ru='План видов характеристик';en='Plan of views of characteristics';"));
		МассивМетаданных.Добавить("ПланыВидовРасчета", НСтр("ru='План видов расчета';en='Plan of views of calculation';"));
		МассивМетаданных.Добавить("РегистрыСведений", НСтр("ru='Регистр сведений';en='Register of information';"));
		МассивМетаданных.Добавить("РегистрыНакопления", НСтр("ru='Регистр накопления';en='Register of accumulation';"));
		МассивМетаданных.Добавить("РегистрыБухгалтерии", НСтр("ru='Регистр бухгалтерии';en='Register of accounting';"));
		МассивМетаданных.Добавить("РегистрыРасчета", НСтр("ru='Регистр расчета';en='Register of calculation';"));
		МассивМетаданных.Добавить("БизнесПроцессы", НСтр("ru='Бизнес-процесс';en='Business process';"));
		МассивМетаданных.Добавить("Задачи", НСтр("ru='Задача';en='Task';"));
		Возврат МассивМетаданных;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Функция - Данные формы коллекция в массив полностью.
//
// Параметры:
//  ТабличнаяЧасть  - ДанныеФормыКоллекция.
//
// Возвращаемое значение:
//   - Массив Из Структура - коллекция строк таблицы в виде структур.
//
Функция ДанныеФормыКоллекцияВМассивПолностью(ТабличнаяЧасть) Экспорт

		Возврат ТаблицаЗначенийВМассив(ДанныеФормыКоллекцияВТаблицуЗначенийПолностью(ТабличнаяЧасть));

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Функция - Данные формы коллекция в таблицу значений полностью.
//
// Параметры:
//  ТабличнаяЧасть  - ДанныеФормыКоллекция.
//
// Возвращаемое значение:
//   - ТаблицаЗначений.
//
Функция ДанныеФормыКоллекцияВТаблицуЗначенийПолностью(ТабличнаяЧасть) Экспорт

		ТЗ_Результат = ТабличнаяЧасть.Выгрузить();
		Возврат ТЗ_Результат;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Функция - Дерево значений в таблицу значений.
//
// Параметры:
//  ДеревоЗначений - ДеревоЗначений.
//
// Возвращаемое значение:
//   - ТаблицаЗначений.
//
Функция ДеревоЗначенийВТаблицуЗначений(Знач ДеревоЗначений) Экспорт

		ТаблицаЗначений = Новый ТаблицаЗначений;

		Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
			ТаблицаЗначений.Колонки.Добавить(Колонка.Имя);
		КонецЦикла;

		Для Каждого Строка Из ДеревоЗначений.Строки Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Строка);
			Если Строка.Строки.Количество () = 0 Тогда
				Продолжить;
			Иначе
				РекурсивноеЗаполнениеТаблицыЗначений(ТаблицаЗначений, Строка);
			КонецЕсли;
		КонецЦикла;

		Возврат ТаблицаЗначений;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Функция записывет набор записей регистра сведений.
//
// Параметры:
//  НаборЗаписей   - РегистрСведенийНаборЗаписей.
//   Переданный набор записывается в информационную базу; результат и обработка ошибок описаны в возвращаемом значении.
//  РежимСообщений - Строка - "Нет", "Все", "Ошибки".
//
// Возвращаемое значение:
//  Булево - действие выполнено.
//
Функция ЗаписатьНаборЗаписейРегистра(НаборЗаписей,РежимСообщений="Ошибки") Экспорт

		ДействиеВыполнено  = Ложь;
		РежимыВывода = ОпределитьРежимыВывода(РежимСообщений);
		ТекстВыполнено = НСтр("ru='Набор записей ""%1"" записан.';");
		ТекстЖР = НСтр("ru='МЯМ.ОшибкаЗаписиНабораЗаписейРегистра';");

		Попытка
			НаборЗаписей.Записать();
			ДействиеВыполнено = Истина;
			Если РежимыВывода.ВыводитьИнформацию Тогда
				ТекстВыполнено = СтрШаблон(ТекстВыполнено, НаборЗаписей.Метаданные().ПолноеИмя());
				ОбщегоНазначения.СообщитьПользователю(ТекстВыполнено);
			КонецЕсли;

		Исключение
			ДействиеВыполнено = Ложь;
			Если РежимыВывода.ВыводитьОшибки Тогда ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецЕсли;
			ЗаписьЖурналаРегистрации(ТекстЖР, мямЖурналРегистрацииКлиентСервер.УровеньЖурналаРегистрацииИнформация(),,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		Возврат ДействиеВыполнено;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Процедура выполняет запись/проведение/отмену проведения документа.
//
// Параметры:
//  ТекущийОбъект - ДокументОбъект,СправочникОбъект.
//   Переданный объект записывается в выбранном режиме; при попытке записи могут выполняться обработчики объекта, даже если запись завершится ошибкой.
//  РежимЗаписи - РежимЗаписиДокумента.
//  Заголовок - Строка, Булево - (По умолчанию = "").
//  РежимСообщений - Строка - "Нет","Все","Ошибки" Булево (По умолчанию = "Все").
//  ЗаписыватьПередПроведением - Булево - По умолчанию = Истина.
//  ПроверятьЗаполнение - Булево - По умолчанию = Истина.
//
// Возвращаемое значение:
//   Булево - действие выполнено.
//
Функция ЗаписатьПровестиДокумент(ТекущийОбъект,РежимЗаписи,Заголовок="",РежимСообщений="Ошибки",ЗаписыватьПередПроведением=Истина,ПроверятьЗаполнение=Истина) Экспорт

		ДействиеВыполнено  = Ложь;
		РежимыВывода = ОпределитьРежимыВывода(РежимСообщений);

		// Проверки перед проведением (записью).
		Если ПроверятьЗаполнение Тогда
			Если НЕ ПроверитьЗаполнение(ТекущийОбъект, РежимыВывода.ВыводитьОшибки, РежимЗаписи) Тогда Возврат ДействиеВыполнено; КонецЕсли;
		КонецЕсли;

		// Тексты сообщений.
		Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			ТекстВыполнено = НСтр("ru='Записан документ ""%1"".';en='Document ""%1"" saved.'");
			ТекстЖР = НСтр("ru='МЯМ.ОшибкаЗаписиДокумента';en='MYM.OshibkaZapisiDokumenta'");

		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если ЗаписыватьПередПроведением Тогда
				ДействиеВыполнено = ЗаписатьПровестиДокумент(ТекущийОбъект, РежимЗаписиДокумента.Запись, Заголовок, РежимСообщений,, Ложь);
				Если НЕ ДействиеВыполнено Тогда Возврат ДействиеВыполнено; КонецЕсли;
			КонецЕсли;
			ТекстВыполнено = НСтр("ru='Проведен документ ""%1"".';en='Document ""%1."" entered'");
			ТекстЖР = НСтр("ru='МЯМ.ОшибкаПроведенияДокумента';en='MYM.OshibkaProvedeniyaDokumenta'");

		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			ТекстВыполнено = НСтр("ru='Отменено проведение документа ""%1"".';en='Document ""%1"" entry cancelled.'");
			ТекстЖР = НСтр("ru='МЯМ.ОшибкаОтменыПроведенияДокумента';en='MYM.OshibkaOtmeniProvedeniyaDokumenta'");

		КонецЕсли;

		// Попытка записи/ проведения/ отмены проведения.
		Попытка
			ТекущийОбъект.Записать(РежимЗаписи);
			ДействиеВыполнено = Истина;
			Если РежимыВывода.ВыводитьИнформацию Тогда
				ТекстВыполнено = СтрШаблон(ТекстВыполнено, ТекущийОбъект.Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстВыполнено);
			КонецЕсли;
		Исключение
			ДействиеВыполнено = Ложь;
			Если РежимыВывода.ВыводитьОшибки Тогда
				ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ТекстЖР, УровеньЖурналаРегистрации.Информация, , ,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Возврат ДействиеВыполнено;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Процедура выполняет изменение пометки на удаление у объекта.
//
// Параметры:
//  ТекущийОбъект - Ссылка, Объект.
//   При отличающейся пометке вызывает УстановитьПометкуУдаления: меняет запись в базе. Если СтруктураПараметров содержит ОбъектПолучен, использует сам переданный объект, иначе получает объект по ссылке.
//  ПометкаНаУдаление - Булево - Варианты значений: Истина - пометить на удаление, Ложь - снять пометку на удаление.
//  Заголовок - Строка.
//  РежимСообщений - Строка - Варианты значений: "Нет", "Все", "Ошибки".
//  СтруктураПараметров - Структура:
//   * ОбъектПолучен - Булево - При передачи объекта необходимо в параметр "СтруктураПараметров" добавить ключ "ОбъектПолучен".
//
// Возвращаемое значение:
//   Булево.
//
Функция ИзменитьПометкуНаУдалениеУОбъекта(ТекущийОбъект,ПометкаНаУдаление,Заголовок="",РежимСообщений="Все",СтруктураПараметров=Неопределено) Экспорт

		РежимыВывода = ОпределитьРежимыВывода(РежимСообщений);

		Попытка
			ПометкаНаУдалениеУОбъекта = ТекущийОбъект.ПометкаУдаления;
			Если ПометкаНаУдалениеУОбъекта <> ПометкаНаУдаление Тогда
				УказанаСтруктураПараметров = ?(ТипЗнч(СтруктураПараметров) = Тип("Структура"), Истина, Ложь);
				Если УказанаСтруктураПараметров И СтруктураПараметров.Свойство("ОбъектПолучен") Тогда
					ПолученныйОбъект = ТекущийОбъект;
				Иначе
					ПолученныйОбъект = ТекущийОбъект.ПолучитьОбъект();
				КонецЕсли;

				ПолученныйОбъект.УстановитьПометкуУдаления(ПометкаНаУдаление);
				Если РежимыВывода.ВыводитьИнформацию Тогда
					Если ПометкаНаУдаление Тогда
						ТекстСообщения = НСтр("ru='Пометка на удаление установлена. %1';en='Deletion Mark installed. %1'");
					Иначе
						ТекстСообщения = НСтр("ru='Пометка на удаление снята. %1';en='Deletion Mark is removed. %1'");
					КонецЕсли;
					ТекстСообщения = СтрШаблон(ТекстСообщения, ПолученныйОбъект);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПолученныйОбъект);
				КонецЕсли;
			КонецЕсли;

		Исключение
			ЗаписьЖурналаРегистрации("МЯМ.ОшибкаИзмененияПометкиУдаления", мямЖурналРегистрацииКлиентСервер.УровеньЖурналаРегистрацииОшибка(),,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Если РежимыВывода.ВыводитьОшибки Тогда ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ПолученныйОбъект); КонецЕсли;

		КонецПопытки;

		ДействиеВыполнено = ТекущийОбъект.ПометкаУдаления = ПометкаНаУдаление;
		Возврат ДействиеВыполнено;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Возвращает имя табличной части из канонического пути реквизита.
//
// Параметры:
//  ПутьРеквизита - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТабличнойЧастиЦели(ПутьРеквизита) Экспорт

		МассивЭлементов = СтрРазделить(ПутьРеквизита, ".", Ложь);
		ИндексТабличнойЧасти = МассивЭлементов.Найти("ТабличнаяЧасть");
		Если ИндексТабличнойЧасти = Неопределено
			Или ИндексТабличнойЧасти + 1 >= МассивЭлементов.Количество() Тогда
			Возврат "";
		КонецЕсли;

		Возврат МассивЭлементов[ИндексТабличнойЧасти + 1];

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Определяет служебный стандартный реквизит, который нельзя предлагать для заполнения значениями по умолчанию.
//
// Параметры:
//  ПутьРеквизита - Строка - путь с сегментом СтандартныйРеквизит и именем реквизита.
//
// Возвращаемое значение:
//  Булево - признак исключения; для неизвестного пути Ложь.
Функция ИсключаемыйРеквизитЗначенияПоУмолчанию(ПутьРеквизита) Экспорт

		МассивЭлементов = СтрРазделить(ПутьРеквизита, ".", Ложь);
		ИндексСтандартногоРеквизита = МассивЭлементов.Найти("СтандартныйРеквизит");
		Если ИндексСтандартногоРеквизита = Неопределено
			Или ИндексСтандартногоРеквизита + 1 >= МассивЭлементов.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;

		ИмяСтандартногоРеквизита = "СтандартныйРеквизит." + МассивЭлементов[ИндексСтандартногоРеквизита + 1];
		ИсключаемыеРеквизиты = СтрРазделить(
			"СтандартныйРеквизит.Ссылка,СтандартныйРеквизит.ЭтоГруппа,СтандартныйРеквизит.ПометкаУдаления,СтандартныйРеквизит.Предопределенный,СтандартныйРеквизит.ИмяПредопределенныхДанных,СтандартныйРеквизит.НомерСтроки,СтандартныйРеквизит.Проведен,СтандартныйРеквизит.ТипЗначения",
			",", Ложь);
		Возврат ИсключаемыеРеквизиты.Найти(ИмяСтандартногоРеквизита) <> Неопределено;

	КонецФункции

#КонецЕсли

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

// Функция - Массив в Таблицу значений.
//  Массив из (Структура / Строка таблицы значений) -> Таблица значений.
//
// Параметры:
//  Массив  - Массив Из Структура, Массив Из СтрокаТаблицыЗначений.
//
// Возвращаемое значение:
//   - ТаблицаЗначений.
//
Функция МассивВТаблицуЗначений(Знач Массив) Экспорт

		Данные = Новый ТаблицаЗначений;
		СтруктураДанных = Новый Структура;

		Для Каждого ЭлементМассива Из Массив Цикл
			Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
				Если Данные.Колонки.Количество() = 0 Тогда
					Для Каждого КлючЗначение Из ЭлементМассива Цикл
						Данные.Колонки.Добавить(КлючЗначение.Ключ, Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(КлючЗначение.Значение))));
					КонецЦикла;
				КонецЕсли;

				ЗаполнитьЗначенияСвойств(Данные.Добавить(), ЭлементМассива);
			ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("СтрокаТаблицыЗначений") Тогда
				Если Данные.Колонки.Количество() = 0 Тогда
					Для Каждого Колонка Из ЭлементМассива.Владелец().Колонки Цикл
						Данные.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок);
					КонецЦикла;
				КонецЕсли;

				ЗаполнитьЗначенияСвойств(Данные.Добавить(), ЭлементМассива);
			Иначе
				ТекстСообщения = СтрШаблон(НСтр("ru='Непреобразуемый тип данных: %1';"), Строка(ТипЗнч(ЭлементМассива)));
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЦикла;

		Возврат Данные;

	КонецФункции

