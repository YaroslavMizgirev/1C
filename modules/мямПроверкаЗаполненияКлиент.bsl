#Область ПрограммныйИнтерфейс

// При ошибках устанавливает Отказ = Истина и СтандартнаяОбработка = Ложь.
// Функция - Выполнены необходимые условия заполненения полей объекта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения.
//  УсловияЗаполнения - Строка - строка с условиями заполнения: ИмяРеквизита1>ИмяРеквизита2, ИмяРеквизита3<ИмяРеквизита2,
//                               ИмяРеквизита2>=ИмяРеквизита4, ИмяРеквизита1<=ИмяРеквизита3, ИмяРеквизита4=ИмяРеквизита3,
//                               ИмяРеквизита5<>ИмяРеквизита6 разделенные символом ",". Сравниваемые поля должны быть одного типа.
//   Переданная переменная сначала заменяется строкой без пробелов, затем массивом условий через СтрРазделить; это выполняется до проверки и сохраняется при успехе и при последующей ошибке.
//  СтандартнаяОбработка - Булево.
//   При найденных ошибках переданной переменной присваивается Ложь; при успехе сохраняет входное значение.
//  Отказ - Булево.
//   При найденных ошибках переданной переменной присваивается Истина; при успехе сохраняет входное значение.
//  СообщатьОбОшибках - Булево.
//
// Возвращаемое значение:
//   - Булево - Истина - все необходимые поля заполнены, Ложь - не все необходимые поля заполнены.
//
Функция ВыполненыНеобходимыеУсловияЗаполненияПолейОбъекта(Форма,УсловияЗаполнения,СтандартнаяОбработка=Истина,Отказ=Ложь,СообщатьОбОшибках=Истина) Экспорт

	МассивОшибок = Новый Массив;
	УсловияЗаполнения = мямСтрокаКлиентСервер.ЗаменитьПробелы(УсловияЗаполнения, "");
	УсловияЗаполнения = СтрРазделить(УсловияЗаполнения, ",", Ложь);
	Для Каждого Условие Из УсловияЗаполнения Цикл
		ПроверяемыеРеквизиты = СтрРазделить(Условие, ">=<", Ложь);
		Если ПроверяемыеРеквизиты.Количество() > 2 Тогда ВызватьИсключение СтрШаблон(НСтр("ru='Строка сравнения: ""%1"" содержит более двух элементов.';en='';"), Условие); КонецЕсли;
		Для Каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
			Условие = СтрЗаменить(Условие, ПроверяемыйРеквизит, "");
		КонецЦикла;

		Если Условие=">" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] > Форма.Объект[ПроверяемыеРеквизиты[1]];
		ИначеЕсли Условие="<" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] < Форма.Объект[ПроверяемыеРеквизиты[1]];
		ИначеЕсли Условие=">=" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] >= Форма.Объект[ПроверяемыеРеквизиты[1]];
		ИначеЕсли Условие="<=" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] <= Форма.Объект[ПроверяемыеРеквизиты[1]];
		ИначеЕсли Условие="=" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] = Форма.Объект[ПроверяемыеРеквизиты[1]];
		ИначеЕсли Условие="<>" Тогда
			РезультатСравнения = Форма.Объект[ПроверяемыеРеквизиты[0]] <> Форма.Объект[ПроверяемыеРеквизиты[1]];
		Иначе
			ТекстСообщения = СтрШаблон(НСтр("ru='Условие не определено: %1';en='';"), Условие);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		Если РезультатСравнения <> Истина Тогда
			МассивОшибок.Добавить(СтрШаблон(НСтр("ru='%1(%2) %3 %4(%5)';en='';"), ПроверяемыеРеквизиты[0], Форма.Объект[ПроверяемыеРеквизиты[0]], Условие, ПроверяемыеРеквизиты[1], Форма.Объект[ПроверяемыеРеквизиты[1]]));
		КонецЕсли;
	КонецЦикла;

	Если МассивОшибок.Количество() > 0 Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='%1: %2'"), ?(МассивОшибок.Количество() > 1, НСтр("ru='Условия не выполнены';"), НСтр("ru='Условие не выполнено';")), СтрСоединить(МассивОшибок, ", "));
			ПоказатьПредупреждение(, ТекстСообщения, 60, НСтр("ru='ПРЕДУПРЕЖДЕНИЕ';"));
		КонецЕсли;
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
	КонецЕсли;

	Возврат МассивОшибок.Количество() = 0;

КонецФункции

// При ошибках устанавливает Отказ = Истина и СтандартнаяОбработка = Ложь.
// Функция - Заполнены необходимые колонки табличной части.
//  Проверяет заполнение необходимых колонок табличной части объекта формы клиентского приложения.
//  Уведомляет пользователя о перечне незаполненных полей.
//
// Параметры:
//  Форма          - ФормаКлиентскогоПриложения.
//  ИмяТабличнойЧасти    - Строка.
//  ПроверяемыеКолонки   - Строка.
//   Переданная строковая переменная заменяется массивом через СтрРазделить до проверки; это изменение сохраняется и при успешной проверке, и при последующей ошибке.
//  СтандартнаяОбработка  - Булево.
//   При найденных ошибках переданной переменной присваивается Ложь; при успехе сохраняет входное значение.
//  Отказ          - Булево.
//   При найденных ошибках переданной переменной присваивается Истина; при успехе сохраняет входное значение.
//  СообщатьОбОшибках    - Булево.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ЗаполненыНеобходимыеКолонкиТабличнойЧасти(Форма,ИмяТабличнойЧасти,ПроверяемыеКолонки,СтандартнаяОбработка=Истина,Отказ=Ложь,СообщатьОбОшибках=Истина) Экспорт

	ПроверяемыеКолонки = СтрРазделить(ПроверяемыеКолонки, ",", Ложь);
	МассивОшибок = Новый Массив;
	Если Форма.Объект[ИмяТабличнойЧасти].Количество()=0 Тогда
		Для Каждого ПроверяемаяКолонка Из ПроверяемыеКолонки Цикл
			МассивОшибок.Добавить(мямСтрокаКлиентСервер.ИмяВСиноним(ПроверяемаяКолонка));
		КонецЦикла;

	Иначе
		Для Каждого Строка Из Форма.Объект[ИмяТабличнойЧасти] Цикл
			Для Каждого ПроверяемаяКолонка Из ПроверяемыеКолонки Цикл
				Если Не ЗначениеЗаполнено(Строка[ПроверяемаяКолонка]) Тогда
					МассивОшибок.Добавить(мямСтрокаКлиентСервер.ИмяВСиноним(ПроверяемаяКолонка));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

	КонецЕсли;
	Если МассивОшибок.Количество() > 0 Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Для продолжения заполните %1 таблицы %2: %3'"), ?(МассивОшибок.Количество() > 1, "колонки", "колонку"), ?(ПустаяСтрока(Форма.Элементы[ИмяТабличнойЧасти].Заголовок), мямСтрокаКлиентСервер.ИмяВСиноним(Форма.Элементы[ИмяТабличнойЧасти].Имя), Форма.Элементы[ИмяТабличнойЧасти].Заголовок), СтрСоединить(МассивОшибок, ", "));
			ПоказатьПредупреждение(, ТекстСообщения, 60, НСтр("ru='ПРЕДУПРЕЖДЕНИЕ';"));
		КонецЕсли;
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
	КонецЕсли;
	Возврат МассивОшибок.Количество() = 0;

КонецФункции

// При ошибках устанавливает Отказ = Истина и СтандартнаяОбработка = Ложь.
// Функция - Заполнены необходимые поля записи регистра.
//  Проверяет заполнение необходимых полей записи регистра формы клиентского приложения.
//  Уведомляет пользователя о перечне незаполненных полей.
//
