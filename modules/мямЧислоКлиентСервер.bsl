#Область ПрограммныйИнтерфейс

// Сохраняет числовой аргумент либо строго разбирает строку. Не заменяет пустоту и ошибку нулём.
//
// Параметры:
//  Значение - Число, Строка - исходное значение; прочие типы вызывают исключение.
//  ФорматИсточника - Строка - см. РазобратьЧисло; используется для строк.
//
// Возвращаемое значение:
//  Число - исходное или разобранное число.
Функция ЗначениеВЧисло(Знач Значение, ФорматИсточника = "") Экспорт
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат Значение;
    КонецЕсли;
    Возврат РазобратьЧисло(Значение, ФорматИсточника);
КонецФункции

// Процедура - Очистить значение числа.
//
// Параметры:
//  ЧислоЗначение - Число.
//   Переданной переменной безусловно присваивается ноль.
//
Процедура ОчиститьЗначениеЧисла(ЧислоЗначение) Экспорт

	ЧислоЗначение = 0;

КонецПроцедуры

// Разбирает десятичное число без зависимости от региональных настроек. Неверный ввод, пустота и потеря
//   точности вызывают исключение; ноль остаётся нулём. Экспонента здесь не поддерживается.
//
// Параметры:
//  Сырое - Строка - число с ведущим знаком или бухгалтерскими скобками.
//  ФорматИсточника - Строка - пусто: точка/запятая десятичные; Точка или Запятая: явный десятичный
//   разделитель, противоположный служит группировке по три цифры.
//
// Возвращаемое значение:
//  Число - точное значение в пределах 38 разрядов и 38 дробных позиций.
Функция РазобратьЧисло(Сырое, ФорматИсточника = "") Экспорт
    Если ТипЗнч(Сырое) <> Тип("Строка") Тогда
        ВызватьИсключение "Ожидается строка с числом.";
    КонецЕсли;
    Если ФорматИсточника <> "" И ФорматИсточника <> "Точка" И ФорматИсточника <> "Запятая" Тогда
        ВызватьИсключение "Неизвестный формат числа.";
    КонецЕсли;
    Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Сырое, Символ(160), " "), Символ(8239), " "));
    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Число не заполнено.";
    КонецЕсли;
    Знак = 1;
    Если Лев(Текст, 1) = "(" Тогда
        Если Прав(Текст, 1) <> ")" Тогда
            ВызватьИсключение "Не закрыты скобки числа.";
        КонецЕсли;
        Знак = -1;
        Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
    ИначеЕсли Лев(Текст, 1) = "+" Или Лев(Текст, 1) = "-" Или Лев(Текст, 1) = "−" Тогда
        Если Лев(Текст, 1) = "-" Или Лев(Текст, 1) = "−" Тогда
            Знак = -1;
        КонецЕсли;
        Текст = Сред(Текст, 2);
    КонецЕсли;
    Если ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "После знака или скобок нужны цифры.";
    КонецЕсли;
    Разделитель = ".";
    Группировка = ",";
    Если ФорматИсточника = "Запятая" Тогда
        Разделитель = ",";
        Группировка = ".";
    ИначеЕсли ФорматИсточника = "" Тогда
        Если СтрНайти(Текст, ".") > 0 И СтрНайти(Текст, ",") > 0 Тогда
            ВызватьИсключение "Для смешанных разделителей укажите формат источника.";
        КонецЕсли;
        Если СтрНайти(Текст, ",") > 0 Тогда
            Разделитель = ",";
        КонецЕсли;
        Группировка = " ";
    КонецЕсли;
    Части = СтрРазделить(Текст, Разделитель, Истина);
    Если Части.Количество() > 2 Тогда
        ВызватьИсключение "Повтор десятичного разделителя.";
    КонецЕсли;
    Целая = Части[0];
    Дробная = "";
    Если Части.Количество() = 2 Тогда
        Дробная = Части[1];
        Если ПустаяСтрока(Дробная) Тогда
            ВызватьИсключение "Не заполнена дробная часть.";
        КонецЕсли;
    КонецЕсли;
    Если СтрНайти(Целая, " ") > 0 Тогда
        Если Группировка <> " " И СтрНайти(Целая, Группировка) > 0 Тогда
            ВызватьИсключение "Смешаны разделители групп разрядов.";
        КонецЕсли;
        Группировка = " ";
    КонецЕсли;
    Группы = СтрРазделить(Целая, Группировка, Истина);
    Если Группы.Количество() > 1 Тогда
        Если СтрДлина(Группы[0]) < 1 Или СтрДлина(Группы[0]) > 3 Тогда
            ВызватьИсключение "Неверная первая группа разрядов.";
        КонецЕсли;
        Для Индекс = 1 По Группы.Количество() - 1 Цикл
            Если СтрДлина(Группы[Индекс]) <> 3 Тогда
                ВызватьИсключение "В группе разрядов должно быть три цифры.";
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Целая = СтрСоединить(Группы, "");
    Если ПустаяСтрока(Целая) И Не ПустаяСтрока(Дробная) Тогда
        Целая = "0";
    КонецЕсли;
    Если Не мямСтрокаКлиентСервер.ЭтоЦифры(Целая) Тогда
        ВызватьИсключение "Неверная целая часть числа.";
    КонецЕсли;
    Если Не ПустаяСтрока(Дробная) И Не мямСтрокаКлиентСервер.ЭтоЦифры(Дробная) Тогда
        ВызватьИсключение "Неверная дробная часть числа.";
    КонецЕсли;
    Пока СтрДлина(Целая) > 1 И Лев(Целая, 1) = "0" Цикл
        Целая = Сред(Целая, 2);
    КонецЦикла;
    Цифры = Целая + Дробная;
    Пока СтрДлина(Цифры) > 1 И Лев(Цифры, 1) = "0" Цикл
        Цифры = Сред(Цифры, 2);
    КонецЦикла;
    Если СтрДлина(Цифры) > 38 Или СтрДлина(Дробная) > 38 Тогда
        ВызватьИсключение "Число превышает точность 38 разрядов.";
    КонецЕсли;
    Результат = 0;
    Для Индекс = 1 По СтрДлина(Цифры) Цикл
        Результат = Результат * 10 + (СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) - 1);
    КонецЦикла;
    Мантисса = Результат;
    Для Индекс = 1 По СтрДлина(Дробная) Цикл
        Результат = Результат / 10;
    КонецЦикла;
    Контроль = Результат;
    Для Индекс = 1 По СтрДлина(Дробная) Цикл
        Контроль = Контроль * 10;
    КонецЦикла;
    Если Контроль <> Мантисса Тогда
        ВызватьИсключение "Число невозможно представить без потери точности.";
    КонецЕсли;
    Возврат Знак * Результат;
КонецФункции

// Функция - Это число.
//
// Параметры:
//  ПроверяемоеЗначение  - Произвольный.
//
// Возвращаемое значение:
//   - Булево.
//
Функция ЭтоЧисло(ПроверяемоеЗначение) Экспорт

	Возврат ТипЗнч(ПроверяемоеЗначение) = Тип("Число");

КонецФункции

#КонецОбласти
